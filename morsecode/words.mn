class MorseWords
{
	public static fun Unpack(ArrayList<Int> words, Int len) : ArrayList<Int>
	{
		ArrayList<Int> t = new ArrayList<Int>();
		foreach (Int w in words)
		{
			Int k = 0;
			while (k < 9)
			{
				if (t.Length() < len)
				{
					t.Add(w % 128);
				}
				w = w / 128;
				k = k + 1;
			}
		}
		return t;
	}
