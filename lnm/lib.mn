{
	public constructor()
	{
	}
	public fun IsEmpty() : Bool
	{
		return true;
	}
	public fun First() : IText
	{
		ERROR("car: empty list");
	}
	public fun Rest() : ITextList
	{
		ERROR("cdr: empty list");
