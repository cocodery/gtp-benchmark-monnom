# main.rkt (unit tests for time/date operations) and difference.rkt (merged to keep the
# configuration count down; see NOTES.md)

# ---- difference.rkt ----

class Difference
{
	public static fun DatetimeMonthsBetween(IDateTime dt1, IDateTime dt2) : Int
	{
		if (GDateTime.DatetimeLt(dt2, dt1))
		{
			return 0 - Difference.DatetimeMonthsBetween(dt2, dt1);
		}
		IDate d1 = GDateTime.DatetimeToDate(dt1);
		IDate d2 = GDateTime.DatetimeToDate(dt2);
		IYMD ymd1 = GDate.DateToYmd(d1);
		IYMD ymd2 = GDate.DateToYmd(d2);
		Int y1 = ymd1.Y();
		Int m1 = ymd1.M();
		Int y2 = ymd2.Y();
		Int m2 = ymd2.M();
		Int diff = (y2 - y1) * 12 + m2 - m1;
		Int startDom = Difference.StartDom(ymd1.D(), y2, m2, ymd2.D());
		IDateTime dt1a = GDateTime.DateTimeToDatetime(GDate.Date(y1, m1, startDom), GDateTime.DatetimeToTime(dt1));
		IRat ts1 = Q.Sub(GDateTime.DatetimeToJd(dt1a), GDateTime.DatetimeToJd(GDateTime.Datetime(y1, m1, 1, 0, 0, 0, 0)));
		IRat ts2 = Q.Sub(GDateTime.DatetimeToJd(dt2), GDateTime.DatetimeToJd(GDateTime.Datetime(y2, m2, 1, 0, 0, 0, 0)));
		if (Q.Lt(ts2, ts1))
		{
			return diff - 1;
		}
		return diff;
	}

	public static fun StartDom(Int d1, Int y2, Int m2, Int d2) : Int
	{
		if (d1 > d2)
		{
			if (Ymd.DaysInMonth(y2, m2) == d2)
			{
				return MomentBase.Abs(d2);
			}
		}
		return MomentBase.Abs(d1);
	}

	public static fun DatetimeDaysBetween(IDateTime dt1, IDateTime dt2) : Int
	{
		return Q.Floor(Q.Sub(GDateTime.DatetimeToJd(dt2), GDateTime.DatetimeToJd(dt1)));
	}

	public static fun DatetimeNanosecondsBetween(IDateTime dt1, IDateTime dt2) : IBig
	{
		return Q.BigSub(Difference.DatetimeToJdns(dt2), Difference.DatetimeToJdns(dt1));
	}

	public static fun DatetimeToJdns(IDateTime dt) : IBig
	{
		return Q.FloorTimesNsDay(GDateTime.DatetimeToJd(dt), Hmsn.NsDay());
	}
}

# ---- main.rkt ----

class Main
{
	public static fun Dt(Int y, Int m, Int d, Int h, Int mi, Int s, Int n, IDateTimeList rest) : IDateTimeList
	{
		return new DateTimeCons(GDateTime.Datetime(y, m, d, h, mi, s, n), rest);
	}

	public static fun HistoricDates() : IDateTimeList
	{
		IDateTimeList l = new DateTimeNil();
		l = Main.Dt(1099, 7, 10, 0, 0, 0, 0, l);
		l = Main.Dt(1898, 4, 1, 0, 0, 0, 0, l);
		l = Main.Dt(1030, 1, 1, 0, 0, 0, 0, l);
		l = Main.Dt(12, 1, 1, 0, 0, 0, 0, l);
		l = Main.Dt(1922, 2, 2, 0, 0, 0, 0, l);
		l = Main.Dt(1991, 4, 29, 0, 0, 0, 0, l);
		l = Main.Dt(1998, 9, 28, 0, 0, 0, 0, l);
		l = Main.Dt(2013, 6, 18, 0, 0, 0, 0, l);
		l = Main.Dt(1980, 12, 8, 0, 0, 0, 0, l);
		l = Main.Dt(1977, 8, 16, 0, 0, 0, 0, l);
		l = Main.Dt(1969, 7, 20, 20, 18, 0, 0, l);
		l = Main.Dt(1989, 11, 9, 0, 0, 0, 0, l);
		l = Main.Dt(1835, 1, 30, 0, 0, 0, 0, l);
		l = Main.Dt(1950, 11, 1, 0, 0, 0, 0, l);
		l = Main.Dt(1928, 11, 19, 0, 0, 0, 0, l);
		l = Main.Dt(1912, 10, 14, 0, 0, 0, 0, l);
		l = Main.Dt(1933, 2, 15, 0, 0, 0, 0, l);
		l = Main.Dt(1901, 9, 6, 0, 0, 0, 0, l);
		l = Main.Dt(1881, 7, 2, 0, 0, 0, 0, l);
		l = Main.Dt(1865, 4, 14, 10, 0, 0, 0, l);
		l = Main.Dt(1963, 11, 22, 12, 30, 0, 0, l);
		l = Main.Dt(1984, 1, 1, 0, 0, 0, 0, l);
		l = Main.Dt(1944, 6, 6, 6, 6, 6, 6, l);
		l = Main.Dt(2001, 9, 11, 9, 3, 0, 0, l);
		l = Main.Dt(2001, 9, 11, 8, 46, 0, 0, l);
