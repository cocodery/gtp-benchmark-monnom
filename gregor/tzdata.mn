# Time-zone data for the zones that the benchmark uses, as parsed by base/tzinfo from the
# system zoneinfo files (/usr/share/zoneinfo, tzfile version 2+, 64-bit section) by Racket.
# Library file: not part of the configuration lattice.
# Intervals: from, to, offset index; -inf.0 / +inf.0 bounds are encoded by the flags of
# FromIsInf / ToIsInf (the bound itself is then 0).
# Offsets: utc-seconds, dst? (0/1), abbreviation (up to 9 ASCII characters packed base 128).
class TzData
{
	public static fun ZoneCount() : Int
	{
		return 3;
	}
	public static fun ZoneName(Int z) : ArrayList<Int>
	{
		if (z == 0)
		{
			return TzData.Name0();
		}
		if (z == 1)
		{
			return TzData.Name1();
		}
		if (z == 2)
		{
			return TzData.Name2();
		}
		ERROR("no such zone");
	}
	public static fun Intervals(Int z) : ArrayList<Int>
	{
		if (z == 0)
		{
			return TzData.Intervals0();
		}
		if (z == 1)
		{
			return TzData.Intervals1();
		}
		if (z == 2)
		{
			return TzData.Intervals2();
		}
		ERROR("no such zone");
	}
	public static fun Offsets(Int z) : ArrayList<Int>
	{
		if (z == 0)
		{
			return TzData.Offsets0();
		}
		if (z == 1)
		{
			return TzData.Offsets1();
		}
		if (z == 2)
		{
			return TzData.Offsets2();
		}
		ERROR("no such zone");
	}
