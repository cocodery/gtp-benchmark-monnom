# ---- tree.rkt ----
# atree% and its subclasses state% and lplaced% are classes implementing ITree; the methods
# that state% and lplaced% inherit from atree% are in the static class ATree.

class HandOutS implements IHandOut
{
	private readonly ITile tile;
	private readonly ITree tree;
	public constructor(ITile t, ITree tr)
	{
		tile = t;
		tree = tr;
	}
	public fun Tile() : ITile
	{
		return tile;
	}
	public fun Tree() : ITree
	{
		return tree;
	}
}

class TileAndTreeS implements ITileAndTree
{
	private readonly Bool hasTile;
	private readonly ITile tile;
	private readonly ITree tree;
	public constructor(Bool h, ITile t, ITree tr)
	{
		hasTile = h;
		tile = t;
		tree = tr;
	}
	public fun HasTile() : Bool
	{
		return hasTile;
	}
	public fun Tile() : ITile
	{
		return tile;
	}
	public fun Tree() : ITree
	{
		return tree;
	}
}

class TraversalArgsS implements ITraversalArgs
{
	private readonly Int n;
	private readonly IIntListList policies;
	private readonly Int tag;
	public constructor(Int nn, IIntListList p, Int t)
	{
		n = nn;
		policies = p;
		tag = t;
	}
	public fun N() : Int
	{
		return n;
	}
	public fun Policies() : IIntListList
	{
		return policies;
	}
	public fun Tag() : Int
	{
		return tag;
	}
}

class PurchaseResultS implements IPurchaseResult
{
	private readonly Bool isList;
	private readonly ITree tree;
	private readonly IHandOutList handOuts;
	public constructor(Bool l, ITree t, IHandOutList h)
	{
		isList = l;
		tree = t;
		handOuts = h;
	}
	public fun IsList() : Bool
	{
		return isList;
	}
	public fun Tree() : ITree
	{
		return tree;
	}
	public fun HandOuts() : IHandOutList
	{
		return handOuts;
	}
}

# state%
class StateTree implements ITree
{
	private readonly IState state;
	public constructor(IState s)
	{
		state = s;
	}
	public fun IsLPlaced() : Bool
	{
		return false;
	}
	public fun NothingToPlace() : Bool
	{
		return false;
	}
	public fun ToState() : IState
	{
		return state;
	}
	public fun Next(INextArgs a) : ITileAndTree
	{
		ERROR("tree-next: finale state can't transition");
	}
	public fun Founding(Int n, IIntListList orderPolicies) : Int
	{
		return ATree.Founding(this, n, orderPolicies);
	}
	public fun Merging(Int n, IIntListList orderPolicies) : Int
	{
		return ATree.Merging(this, n, orderPolicies);
	}
	public fun Traversal(ITraversalArgs a) : Int
	{
		return 0;
	}
	public fun LookupTile(ITilePicker pickTile, IHandOutList loHandout) : ITileAndTree
	{
		return new TileAndTreeS(false, Board.Tile(0, 0), this);
	}
}

# lplaced%
class LPlacedTree implements ITree
{
	private readonly IState state;
	private readonly IPlacedList lplaced;
	public constructor(IState s, IPlacedList l)
	{
		state = s;
		lplaced = l;
	}
	public fun IsLPlaced() : Bool
	{
		return true;
	}
	public fun NothingToPlace() : Bool
	{
		return lplaced.IsEmpty();
	}
	public fun ToState() : IState
	{
		return state;
	}
	public fun Next(INextArgs a) : ITileAndTree
	{
		IPlaced p = this.LookupPurchase(a.Tile(), a.Hotel());
		IPurchaseResult intermediate = p.Purchase(a.Decisions(), a.SharesToBuy());
		if (!intermediate.IsList())
		{
			ERROR("Expected a HandOut, got a State%");
		}
		return this.LookupTile(a.PickTile(), intermediate.HandOuts());
	}
	public fun LookupPurchase(ITile t, Int h) : IPlaced
	{
		IPlacedList l = lplaced;
		while (!l.IsEmpty())
		{
			IPlaced p = l.First();
			if (p.Hotel() == h)
			{
				if (Board.TileEqual(p.Tile(), t))
				{
					return p;
				}
			}
			l = l.Rest();
		}
		ERROR("noplace");
	}
	public fun Founding(Int n, IIntListList orderPolicies) : Int
	{
		return ATree.Founding(this, n, orderPolicies);
	}
	public fun Merging(Int n, IIntListList orderPolicies) : Int
	{
		return ATree.Merging(this, n, orderPolicies);
	}
	public fun LookupTile(ITilePicker pickTile, IHandOutList loHandOut) : ITileAndTree
	{
		ITile tile = pickTile(Tree.HandOutTiles(loHandOut));
		IHandOutList l = loHandOut;
		while (!l.IsEmpty())
		{
			if (Board.TileEqual(l.First().Tile(), tile))
			{
				return new TileAndTreeS(true, tile, l.First().Tree());
			}
			l = l.Rest();
		}
		ERROR("lookupfailed");
	}
	public fun Traversal(ITraversalArgs a) : Int
	{
		if (a.N() == 0)
		{
			return 0;
		}
		Int sum = 0;
		IPlacedList l = lplaced;
		while (!l.IsEmpty())
		{
			sum = sum + Tree.TraverseBranch(l.First(), a);
			l = l.Rest();
		}
		return sum;
	}
}

# placed%
class PlacedS implements IPlaced
{
	private readonly IState state;
	private readonly ITile tile;
	private readonly Int hotel;
	private readonly IState stateTile;
	private readonly Int reason;
	public constructor(IState s, ITile t, Int h, IState st, Int r)
	{
		state = s;
		tile = t;
		hotel = h;
		stateTile = st;
		reason = r;
	}
	public fun State() : IState
	{
		return state;
	}
	public fun Tile() : ITile
	{
		return tile;
	}
	public fun Hotel() : Int
	{
		return hotel;
	}
	public fun StateTile() : IState
	{
		return stateTile;
	}
	public fun Reason() : Int
	{
		return reason;
	}
	public fun Purchase(IDecisionList decisions, IIntList shareOrder) : IPurchaseResult
	{
		if (reason == Board.Merging())
		{
			if (State.DecisionsLength(decisions) != State.PlayersLength(stateTile.Players()))
			{
				ERROR("purchase: contract failure: received wrong number of decisions");
			}
		}
		IState stateDecisions = Tree.StateDecisions(this, decisions);
		IState stateBought = State.StateBuyShares(stateDecisions, shareOrder);
		ITileList availableTiles = stateBought.Tiles();
		if (availableTiles.IsEmpty())
		{
			return new PurchaseResultS(false, new StateTree(stateBought), new HandOutNil());
		}
		return new PurchaseResultS(true, new StateTree(stateBought), Tree.HandOuts(stateBought, availableTiles));
	}
	public fun ToTrees(IDecisionList decisions, IIntList shareOrder) : ITreeList
	{
		IPurchaseResult r = this.Purchase(decisions, shareOrder);
		if (r.IsList())
		{
			return Tree.HandOutTrees(r.HandOuts());
		}
		return new TreeCons(r.Tree(), new TreeNil());
	}
	public fun AcceptablePolicies(IIntListList policies) : IIntListList
	{
		IIntListList ps = policies;
		while (!ps.IsEmpty())
		{
			if (!Basics.SharesOrder(ps.First()))
			{
				ERROR("acceptable-policies: Precondigion");
			}
			ps = ps.Rest();
		}
		return Tree.Acceptable(stateTile, policies);
	}
}

class ATree
{
	public static fun Founding(ITree t, Int n, IIntListList orderPolicies) : Int
	{
		IIntListList ps = orderPolicies;
		while (!ps.IsEmpty())
		{
			if (!Basics.SharesOrder(ps.First()))
			{
				ERROR("atree-founding: Precondition");
			}
			ps = ps.Rest();
		}
		return t.Traversal(new TraversalArgsS(n, orderPolicies, Board.Founding()));
	}

	public static fun Merging(ITree t, Int n, IIntListList orderPolicies) : Int
	{
		return t.Traversal(new TraversalArgsS(n, orderPolicies, Board.Merging()));
	}

	# ((is-action tag) p)
	public static fun IsAction(Int tag, IPlaced p) : Int
	{
		if (p.Hotel() >= 0)
		{
			if (p.Reason() == tag)
			{
				return 1;
			}
		}
		return 0;
	}
}

class Tree
{
	public static fun HandOutTiles(IHandOutList l) : ITileList
	{
		if (l.IsEmpty())
		{
			return new TileNil();
		}
		return new TileCons(l.First().Tile(), Tree.HandOutTiles(l.Rest()));
	}

	public static fun HandOutTrees(IHandOutList l) : ITreeList
	{
		if (l.IsEmpty())
		{
			return new TreeNil();
		}
		return new TreeCons(l.First().Tree(), Tree.HandOutTrees(l.Rest()));
	}

	public static fun StateDecisions(IPlaced p, IDecisionList decisions) : IState
	{
		if (p.Reason() == Board.Merging())
		{
			return State.StateReturnShares(p.StateTile(), decisions, p.State().Board());
		}
		return p.StateTile();
	}

	public static fun HandOuts(IState stateBought, ITileList tiles) : IHandOutList
	{
		if (tiles.IsEmpty())
		{
			return new HandOutNil();
		}
		ITile tile = tiles.First();
		IHandOut h = new HandOutS(tile, Tree.GenerateTree(State.StateNextTurn(State.StateMoveTile(stateBought, tile))));
		return new HandOutCons(h, Tree.HandOuts(stateBought, tiles.Rest()));
	}

	public static fun Acceptable(IState state, IIntListList policies) : IIntListList
	{
		if (policies.IsEmpty())
		{
			return policies;
		}
		Int budget = State.StateCurrentPlayer(state).Money();
		IIntList p = policies.First();
		if (Basics.SharesAvailableP(state.Shares(), p))
		{
			if (Board.Affordable(state.Board(), p, budget))
			{
				return new IntListCons(p, Tree.Acceptable(state, policies.Rest()));
			}
		}
		return Tree.Acceptable(state, policies.Rest());
	}

	public static fun DecisionsFor(IPlayerList ps) : IDecisionList
	{
		if (ps.IsEmpty())
		{
			return new DecisionNil();
		}
		return new DecisionCons(new DecisionS(ps.First(), new HotelDecisionNil()), Tree.DecisionsFor(ps.Rest()));
	}

	public static fun IntListsLength(IIntListList l) : Int
	{
		Int n = 0;
		while (!l.IsEmpty())
		{
			n = n + 1;
			l = l.Rest();
		}
		return n;
	}

	# the body of lplaced%'s traversal for one branch
	public static fun TraverseBranch(IPlaced branch, ITraversalArgs a) : Int
	{
		IDecisionList ds = Tree.DecisionsFor(branch.StateTile().Players());
		IIntListList acc = branch.AcceptablePolicies(a.Policies());
		Int here = ATree.IsAction(a.Tag(), branch);
		if (acc.IsEmpty())
		{
			return here;
		}
		Int sub = 0;
		ITreeList ts = branch.ToTrees(ds, acc.First());
		while (!ts.IsEmpty())
		{
			sub = sub + ts.First().Traversal(new TraversalArgsS(a.N() - 1, a.Policies(), a.Tag()));
			ts = ts.Rest();
		}
		return here + Tree.IntListsLength(acc) * sub;
	}

	public static fun HotelsFor(IState state, IBoard board, ITile t, Int kind) : IIntList
	{
		if (kind == Board.Impossible())
		{
			return new IntNil();
		}
		if (kind == Board.Founding())
		{
			if (!state.Hotels().IsEmpty())
			{
				return state.Hotels();
			}
		}
		if (kind == Board.Merging())
		{
			return Board.MergingWhich(board, t).Acquirers();
		}
		return new IntCons(0 - 1, new IntNil());
	}

	public static fun Placements(IState state, ITile t, Int kind, IIntList hotels) : IPlacedList
	{
		if (hotels.IsEmpty())
		{
			return new PlacedNil();
		}
		Int h = hotels.First();
		IState stateTile = State.StatePlaceTile(state, t, h);
		IPlaced p = new PlacedS(state, t, h, stateTile, kind);
		return new PlacedCons(p, Tree.Placements(state, t, kind, hotels.Rest()));
	}

	public static fun PlacedAppend(IPlacedList a, IPlacedList b) : IPlacedList
	{
		if (a.IsEmpty())
		{
			return b;
		}
		return new PlacedCons(a.First(), Tree.PlacedAppend(a.Rest(), b));
	}

	public static fun GenerateTree(IState state) : ITree
	{
		if (State.StateFinal(state))
		{
			return new StateTree(state);
		}
		IBoard board = state.Board();
		IPlacedList loPlaced = new PlacedNil();
		ITileList ts = State.StateCurrentPlayer(state).Tiles();
		while (!ts.IsEmpty())
		{
			ITile t = ts.First();
			Int kind = Board.WhatKindOfSpot(board, t);
			IIntList hotels = Tree.HotelsFor(state, board, t, kind);
			loPlaced = Tree.PlacedAppend(Tree.Placements(state, t, kind, hotels), loPlaced);
			ts = ts.Rest();
		}
		return new LPlacedTree(state, loPlaced);
	}

	public static fun TreeNext(ITree currentTree, INextArgs a) : ITileAndTree
	{
		return currentTree.Next(a);
	}

	public static fun MakeDecision(IPlayer p, IHotelDecisionList c) : IDecision
	{
		return new DecisionS(p, c);
	}

	public static fun MakeHotelDecision(Int h, Bool k) : IHotelDecision
	{
		return new HotelDecisionS(h, k);
	}

	public static fun TreeState(ITree t) : IState
	{
		return t.ToState();
	}
}

# (list p (list (list h d) ...)): an element of Decisions
class DecisionS implements IDecision
{
	private readonly IPlayer player;
	private readonly IHotelDecisionList choices;
	public constructor(IPlayer p, IHotelDecisionList c)
	{
		player = p;
		choices = c;
	}
	public fun Player() : IPlayer
	{
		return player;
	}
	public fun Choices() : IHotelDecisionList
	{
		return choices;
	}
}

class HotelDecisionS implements IHotelDecision
{
	private readonly Int hotel;
	private readonly Bool keep;
	public constructor(Int h, Bool k)
	{
		hotel = h;
		keep = k;
	}
	public fun Hotel() : Int
	{
		return hotel;
	}
	public fun Keep() : Bool
	{
		return keep;
	}
}
