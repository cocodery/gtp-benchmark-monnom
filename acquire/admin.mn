	public constructor(Bool h, ITile t, Int ho, IIntList b)
	{
		hasTile = h;
		tile = t;
		hotel = ho;
		buy = b;
	}
	public fun HasTile() : Bool
	{
		return hasTile;
	}
	public fun Tile() : ITile
	{
		return tile;
	}
	public fun Hotel() : Int
	{
		return hotel;
	}
	public fun Buy() : IIntList
	{
		return buy;
	}
}

