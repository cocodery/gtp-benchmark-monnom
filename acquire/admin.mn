# turn%
class TurnS implements ITurn
{
	private IState currentState;
	private readonly IBoard board;
	private readonly IPlayer current;
	private readonly Int cash;
	private readonly ITileList tiles;
	private readonly IShares shares;
	private readonly IIntList hotels;
	private readonly IPlayerList players;
	private Bool hasTile;
	private ITile tile;
	private Int hotel;
	private IDecisionList decisions;
	private IPlayerList eliminated;
	private Bool called;
	public constructor(IState s, IBoard b, IPlayer c, Int ca, ITileList t, IShares sh, IIntList h, IPlayerList p)
	{
		currentState = s;
		board = b;
		current = c;
		cash = ca;
		tiles = t;
		shares = sh;
		hotels = h;
		players = p;
		hasTile = false;
		tile = Board.Tile(0, 0);
		hotel = 0 - 1;
		decisions = new DecisionNil();
		eliminated = new PlayerNil();
		called = false;
	}
	public fun Board() : IBoard
	{
		return board;
	}
	public fun Current() : IPlayer
	{
		return current;
	}
	public fun Cash() : Int
	{
		return cash;
	}
	public fun Tiles() : ITileList
	{
		return tiles;
	}
	public fun Shares() : IShares
	{
		return shares;
	}
	public fun Hotels() : IIntList
	{
		return hotels;
	}
	public fun Players() : IPlayerList
	{
		return players;
	}
	public fun ReconcileShares(IShares t) : IShares
	{
		return t;
	}
	public fun Eliminated() : IPlayerList
	{
		return eliminated;
	}
	public fun PlaceCalled() : Bool
	{
		return called;
	}
	public fun Decisions() : ITurnDecisions
	{
		return new TurnDecisionsS(hasTile, tile, hotel, decisions);
	}
	public fun Place(ITile t, Int h) : IPlayerList
	{
		if (called)
		{
			return currentState.Players();
		}
		called = true;
		hasTile = true;
		tile = t;
		hotel = h;
		IMergingWhich mw = Board.MergingWhich(board, t);
		IIntList acquiredHotels = Builtins.IntAppend(Builtins.IntRemove(h, mw.Acquirers()), mw.Acquired());
		IPlayerList ps = players;
		while (!ps.IsEmpty())
		{
			IPlayer p = ps.First();
			IBoolList pSDecisions = Admin.KeepOf(p, acquiredHotels);
			decisions = new DecisionCons(Tree.MakeDecision(p, Admin.Zip(acquiredHotels, pSDecisions)), decisions);
			ps = ps.Rest();
		}
		IState stateEliminated = State.StateEliminate(currentState, eliminated);
		IState stateReturns = State.StateReturnShares(stateEliminated, decisions, stateEliminated.Board());
		currentState = stateReturns;
		return stateReturns.Players();
	}
}

