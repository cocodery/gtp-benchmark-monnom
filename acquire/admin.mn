	}
}

# (strategy/d choose-founding choose-merger choose-shares#)
class StrategyD implements IStrategy
{
	private readonly IHotelPicker chooseFounding;
	private readonly IHotelPicker chooseMerger;
	private readonly INatFn chooseShares;
	public constructor(IHotelPicker f, IHotelPicker m, INatFn s)
	{
		chooseFounding = f;
		chooseMerger = m;
		chooseShares = s;
	}
	public fun this(ITurn turn) : ITurnResult
	{
		IBoard b = turn.Board();
		Int myCash = turn.Cash();
		IShares availableShares = turn.Shares();
		IIntList availableHotels = turn.Hotels();
		ITileList ts = Board.SortTiles(turn.Tiles());
		while (!ts.IsEmpty())
		{
			ITile t = ts.First();
			Int s = Board.WhatKindOfSpot(b, t);
			if (s != Board.Impossible())
			{
				return Strategy.PlaceAndBuy(turn, t, s, chooseFounding, chooseMerger);
			}
			ts = ts.Rest();
		}
		INatFn cs = chooseShares;
		IIntList buy = Strategy.ToBuy(b, myCash, availableShares, cs(Strategy.NatSharesPerTurnN()));
		return new TurnResultS(false, Board.Tile(0, 0), 0 - 1, buy);
	}
}

class Strategy
{
	public static fun NatSharesPerTurnN() : Int
	{
		Int n = Basics.SharesPerTurnN();
		if (n < 0)
		{
			ERROR("assert: exact-nonnegative-integer?");
		}
		return n;
	}

	public static fun SortHotels(IIntList l) : IIntList
	{
		if (l.IsEmpty())
		{
			return l;
		}
		return Strategy.InsertHotel(l.First(), Strategy.SortHotels(l.Rest()));
	}

	public static fun InsertHotel(Int h, IIntList sorted) : IIntList
	{
		if (sorted.IsEmpty())
		{
			return new IntCons(h, sorted);
		}
		if (Basics.HotelLe(h, sorted.First()))
		{
			return new IntCons(h, sorted);
		}
		return new IntCons(sorted.First(), Strategy.InsertHotel(h, sorted.Rest()));
	}

	public static fun PickHotel(IBoard b, ITile toPlace, Int kind, IIntList availableHotels, IHotelPicker selectFoundingHotel, IHotelPicker selectMerger) : Int
	{
		if (kind == Board.Founding())
		{
			if (availableHotels.IsEmpty())
			{
				return 0 - 1;
			}
			return selectFoundingHotel(availableHotels);
		}
		if (kind == Board.Merging())
		{
			IMergingWhich mw = Board.MergingWhich(b, toPlace);
			return selectMerger(mw.Acquirers());
		}
		return 0 - 1;
	}

	# the tile-kind branch of strategy/d
	public static fun PlaceAndBuy(ITurn turn, ITile toPlace, Int kind, IHotelPicker chooseFounding, IHotelPicker chooseMerger) : ITurnResult
	{
		IBoard b = turn.Board();
		Int myCash = turn.Cash();
		IShares availableShares = turn.Shares();
		Int hotel = Strategy.PickHotel(b, toPlace, kind, turn.Hotels(), chooseFounding, chooseMerger);
		IBoard board = Board.SetBoard(b, toPlace, kind, hotel);
		IShares shares = Strategy.SharesAfter(availableShares, kind, hotel);
		if (kind == Board.Merging())
		{
			if (hotel >= 0)
			{
				turn.Place(toPlace, hotel);
			}
		}
		IIntList buy = Strategy.ToBuy(board, myCash, shares, Strategy.NatSharesPerTurnN());
		return new TurnResultS(true, toPlace, hotel, buy);
	}

	public static fun SharesAfter(IShares availableShares, Int kind, Int hotel) : IShares
	{
		if (kind == Board.Founding())
		{
			if (hotel >= 0)
			{
				if (Basics.SharesAvailable(availableShares, hotel) > 0)
				{
					return Basics.SharesMinusMinus(availableShares, hotel);
				}
			}
		}
		return availableShares;
	}

	public static fun ToBuy(IBoard b, Int myCash, IShares availableShares, Int buyN) : IIntList
	{
		IIntList hotels = Basics.AllHotels();
		Int n = 0;
		while (true)
		{
			if (hotels.IsEmpty())
			{
				return new IntNil();
			}
			if (buyN == n)
			{
				return new IntNil();
			}
			Int h = hotels.First();
			Int availableH = Basics.SharesAvailable(availableShares, h);
			if (availableH == 0)
			{
				hotels = hotels.Rest();
				continue;
			}
			Int price = Basics.PricePerShare(h, Board.SizeOfHotel(b, h));
			if (price >= 0)
			{
				if (price <= myCash)
				{
					if (2 * price <= myCash)
					{
						if (availableH > 1)
						{
							return new IntCons(h, new IntCons(h, new IntNil()));
						}
					}
					return new IntCons(h, new IntNil());
				}
			}
			hotels = hotels.Rest();
		}
		return new IntNil();
	}

	public static fun OrderedS() : IStrategy
	{
		IHotelPicker f = new FirstHotel();
		IHotelPicker m = new AlphabeticallyFirst();
		INatFn s = new IdNat();
		return new StrategyD(f, m, s);
	}

	public static fun RandomS(IRng rng) : IStrategy
	{
		IHotelPicker f = new RandomlyPickHotel(rng);
		IHotelPicker m = new RandomlyPickHotel(rng);
		INatFn s = new RandomPlus1(rng);
		return new StrategyD(f, m, s);
	}
}

# ---- player.rkt ----

class PlayerExtS implements IPlayerExt
{
	private readonly Int id;
	private readonly IText name;
	private readonly IStrategy choice;
	private readonly IRng rng;
	private IPlayerList players;
	private IPlayerList bad;
	private IText myGameName;
	public constructor(Int i, IText n, IStrategy c, IRng r)
	{
		id = i;
		name = n;
		choice = c;
		rng = r;
		players = new PlayerNil();
		bad = new PlayerNil();
		myGameName = Txt.Empty();
	}
	public fun Id() : Int
	{
		return id;
	}
	public fun Go(IAdministrator administrator) : Int
	{
		myGameName = administrator.SignUp(name, this);
		return 0;
	}
	public fun Setup(IState s) : Int
	{
		return this.BadPlayers(s.Players());
	}
	public fun TakeTurn(ITurn turn) : ITurnResult
	{
		this.BadPlayers(turn.Players());
		IStrategy c = choice;
		return c(this.Reconcile(turn));
	}
	public fun Keep(IIntList hotels) : IBoolList
	{
		if (hotels.IsEmpty())
		{
			return new BoolNil();
		}
		Bool k = PlayerFactory.Coin(rng);
		return new BoolCons(k, this.Keep(hotels.Rest()));
	}
	public fun ReceiveTile(ITile t) : Int
	{
		return 0;
	}
	public fun Inform(IState s) : Int
	{
		return this.BadPlayers(s.Players());
	}
	public fun TheEnd(IState s, IScoreList results) : Int
	{
		return 0;
	}
	public fun BadPlayers(IPlayerList current) : Int
	{
		IPlayerList b = bad;
		IPlayerList l = players;
		while (!l.IsEmpty())
		{
			IPlayer oldPlayer = l.First();
			l = l.Rest();
			if (PlayerFactory.FindByName(oldPlayer.Name(), current))
			{
				continue;
			}
			b = new PlayerCons(oldPlayer, b);
		}
		bad = b;
		players = current;
		return 0;
	}
	public fun Reconcile(ITurn turn) : ITurn
	{
		IShares badShares = Basics.CombineShares(PlayerFactory.SharesOf(bad));
		turn.ReconcileShares(badShares);
		return turn;
	}
}

class PlayerFactory
{
	# (< (random 100) 50)
	public static fun Coin(IRng rng) : Bool
	{
		if (rng.NextInt(100) < 50)
		{
			return true;
		}
		return false;
	}

	public static fun FindByName(IText n, IPlayerList ps) : Bool
	{
		while (!ps.IsEmpty())
		{
			if (Txt.Equal(ps.First().Name(), n))
			{
				return true;
			}
			ps = ps.Rest();
		}
		return false;
	}

	public static fun SharesOf(IPlayerList ps) : ISharesList
	{
		if (ps.IsEmpty())
		{
			return new SharesNil();
		}
		return new SharesCons(ps.First().Shares(), PlayerFactory.SharesOf(ps.Rest()));
	}

	public static fun Create(Int id, IText n, IStrategy c, IRng rng) : IPlayerExt
	{
		return new PlayerExtS(id, n, c, rng);
	}

	# (for/list ((name '("a" "b" "c" "d" "e" "f")) (i (in-range n))) (create name S)); ids
	# start at firstId (identities for eq?)
	public static fun MakePlayers(IStrategy s, Int n, Int firstId, IRng rng) : IPlayerExtList
	{
		if (n < 6)
		{
			return PlayerFactory.PlayersUpTo(s, n, firstId, rng);
		}
		return PlayerFactory.PlayersUpTo(s, 6, firstId, rng);
	}

	public static fun PlayersUpTo(IStrategy s, Int k, Int firstId, IRng rng) : IPlayerExtList
	{
		IPlayerExtList l = new PlayerExtNil();
		Int i = k - 1;
		while (i >= 0)
		{
			l = new PlayerExtCons(PlayerFactory.Create(firstId + i, Txt.Empty().Push(97 + i), s, rng), l);
			i = i - 1;
		}
		return l;
	}

	public static fun RandomPlayers(Int n, Int firstId, IRng rng) : IPlayerExtList
	{
		return PlayerFactory.MakePlayers(Strategy.RandomS(rng), n, firstId, rng);
	}

	public static fun OrderedPlayers(Int n, Int firstId, IRng rng) : IPlayerExtList
	{
		return PlayerFactory.MakePlayers(Strategy.OrderedS(), n, firstId, rng);
	}
}

