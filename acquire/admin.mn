# administrator%
class Administrator implements IAdministrator
{
	private readonly ITilePicker nextTile;
	private readonly IRng rng;
	private Int count;
	private ITextList names;
	private IPlayerExtList externals;
	public constructor(ITilePicker n, IRng r)
	{
		nextTile = n;
		rng = r;
		count = 10;
		names = new TextNil();
		externals = new PlayerExtNil();
	}
	public fun SignUp(IText name0, IPlayerExt player) : IText
	{
		IText pre = Admin.Pre(rng);
		count = count + 1 + rng.NextInt(10);
		IText name = Txt.Append(Txt.Append(Txt.Append(pre, Txt.Digits(count)), Txt.Empty().Push(58)), name0);
		names = new TextCons(name, names);
		externals = new PlayerExtCons(player, externals);
		return name;
	}
	public fun ShowPlayers() : ITextList
	{
		return names;
	}
	public fun Run(Int turns) : IRunResult
	{
		IPlayerList players = Admin.PlayerToInternals(names, externals);
		if (players.IsEmpty())
		{
			ERROR("run: players failed to sign up properly");
		}
		ITree tree0 = Tree.GenerateTree(Admin.SetupAll(players, State.State0(players)));
		return Admin.Loop(tree0, turns, new StateCons(Tree.TreeState(tree0), new StateNil()), nextTile);
	}
}

class Admin
{
	public static fun Done() : Int
	{
		return 0;
	}
	public static fun Exhausted() : Int
	{
		return 1;
	}
	public static fun ScoreStatus() : Int
	{
		return 2;
	}
	public static fun ImpossibleStatus() : Int
	{
		return 3;
	}

	# (if (< (random 100) 50) "player" "spieler")
	public static fun Pre(IRng rng) : IText
	{
		if (rng.NextInt(100) < 50)
		{
			return Txt.PushWord(Txt.Empty(), 3944377513584);
		}
		return Txt.PushWord(Txt.Empty(), 504876840417395);
	}

	public static fun KeepOf(IPlayer p, IIntList acquiredHotels) : IBoolList
	{
		if (!p.HasExternal())
		{
			return Admin.AllTrue(acquiredHotels);
		}
		return p.External().Keep(acquiredHotels);
	}

	public static fun AllTrue(IIntList l) : IBoolList
	{
		if (l.IsEmpty())
		{
			return new BoolNil();
		}
		return new BoolCons(true, Admin.AllTrue(l.Rest()));
	}

	# (for/list ([h acquired-hotels] [d p-s-decisions]) (list h (if d #t #f)))
	public static fun Zip(IIntList hs, IBoolList ds) : IHotelDecisionList
	{
		if (hs.IsEmpty())
		{
			return new HotelDecisionNil();
		}
		if (ds.IsEmpty())
		{
			return new HotelDecisionNil();
		}
		return new HotelDecisionCons(Tree.MakeHotelDecision(hs.First(), ds.First()), Admin.Zip(hs.Rest(), ds.Rest()));
	}

	public static fun MakeTurn(IState s) : ITurn
	{
		IPlayer current = State.StateCurrentPlayer(s);
		return new TurnS(s, s.Board(), current, current.Money(), current.Tiles(), s.Shares(), s.Hotels(), s.Players());
	}

	public static fun Result(Int status, IState state, IStateList states) : IRunResult
	{
		return new RunResultS(status, true, State.StateScore(state), Admin.ReverseStates(states));
	}

	public static fun ReverseStates(IStateList l) : IStateList
	{
		IStateList r = new StateNil();
		while (!l.IsEmpty())
		{
			r = new StateCons(l.First(), r);
			l = l.Rest();
		}
		return r;
	}

	# the loop of run
	public static fun Loop(ITree tree0, Int n0, IStateList states0, ITilePicker nextTile) : IRunResult
	{
		ITree tree = tree0;
		Int n = n0;
		IStateList states = states0;
		while (true)
		{
			IState state = Tree.TreeState(tree);
			if (n == 0)
			{
				return Admin.Result(Admin.Done(), state, states);
			}
			if (state.Players().IsEmpty())
			{
				return Admin.Result(Admin.Exhausted(), state, states);
			}
			if (tree.IsLPlaced())
			{
				if (tree.NothingToPlace())
				{
					return Admin.Result(Admin.ScoreStatus(), state, states);
				}
			}
			IPlayer cur = State.StateCurrentPlayer(state);
			if (!cur.HasExternal())
			{
				ERROR("external/fail");
			}
			IPlayerExt external = cur.External();
			ITurn turn = Admin.MakeTurn(state);
			ITurnResult r = external.TakeTurn(turn);
			if (!r.HasTile())
			{
				return Admin.Result(Admin.ImpossibleStatus(), state, new StateCons(state, states));
			}
			ITile tile = r.Tile();
			Int hotelInvolved = r.Hotel();
			Bool merger = Admin.IsMerging(Board.WhatKindOfSpot(state.Board(), tile));
			if (merger)
			{
				if (!turn.PlaceCalled())
				{
					tree = Tree.GenerateTree(State.StateRemoveCurrentPlayer(state));
					n = n - 1;
					continue;
				}
			}
			IDecisionList ds = Admin.DecisionsIf(merger, turn);
			IPlayerList eliminate = turn.Eliminated();
			if (State.PlayerMember(State.StateCurrentPlayer(state), eliminate))
			{
				# failure: `(S "current player failed on keep")
				IState stateEliminate = State.StateRemoveCurrentPlayer(state);
				if (stateEliminate.Players().IsEmpty())
				{
					return new RunResultS(Admin.Exhausted(), false, new ScoreNil(), Admin.ReverseStates(states));
				}
				tree = Tree.GenerateTree(stateEliminate);
				n = n - 1;
				continue;
			}
			ITree treeEliminate = Admin.TreeEliminate(tree, state, eliminate);
			# exec
			ITileAndTree tt = Tree.TreeNext(treeEliminate, new NextArgsS(tile, hotelInvolved, ds, r.Buy(), nextTile));
			if (!tt.HasTile())
			{
				ERROR("no-tile");
			}
			external.ReceiveTile(tt.Tile());
			ITree nextTree = tt.Tree();
			IState st = Tree.TreeState(nextTree);
			# inform-all
			IPlayerList ps = st.Players();
			while (!ps.IsEmpty())
			{
				IPlayer p = ps.First();
				if (!p.HasExternal())
				{
					ERROR("external-fail");
				}
				p.External().Inform(st);
				ps = ps.Rest();
			}
			if (st.Tiles().IsEmpty())
			{
				return Admin.Result(Admin.Exhausted(), st, states);
			}
			tree = nextTree;
			n = n - 1;
			states = new StateCons(st, states);
		}
		ERROR("unreachable");
	}

	public static fun IsMerging(Int kind) : Bool
	{
		if (kind == Board.Merging())
		{
			return true;
		}
		return false;
	}

	public static fun DecisionsIf(Bool merger, ITurn turn) : IDecisionList
	{
		if (merger)
		{
			return turn.Decisions().Decisions();
		}
		return new DecisionNil();
	}

	public static fun TreeEliminate(ITree tree, IState state, IPlayerList eliminate) : ITree
	{
		if (eliminate.IsEmpty())
		{
			return tree;
		}
		return Tree.GenerateTree(State.StateEliminate(state, eliminate));
	}

	# player->internals
	public static fun PlayerToInternals(ITextList names0, IPlayerExtList externals0) : IPlayerList
	{
		IPlayerList internals = new PlayerNil();
		ITileList tiles = Board.AllTiles();
		ITextList names = names0;
		IPlayerExtList externals = externals0;
		while (!names.IsEmpty())
		{
			ITileList ts = Board.TileTake(tiles, Board.StarterTilesN());
			ITile t1 = ts.First();
			ITile t2 = ts.Rest().First();
			ITile t3 = ts.Rest().Rest().First();
			ITile t4 = ts.Rest().Rest().Rest().First();
			ITile t5 = ts.Rest().Rest().Rest().Rest().First();
			ITile t6 = ts.Rest().Rest().Rest().Rest().Rest().First();
			IPlayer player = State.Player0(names.First(), t1, t2, t3, t4, t5, t6, externals.First());
			internals = new PlayerCons(player, internals);
			tiles = Board.TileDrop(tiles, Board.StarterTilesN());
			names = names.Rest();
			externals = externals.Rest();
		}
		return internals;
	}

	public static fun SetupAll(IPlayerList players, IState state) : IState
	{
		IPlayerList ps = players;
		while (!ps.IsEmpty())
		{
			IPlayer p = ps.First();
			if (!p.HasExternal())
			{
				ERROR("external-failed");
			}
			p.External().Setup(state);
			ps = ps.Rest();
		}
		return state;
	}

	public static fun MakeAdministrator(ITilePicker nextTile, IRng rng) : IAdministrator
	{
		return new Administrator(nextTile, rng);
	}
}
