# automata.rkt: an N-states, N-inputs automaton.

class Automaton implements IAutomaton
{
	private readonly Int current;
	private readonly Int original;
	private readonly Int payoff;
	private readonly ITransitions table;
	public constructor(Int c, Int o, Int p, ITransitions t)
	{
		current = c;
		original = o;
		payoff = p;
		table = t;
	}
	public fun Current() : Int
	{
		return current;
	}
	public fun Original() : Int
	{
		return original;
	}
	public fun Payoff() : Int
	{
		return payoff;
	}
	public fun Table() : ITransitions
	{
		return table;
	}
}

# a Transition vector
class Transition implements ITransition
{
	private readonly ArrayList<Int> states;
	public constructor(ArrayList<Int> s)
	{
		states = s;
	}
	public fun Ref(Int i) : Int
	{
		return states.Get(i);
	}
}

# a Transition* vector
class Transitions implements ITransitions
{
	private readonly ArrayList<ITransition> rows;
	public constructor(ArrayList<ITransition> r)
	{
		rows = r;
	}
	public fun Ref(Int i) : ITransition
	{
		return rows.Get(i);
	}
}

class AutomatonPair implements IAutomatonPair
{
	private readonly IAutomaton fst;
	private readonly IAutomaton snd;
	public constructor(IAutomaton a, IAutomaton b)
	{
		fst = a;
		snd = b;
	}
	public fun Fst() : IAutomaton
	{
		return fst;
	}
	public fun Snd() : IAutomaton
	{
		return snd;
	}
}

# (cons Payoff Payoff)
class PayoffPair
{
	public readonly Int Car;
	public readonly Int Cdr;
	public constructor(Int a, Int d)
	{
		Car = a;
		Cdr = d;
	}
}

class Automata
{
	public static fun Cooperate() : Int
	{
		return 0;
	}
	public static fun Defect() : Int
	{
		return 1;
	}

	# (make-random-automaton n) builds an n states x n inputs automaton
	# with a random transition table
	public static fun MakeRandomAutomaton(Int n, IRng rng) : IAutomaton
	{
		Int originalCurrent = rng.NextInt(n);
		ArrayList<ITransition> rows = new ArrayList<ITransition>();
		Int i = 0;
		while (i < n)
		{
			ArrayList<Int> row = new ArrayList<Int>();
			Int j = 0;
			while (j < n)
			{
				row.Add(rng.NextInt(n));
				j = j + 1;
			}
			rows.Add(new Transition(row));
			i = i + 1;
		}
		return new Automaton(originalCurrent, originalCurrent, 0, new Transitions(rows));
	}

	public static fun MakeAutomaton(Int current, ITransitions table) : IAutomaton
	{
		return new Automaton(current, current, 0, table);
	}

	# (transitions #:i-cooperate/it-cooperates cc #:i-cooperate/it-defects cd
	#              #:i-defect/it-cooperates dc #:i-defect/it-defects dd)
	public static fun Transitions(Int cc, Int cd, Int dc, Int dd) : ITransitions
	{
		ArrayList<Int> c = new ArrayList<Int>();
		c.Add(cc);
		c.Add(cd);
		ArrayList<Int> d = new ArrayList<Int>();
		d.Add(dc);
		d.Add(dd);
		ArrayList<ITransition> t = new ArrayList<ITransition>();
		t.Add(new Transition(c));
		t.Add(new Transition(d));
		return new Transitions(t);
	}

	# CLASSIC AUTOMATA (module-level transition tables in Racket, rebuilt per call here)
	public static fun Defects(Int p0) : IAutomaton
	{
		Int d = Automata.Defect();
		return new Automaton(d, d, p0, Automata.Transitions(d, d, d, d));
	}

	public static fun Cooperates(Int p0) : IAutomaton
	{
		Int c = Automata.Cooperate();
		return new Automaton(c, c, p0, Automata.Transitions(c, c, c, c));
	}

	# the tit for tat starts out optimistic, it cooperates initially
	public static fun TitForTat(Int p0) : IAutomaton
	{
		Int c = Automata.Cooperate();
		Int d = Automata.Defect();
		return new Automaton(c, c, p0, Automata.Transitions(c, d, c, d));
	}

	# the grim trigger also starts out optimistic, but defects forever after one defection
	public static fun GrimTrigger(Int p0) : IAutomaton
	{
		Int c = Automata.Cooperate();
		Int d = Automata.Defect();
		return new Automaton(c, c, p0, Automata.Transitions(c, d, d, d));
	}

	# wipe out the historic payoff, set back to original state
	public static fun AutomatonReset(IAutomaton a) : IAutomaton
	{
		Int c0 = a.Original();
		return new Automaton(c0, c0, 0, a.Table());
	}

	# create new automaton from given one (same original state)
	public static fun Clone(IAutomaton a) : IAutomaton
	{
		Int c0 = a.Original();
		return new Automaton(c0, c0, 0, a.Table());
	}

	public static fun AutomatonPayoff(IAutomaton a) : Int
	{
		return a.Payoff();
	}

	# the sum of pay-offs for the two respective automata over all rounds
	public static fun MatchPair(IAutomaton auto1, IAutomaton auto2, Int roundsPerMatch) : IAutomatonPair
	{
		ArrayList<ArrayList<PayoffPair>> payoffTable = Automata.PayoffTable();
		Int current1 = auto1.Current();
		Int c1 = auto1.Original();
		Int payoff1 = auto1.Payoff();
		ITransitions table1 = auto1.Table();
		Int current2 = auto2.Current();
		Int c2 = auto2.Original();
		Int payoff2 = auto2.Payoff();
		ITransitions table2 = auto2.Table();
		Int k = 0;
		while (k < roundsPerMatch)
		{
			PayoffPair p = Automata.Payoff(payoffTable, current1, current2);
			Int n1 = table1.Ref(current1).Ref(current2);
			Int n2 = table2.Ref(current2).Ref(current1);
			current1 = n1;
			payoff1 = payoff1 + p.Car;
			current2 = n2;
			payoff2 = payoff2 + p.Cdr;
			k = k + 1;
		}
		return new AutomatonPair(new Automaton(current1, c1, payoff1, table1), new Automaton(current2, c2, payoff2, table2));
	}

	# PayoffTable = [Vectorof k [Vectorof k (cons Payoff Payoff)]]
	# (a module-level constant in Racket; built once per match-pair here)
	public static fun PayoffTable() : ArrayList<ArrayList<PayoffPair>>
	{
		ArrayList<PayoffPair> r0 = new ArrayList<PayoffPair>();
		r0.Add(new PayoffPair(3, 3));
		r0.Add(new PayoffPair(0, 4));
		ArrayList<PayoffPair> r1 = new ArrayList<PayoffPair>();
		r1.Add(new PayoffPair(4, 0));
		r1.Add(new PayoffPair(1, 1));
		ArrayList<ArrayList<PayoffPair>> t = new ArrayList<ArrayList<PayoffPair>>();
		t.Add(r0);
		t.Add(r1);
		return t;
	}

	public static fun Payoff(ArrayList<ArrayList<PayoffPair>> table, Int current1, Int current2) : PayoffPair
	{
		return table.Get(current1).Get(current2);
	}
}
