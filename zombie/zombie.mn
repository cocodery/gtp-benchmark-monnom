}

# ---------------------------------------------------------------------------- new-zombie
class ZombieObj implements IZombie
{
	private readonly IPosn p;
	public constructor(IPosn p0)
	{
		p = p0;
	}
	public fun this(Int msg) : IZombieMsg
	{
		if (msg == 3)
		{
			return new ZombieMsgPosnThunk(3, new FnZombiePosn(p));
		}
		if (msg == 10)
		{
			return new ZombieMsgStringImageToImage(10, new FnZombieDrawOnColor(p));
		}
		if (msg == 11)
		{
			return new ZombieMsgPosnToBool(11, new FnZombieTouching(p));
		}
		if (msg == 8)
		{
			return new ZombieMsgPosnToZombie(8, new FnZombieMoveToward(p));
		}
		ERROR("zombie: unknown message");
	}
}

class FnZombiePosn implements IPosnThunk
{
	private readonly IPosn p;
	public constructor(IPosn p0)
	{
		p = p0;
	}
	public fun this() : IPosn
	{
		return p;
	}
}

class FnZombieDrawOnColor implements IStringImageToImage
{
	private readonly IPosn p;
	public constructor(IPosn p0)
	{
		p = p0;
	}
	public fun this(String c, IImage s) : IImage
	{
		return Getters.PosnDrawOnImage(p)(Images.Circle(Zombie.ZombieRadius(), "solid", c), s);
	}
}

class FnZombieTouching implements IPosnToBool
{
	private readonly IPosn p;
	public constructor(IPosn p0)
	{
		p = p0;
	}
	public fun this(IPosn q) : Bool
	{
		return Getters.PosnDist(p)(q) <= Zombie.ZombieRadius();
	}
}

class FnZombieMoveToward implements IPosnToZombie
{
	private readonly IPosn p;
	public constructor(IPosn p0)
	{
		p = p0;
	}
	public fun this(IPosn q) : IZombie
	{
		return Zombie.NewZombie(Getters.PosnMoveTowardSpeed(p)(q, Zombie.ZombieSpeed()));
	}
}

# ---------------------------------------------------------------------------- new-posn
class PosnObj implements IPosn
{
	private readonly Float x;
	private readonly Float y;
	public constructor(Float x0, Float y0)
	{
		x = x0;
		y = y0;
	}
	public fun this(Int msg) : IPosnMsg
	{
		IPosn self = Zombie.NewPosn(x, y);
		if (msg == 1)
		{
			return new PosnMsgRealThunk(1, new FnPosnX(x));
		}
		if (msg == 2)
		{
			return new PosnMsgRealThunk(2, new FnPosnY(y));
		}
		if (msg == 3)
		{
			return new PosnMsgPosnThunk(3, new FnPosnPosn(self));
		}
		if (msg == 4)
		{
			return new PosnMsgPosnRealToPosn(msg, new FnPosnMoveTowardSpeed(x, y, self));
		}
		if (msg == 5)
		{
			return new PosnMsgRealRealToPosn(5, new FnPosnMove(x, y));
		}
		if (msg == 6)
		{
			return new PosnMsgImageImageToImage(6, new FnPosnDrawOnImage(x, y));
		}
		if (msg == 7)
		{
			return new PosnMsgPosnToReal(7, new FnPosnDist(x, y));
		}
		ERROR("posn: unknown message");
	}
}

class FnPosnX implements IRealThunk
{
	private readonly Float x;
	public constructor(Float x0)
	{
		x = x0;
	}
	public fun this() : Float
	{
		return x;
	}
}

class FnPosnY implements IRealThunk
{
	private readonly Float y;
	public constructor(Float y0)
	{
		y = y0;
	}
	public fun this() : Float
	{
		return y;
	}
}

class FnPosnPosn implements IPosnThunk
{
	private readonly IPosn self;
	public constructor(IPosn s)
	{
		self = s;
	}
	public fun this() : IPosn
	{
		return self;
	}
}

class FnPosnMoveTowardSpeed implements IPosnRealToPosn
{
	private readonly Float x;
	private readonly Float y;
	private readonly IPosn self;
	public constructor(Float x0, Float y0, IPosn s)
	{
		x = x0;
		y = y0;
		self = s;
	}
	public fun this(IPosn p, Float speed) : IPosn
	{
		Float x2 = Getters.PosnX(p)() - x;
		Float y2 = Getters.PosnY(p)() - y;
		Float moveDistance = MathRkt.Min(speed, MathRkt.Max(MathRkt.Abs(x2), MathRkt.Abs(y2)));
		if (MathRkt.Abs(x2) < MathRkt.Abs(y2))
		{
			if (y2 > 0.0)
			{
				return Getters.PosnMove(self)(0.0, moveDistance);
			}
			return Getters.PosnMove(self)(0.0, 0.0 - moveDistance);
		}
		if (x2 > 0.0)
		{
			return Getters.PosnMove(self)(moveDistance, 0.0);
		}
		return Getters.PosnMove(self)(0.0 - moveDistance, 0.0);
	}
}

class FnPosnMove implements IRealRealToPosn
{
	private readonly Float x;
	private readonly Float y;
	public constructor(Float x0, Float y0)
	{
		x = x0;
		y = y0;
	}
	public fun this(Float dx, Float dy) : IPosn
	{
		return Zombie.NewPosn(x + dx, y + dy);
	}
}

class FnPosnDrawOnImage implements IImageImageToImage
{
	private readonly Float x;
	private readonly Float y;
	public constructor(Float x0, Float y0)
	{
		x = x0;
		y = y0;
	}
	public fun this(IImage img, IImage scn) : IImage
	{
		return Images.PlaceImage(img, x, y, scn);
	}
}

class FnPosnDist implements IPosnToReal
{
	private readonly Float x;
	private readonly Float y;
	public constructor(Float x0, Float y0)
	{
		x = x0;
		y = y0;
	}
	public fun this(IPosn p) : Float
	{
		return MathRkt.Msqrt(MathRkt.Sqr(Getters.PosnY(p)() - y) + MathRkt.Sqr(Getters.PosnX(p)() - x));
	}
}

# ---------------------------------------------------------------------------- message pairs and getters
# (cons tag payload) with a IRealThunk payload
class PosnMsgRealThunk implements IPosnMsg
{
	private readonly Int tag;
	private readonly IRealThunk payload;
	public constructor(Int t, IRealThunk p)
	{
		tag = t;
		payload = p;
	}
	public fun Tag() : Int
	{
		return tag;
	}
	public fun AsRealThunk() : IRealThunk
	{
		return payload;
	}
	public fun AsPosnThunk() : IPosnThunk
	{
		ERROR("cdr: wrong payload");
	}
	public fun AsPosnRealToPosn() : IPosnRealToPosn
	{
		ERROR("cdr: wrong payload");
	}
	public fun AsRealRealToPosn() : IRealRealToPosn
	{
		ERROR("cdr: wrong payload");
	}
	public fun AsImageImageToImage() : IImageImageToImage
	{
		ERROR("cdr: wrong payload");
	}
	public fun AsPosnToReal() : IPosnToReal
	{
		ERROR("cdr: wrong payload");
	}
}

# (cons tag payload) with a IPosnThunk payload
class PosnMsgPosnThunk implements IPosnMsg
{
	private readonly Int tag;
	private readonly IPosnThunk payload;
	public constructor(Int t, IPosnThunk p)
	{
		tag = t;
		payload = p;
	}
	public fun Tag() : Int
	{
		return tag;
	}
	public fun AsRealThunk() : IRealThunk
	{
		ERROR("cdr: wrong payload");
	}
	public fun AsPosnThunk() : IPosnThunk
	{
		return payload;
	}
	public fun AsPosnRealToPosn() : IPosnRealToPosn
	{
		ERROR("cdr: wrong payload");
	}
	public fun AsRealRealToPosn() : IRealRealToPosn
	{
		ERROR("cdr: wrong payload");
	}
