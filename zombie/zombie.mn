# zombie.rkt: the game, written with closures as objects.
# Every Racket (lambda ...) is a class with a single `this` method, every object
# (new-posn, new-zombie, ...) is a class whose `this` method dispatches on the message tag.

# ---------------------------------------------------------------------------- module functions
class Zombie
{
	public static fun Width() : Float
	{
		return 400.0;
	}
	public static fun Height() : Float
	{
		return 400.0;
	}
	public static fun MtScene() : IImage
	{
		return Images.EmptyScene(Zombie.Width(), Zombie.Height());
	}
	public static fun PlayerSpeed() : Float
	{
		return 4.0;
	}
	public static fun ZombieSpeed() : Float
	{
		return 2.0;
	}
	public static fun ZombieRadius() : Float
	{
		return 20.0;
	}
	public static fun PlayerRadius() : Float
	{
		return 20.0;
	}
	public static fun PlayerImg() : IImage
	{
		return Images.Circle(Zombie.PlayerRadius(), "solid", "green");
	}
	public static fun NewWorld(IPlayer player, IPosn mouse, IHorde zombies) : IWorld
	{
		return new WorldObj(player, mouse, zombies);
	}
	public static fun NewPlayer(IPosn p) : IPlayer
	{
		return new PlayerObj(p);
	}
	public static fun NewHorde(IZombies undead, IZombies dead) : IHorde
	{
		return new HordeObj(undead, dead);
	}
	public static fun NewConsZombies(IZombie z, IZombies r) : IZombies
	{
		return new ConsZombiesObj(z, r);
	}
	public static fun NewMtZombies() : IZombies
	{
		return new MtZombiesObj();
	}
	public static fun NewZombie(IPosn p) : IZombie
	{
		return new ZombieObj(p);
	}
	public static fun NewPosn(Float x, Float y) : IPosn
	{
		return new PosnObj(x, y);
	}
	# w0 (a module-level value in Racket)
	public static fun W0() : IWorld
	{
		return Zombie.NewWorld(
			Zombie.NewPlayer(Zombie.NewPosn(0.0, 0.0)),
			Zombie.NewPosn(0.0, 0.0),
			Zombie.NewHorde(
				Zombie.NewConsZombies(
					Zombie.NewZombie(Zombie.NewPosn(100.0, 300.0)),
					Zombie.NewConsZombies(
						Zombie.NewZombie(Zombie.NewPosn(100.0, 200.0)),
						Zombie.NewMtZombies())),
				Zombie.NewConsZombies(
					Zombie.NewZombie(Zombie.NewPosn(200.0, 200.0)),
					Zombie.NewMtZombies())));
	}
}

# ---------------------------------------------------------------------------- new-world
class WorldObj implements IWorld
{
	private readonly IPlayer player;
	private readonly IPosn mouse;
	private readonly IHorde zombies;
	public constructor(IPlayer p, IPosn m, IHorde z)
	{
		player = p;
		mouse = m;
		zombies = z;
	}
	public fun this(Int msg) : IWorldMsg
	{
		if (msg == 16)
		{
			return new WorldMsgMouseToWorld(16, new FnWorldOnMouse(player, zombies));
		}
		if (msg == 17)
		{
			return new WorldMsgWorldThunk(17, new FnWorldOnTick(player, mouse, zombies));
		}
		if (msg == 18)
		{
			return new WorldMsgImageThunk(18, new FnWorldToDraw(player, zombies));
		}
		if (msg == 19)
		{
			return new WorldMsgBoolThunk(19, new FnWorldStopWhen(player, zombies));
		}
		ERROR("world: unknown message");
	}
}

class FnWorldOnMouse implements IMouseToWorld
{
	private readonly IPlayer player;
	private readonly IHorde zombies;
	public constructor(IPlayer p, IHorde z)
	{
		player = p;
		zombies = z;
	}
	public fun this(IMouseArgs a) : IWorld
	{
		if (a.Me() == 2)
		{
			return Zombie.NewWorld(player, Getters.PlayerPosn(player)(), zombies);
		}
		return Zombie.NewWorld(player, Zombie.NewPosn(a.X(), a.Y()), zombies);
	}
}

class FnWorldOnTick implements IWorldThunk
{
	private readonly IPlayer player;
	private readonly IPosn mouse;
	private readonly IHorde zombies;
	public constructor(IPlayer p, IPosn m, IHorde z)
	{
		player = p;
		mouse = m;
		zombies = z;
	}
	public fun this() : IWorld
	{
		IPlayer moved = Getters.PlayerMoveToward(player)(mouse);
		IHorde eaten = Getters.HordeEatBrains(zombies)();
		return Zombie.NewWorld(moved, mouse, Getters.HordeMoveToward(eaten)(Getters.PlayerPosn(player)()));
	}
}

class FnWorldToDraw implements IImageThunk
{
	private readonly IPlayer player;
	private readonly IHorde zombies;
	public constructor(IPlayer p, IHorde z)
	{
		player = p;
		zombies = z;
	}
	public fun this() : IImage
	{
		return Getters.PlayerDrawOn(player)(Getters.HordeDrawOn(zombies)(Zombie.MtScene()));
	}
}

class FnWorldStopWhen implements IBoolThunk
{
	private readonly IPlayer player;
	private readonly IHorde zombies;
	public constructor(IPlayer p, IHorde z)
	{
		player = p;
		zombies = z;
	}
	public fun this() : Bool
	{
		return Getters.HordeTouching(zombies)(Getters.PlayerPosn(player)());
	}
}

# ---------------------------------------------------------------------------- new-player
class PlayerObj implements IPlayer
{
	private readonly IPosn p;
	public constructor(IPosn p0)
	{
		p = p0;
	}
	public fun this(Int msg) : IPlayerMsg
	{
		if (msg == 3)
		{
			return new PlayerMsgPosnThunk(3, new FnPlayerPosn(p));
		}
		if (msg == 8)
		{
			return new PlayerMsgPosnToPlayer(8, new FnPlayerMoveToward(p));
		}
		if (msg == 9)
		{
			return new PlayerMsgImageToImage(9, new FnPlayerDrawOn(p));
		}
		ERROR("player: unknown message");
	}
}

class FnPlayerPosn implements IPosnThunk
{
	private readonly IPosn p;
	public constructor(IPosn p0)
	{
		p = p0;
	}
	public fun this() : IPosn
	{
		return p;
	}
}

class FnPlayerMoveToward implements IPosnToPlayer
{
	private readonly IPosn p;
	public constructor(IPosn p0)
	{
		p = p0;
	}
	public fun this(IPosn q) : IPlayer
	{
		return Zombie.NewPlayer(Getters.PosnMoveTowardSpeed(p)(q, Zombie.PlayerSpeed()));
	}
}

class FnPlayerDrawOn implements IImageToImage
{
	private readonly IPosn p;
	public constructor(IPosn p0)
	{
		p = p0;
	}
	public fun this(IImage scn) : IImage
	{
		return Getters.PosnDrawOnImage(p)(Zombie.PlayerImg(), scn);
	}
}

# ---------------------------------------------------------------------------- new-horde
class HordeObj implements IHorde
{
	private readonly IZombies undead;
	private readonly IZombies dead;
	public constructor(IZombies u, IZombies d)
	{
		undead = u;
		dead = d;
	}
	public fun this(Int msg) : IHordeMsg
	{
		if (msg == 12)
		{
			return new HordeMsgZombiesThunk(12, new FnHordeDead(dead));
		}
		if (msg == 13)
		{
			return new HordeMsgZombiesThunk(13, new FnHordeUndead(undead));
		}
		if (msg == 9)
		{
			return new HordeMsgImageToImage(9, new FnHordeDrawOn(undead, dead));
		}
		if (msg == 11)
		{
			return new HordeMsgPosnToBool(11, new FnHordeTouching(undead, dead));
		}
		if (msg == 8)
		{
			return new HordeMsgPosnToHorde(8, new FnHordeMoveToward(undead, dead));
		}
		if (msg == 14)
		{
			return new HordeMsgHordeThunk(14, new FnHordeEatBrains(undead, dead));
		}
		ERROR("horde: unknown message");
	}
}

class FnHordeDead implements IZombiesThunk
{
	private readonly IZombies dead;
	public constructor(IZombies d)
	{
		dead = d;
	}
	public fun this() : IZombies
	{
		return dead;
	}
}

class FnHordeUndead implements IZombiesThunk
{
	private readonly IZombies undead;
	public constructor(IZombies u)
	{
		undead = u;
	}
	public fun this() : IZombies
	{
		return undead;
	}
}

class FnHordeDrawOn implements IImageToImage
{
	private readonly IZombies undead;
	private readonly IZombies dead;
	public constructor(IZombies u, IZombies d)
	{
		undead = u;
		dead = d;
	}
	public fun this(IImage scn) : IImage
	{
		return Getters.ZombiesDrawOnColor(undead)("yellow", Getters.ZombiesDrawOnColor(dead)("black", scn));
	}
}

class FnHordeTouching implements IPosnToBool
{
	private readonly IZombies undead;
	private readonly IZombies dead;
	public constructor(IZombies u, IZombies d)
	{
		undead = u;
		dead = d;
	}
	public fun this(IPosn p) : Bool
	{
		if (Getters.ZombiesTouching(undead)(p))
		{
			return true;
		}
		return Getters.ZombiesTouching(dead)(p);
	}
}

class FnHordeMoveToward implements IPosnToHorde
{
	private readonly IZombies undead;
	private readonly IZombies dead;
	public constructor(IZombies u, IZombies d)
	{
		undead = u;
		dead = d;
	}
	public fun this(IPosn p) : IHorde
	{
		return Zombie.NewHorde(Getters.ZombiesMoveToward(undead)(p), dead);
	}
}

class FnHordeEatBrains implements IHordeThunk
{
	private readonly IZombies undead;
	private readonly IZombies dead;
	public constructor(IZombies u, IZombies d)
	{
		undead = u;
		dead = d;
	}
	public fun this() : IHorde
	{
		return Getters.ZombiesKillAll(undead)(dead);
	}
}

# ---------------------------------------------------------------------------- new-cons-zombies
class ConsZombiesObj implements IZombies
{
	private readonly IZombie z;
	private readonly IZombies r;
	public constructor(IZombie z0, IZombies r0)
	{
		z = z0;
		r = r0;
	}
	public fun this(Int msg) : IZombiesMsg
	{
		if (msg == 8)
		{
			return new ZombiesMsgPosnToZombies(8, new FnConsMoveToward(z, r));
		}
		if (msg == 10)
		{
			return new ZombiesMsgStringImageToImage(10, new FnConsDrawOnColor(z, r));
		}
		if (msg == 11)
		{
			return new ZombiesMsgPosnToBool(11, new FnConsTouching(z, r));
		}
		if (msg == 15)
		{
			return new ZombiesMsgZombiesToHorde(15, new FnConsKillAll(z, r));
		}
		ERROR("zombies: unknown message");
	}
}

class FnConsMoveToward implements IPosnToZombies
{
	private readonly IZombie z;
	private readonly IZombies r;
	public constructor(IZombie z0, IZombies r0)
	{
		z = z0;
		r = r0;
	}
	public fun this(IPosn p) : IZombies
	{
		return Zombie.NewConsZombies(Getters.ZombieMoveToward(z)(p), Getters.ZombiesMoveToward(r)(p));
	}
}

class FnConsDrawOnColor implements IStringImageToImage
{
	private readonly IZombie z;
	private readonly IZombies r;
	public constructor(IZombie z0, IZombies r0)
	{
		z = z0;
		r = r0;
	}
	public fun this(String c, IImage s) : IImage
	{
		return Getters.ZombieDrawOnColor(z)(c, Getters.ZombiesDrawOnColor(r)(c, s));
	}
}

class FnConsTouching implements IPosnToBool
{
	private readonly IZombie z;
	private readonly IZombies r;
	public constructor(IZombie z0, IZombies r0)
	{
		z = z0;
		r = r0;
	}
	public fun this(IPosn p) : Bool
	{
		if (Getters.ZombieTouching(z)(p))
		{
			return true;
		}
		return Getters.ZombiesTouching(r)(p);
	}
}

class FnConsKillAll implements IZombiesToHorde
{
	private readonly IZombie z;
	private readonly IZombies r;
	public constructor(IZombie z0, IZombies r0)
	{
		z = z0;
		r = r0;
	}
	public fun this(IZombies dead) : IHorde
	{
		if (Getters.ZombiesTouching(r)(Getters.ZombiePosn(z)()))
		{
			return Getters.ZombiesKillAll(r)(Zombie.NewConsZombies(z, dead));
		}
		if (Getters.ZombiesTouching(dead)(Getters.ZombiePosn(z)()))
		{
			return Getters.ZombiesKillAll(r)(Zombie.NewConsZombies(z, dead));
		}
		IHorde res = Getters.ZombiesKillAll(r)(dead);
		return Zombie.NewHorde(Zombie.NewConsZombies(z, Getters.HordeUndead(res)()), Getters.HordeDead(res)());
	}
}

