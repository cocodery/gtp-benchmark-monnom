	}
	public fun this(Int msg) : IZombiesMsg
	{
		if (msg == 8)
		{
			return new ZombiesMsgPosnToZombies(8, new FnMtMoveToward());
		}
		if (msg == 10)
		{
			return new ZombiesMsgStringImageToImage(10, new FnMtDrawOnColor());
		}
		if (msg == 11)
		{
			return new ZombiesMsgPosnToBool(11, new FnMtTouching());
		}
		if (msg == 15)
		{
			return new ZombiesMsgZombiesToHorde(15, new FnMtKillAll());
		}
		ERROR("zombies: unknown message");
	}
}

class FnMtMoveToward implements IPosnToZombies
{
	public constructor()
	{
	}
	public fun this(IPosn p) : IZombies
	{
		return Zombie.NewMtZombies();
	}
}

class FnMtDrawOnColor implements IStringImageToImage
{
	public constructor()
	{
	}
	public fun this(String c, IImage s) : IImage
	{
		return s;
	}
}

class FnMtTouching implements IPosnToBool
{
	public constructor()
	{
	}
	public fun this(IPosn p) : Bool
	{
		return false;
	}
}

class FnMtKillAll implements IZombiesToHorde
{
	public constructor()
