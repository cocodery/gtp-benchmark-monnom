# quad-main.rkt, quick-sample.rkt, render.rkt and main.rkt of quadU, derived from the quadT
# port (differences marked "quadU:"; merged to keep the configuration
# count down; see NOTES.md)

# ---- quad-main.rkt ----

# the constraints of lines->columns (closures over lines-remaining)
class GreedinessConstraint implements IConstraintFn
{
	private readonly Int linesRemaining;
	public constructor(Int n)
	{
		linesRemaining = n;
	}
	public fun this(Int pl) : Bool
	{
		Int leftover = linesRemaining - pl;
		if (leftover == 0)
		{
			return true;
		}
		return leftover >= World.MinimumLinesPerColumn();
	}
}

class LastLinesConstraint implements IConstraintFn
{
	private readonly IQuadList linesRemaining;
	public constructor(IQuadList l)
	{
		linesRemaining = l;
	}
	public fun this(Int pl) : Bool
	{
		IQuad lastLineOfPage = QuadMain.ListRef(linesRemaining, pl - 1);
		Int linesInThisParagraph = QuadMain.AssertIndex(Quads.AttrRefMissing(lastLineOfPage, Sym.Lines()));
		Int lineIndexOfLastLine = QuadMain.AssertIndex(Quads.AttrRefMissing(lastLineOfPage, Sym.LineIdx()));
		if (linesInThisParagraph < World.MinLastLines())
		{
			return true;
		}
		return lineIndexOfLastLine + 1 >= World.MinLastLines();
	}
}

class FirstLinesConstraint implements IConstraintFn
{
	private readonly IQuadList linesRemaining;
	public constructor(IQuadList l)
	{
		linesRemaining = l;
	}
	public fun this(Int pl) : Bool
	{
		IQuad lastLineOfPage = QuadMain.ListRef(linesRemaining, pl - 1);
		Int linesInThisParagraph = Quads.AttrRefMissing(lastLineOfPage, Sym.Lines()).I();
		Int lineIndexOfLastLine = Quads.AttrRefMissing(lastLineOfPage, Sym.LineIdx()).I();
		Int linesThatWillRemain = linesInThisParagraph - (lineIndexOfLastLine + 1);
		if (linesInThisParagraph < World.MinFirstLines())
		{
			return true;
		}
		if (linesThatWillRemain == 0)
		{
			return true;
		}
		return linesThatWillRemain >= World.MinFirstLines();
	}
}

class QuadMain
{
	public static fun AssertIndex(IVal v) : Int
	{
		if (v.Kind() != 1)
		{
			ERROR("assert: index?");
		}
		if (v.I() < 0)
		{
			ERROR("assert: index?");
		}
		return v.I();
	}

	public static fun ListRef(IQuadList l, Int k) : IQuad
	{
		Int i = 0;
		while (i < k)
		{
			l = l.Rest();
			i = i + 1;
		}
		return l.First();
	}

	public static fun Typeset(IQuad x, IEnv env, IProblem prob) : IQuad
	{
		# load-text-cache-file: there is no cache file (see NOTES.md)
		IQuadList pages = new QuadNil();
		IQuadL4 multipages = QuadMain.InputToNestedBlocks(x);
		while (!multipages.IsEmpty())
		{
			IQuadListListList multipage = multipages.First();
			multipages = multipages.Rest();
			IQuadList cols = new QuadNil();
			IQuadListListList mcs = multipage;
			while (!mcs.IsEmpty())
			{
				IQuadListList multicolumn = mcs.First();
				mcs = mcs.Rest();
				IQuadList lines = new QuadNil();
				IQuadListList bs = multicolumn;
				while (!bs.IsEmpty())
				{
					lines = SugarList.Append(lines, QuadMain.BlockQuadsToLines(bs.First(), env));
					bs = bs.Rest();
				}
				cols = SugarList.Append(cols, QuadMain.LinesToColumns(lines, prob));
			}
			pages = SugarList.Append(pages, QuadMain.ColumnsToPages(cols));
		}
		IQuad doc = QuadMain.PagesToDoc(pages, env);
		# update-text-cache-file does not write (see NOTES.md)
		return doc;
	}

	# cons-reverse at each level
	public static fun ConsReverse1(IQuadList xs, IQuadListList ys) : IQuadListList
	{
		return new QuadListCons(SugarList.Reverse(xs), ys);
	}

	public static fun ConsReverse2(IQuadListList xs, IQuadListListList ys) : IQuadListListList
	{
		return new QuadListListCons(SugarList.ReverseLists(xs), ys);
	}

	public static fun ReverseL3(IQuadListListList l) : IQuadListListList
	{
		IQuadListListList r = new QuadListListNil();
		while (!l.IsEmpty())
		{
			r = new QuadListListCons(l.First(), r);
			l = l.Rest();
		}
		return r;
	}

	public static fun ConsReverse3(IQuadListListList xs, IQuadL4 ys) : IQuadL4
	{
		return new QuadL4Cons(QuadMain.ReverseL3(xs), ys);
	}

	public static fun ReverseL4(IQuadL4 l) : IQuadL4
	{
		IQuadL4 r = new QuadL4Nil();
		while (!l.IsEmpty())
		{
			r = new QuadL4Cons(l.First(), r);
			l = l.Rest();
		}
		return r;
	}

	public static fun InputToNestedBlocks(IQuad i) : IQuadL4
	{
		IQuadL4 multipages = new QuadL4Nil();
		IQuadListListList multicolumns = new QuadListListNil();
		IQuadListList blocks = new QuadListNil();
		IQuadList blockAcc = new QuadNil();
		IQuadList qs = Utils.SplitQuad(i);
		while (!qs.IsEmpty())
		{
			IQuad q = qs.First();
			qs = qs.Rest();
			if (Quads.IsPageBreak(q))
			{
				multipages = QuadMain.ConsReverse3(QuadMain.ConsReverse2(QuadMain.ConsReverse1(blockAcc, blocks), multicolumns), multipages);
				multicolumns = new QuadListListNil();
				blocks = new QuadListNil();
				blockAcc = new QuadNil();
				continue;
			}
			if (Quads.IsColumnBreak(q))
			{
				multicolumns = QuadMain.ConsReverse2(QuadMain.ConsReverse1(blockAcc, blocks), multicolumns);
				blocks = new QuadListNil();
				blockAcc = new QuadNil();
				continue;
			}
			if (Quads.IsBlockBreak(q))
			{
				blocks = QuadMain.ConsReverse1(blockAcc, blocks);
				blockAcc = new QuadNil();
				continue;
			}
			blockAcc = new QuadCons(q, blockAcc);
		}
		return QuadMain.ReverseL4(QuadMain.ConsReverse3(QuadMain.ConsReverse2(QuadMain.ConsReverse1(blockAcc, blocks), multicolumns), multipages));
	}

	public static fun MergeAdjacentWithin(IQuad q) : IQuad
	{
		return Quads.Make(q.Name(), q.Attrs(), Quads.QuadsToItems(Utils.JoinQuads(Quads.ItemsToQuads(q.Items()))));
	}

	public static fun HyphenateQuadExceptLastWord(IQuad q, IEnv env) : IQuad
	{
		IItemList firstQuads = Utils.ItemsButLast(q.Items());
		IItem lastQuad = Utils.ItemsLast(q.Items());
		return Quads.Make(q.Name(), q.Attrs(), Wrap.ItemsAppend(Utils.HyphenateItems(firstQuads, env), new ItemCons(lastQuad, new ItemNil())));
	}

	public static fun AverageLooseness(IQuadList lines) : Float
	{
		Int n = SugarList.Length(lines);
		if (n <= 1)
		{
			return 0.0;
		}
		IQuadList linesToMeasure = Utils.QuadsButLast(lines);
		Float acc = 0.0;
		while (!linesToMeasure.IsEmpty())
		{
			acc = Quads.AttrRef(linesToMeasure.First(), Sym.Looseness(), Vals.F(0.0)).F() + acc;
			linesToMeasure = linesToMeasure.Rest();
		}
		return Utils.RoundFloat(acc / ((n + 0.0) - 1.0));
	}

	public static fun WrapQuads(IQuadList qs, Int quality, IEnv env) : IQuadList
	{
		return Wrap.WrapBest(qs, env);
	}

	public static fun BlockToLines(IQuad b, IEnv env) : IQuadList
	{
		# quadU: the wrap procedure is always wrap-best (the quality is not read)
		Int quality = World.MaxQuality();
		IQuadList wrappedLinesWithoutHyphens = QuadMain.WrapQuads(Quads.ItemsToQuads(b.Items()), quality, env);
		Float avgLooseness = QuadMain.AverageLooseness(wrappedLinesWithoutHyphens);
		IQuadList wrappedLines = QuadMain.HyphenatedIfLoose(b, wrappedLinesWithoutHyphens, avgLooseness, quality, env);
		Int n = SugarList.Length(wrappedLines);
		IQuadList out1 = new QuadNil();
		Int lineIdx = 0;
		IQuadList l = wrappedLines;
		while (!l.IsEmpty())
		{
			IQuad theLine = l.First();
			IValList kvs = new ValCons(Vals.Sym(Sym.LineIdx()), new ValCons(Vals.I(lineIdx), new ValCons(Vals.Sym(Sym.Lines()), new ValCons(Vals.I(n), new ValNil()))));
			IQuad numbered = Quads.Line(Utils.AttrChange(theLine.Attrs(), kvs), theLine.Items());
			out1 = new QuadCons(Wrap.InsertSpacersInLine(numbered, 0 - 1), out1);
			lineIdx = lineIdx + 1;
			l = l.Rest();
		}
		return SugarList.Reverse(out1);
	}

	public static fun HyphenatedIfLoose(IQuad b, IQuadList withoutHyphens, Float avgLooseness, Int quality, IEnv env) : IQuadList
	{
		if (World.UseHyphenation())
		{
			if (avgLooseness > World.LineLoosenessTolerance())
			{
				IQuad merged = QuadMain.MergeAdjacentWithin(b);
				IQuad hyphenated = QuadMain.HyphenateBlock(merged, env);
				return QuadMain.WrapQuads(Utils.SplitQuad(hyphenated), quality, env);
			}
		}
		return withoutHyphens;
	}

	public static fun HyphenateBlock(IQuad merged, IEnv env) : IQuad
	{
		if (World.AllowHyphenatedLastWordInParagraph())
		{
			return Utils.HyphenateQuad(Vals.QuadItem(merged), env).Q();
		}
		return QuadMain.HyphenateQuadExceptLastWord(merged, env);
	}

	public static fun NumberPages(IQuadList ps) : IQuadList
	{
		IQuadList out1 = new QuadNil();
		Int i = 0;
		while (!ps.IsEmpty())
		{
			IQuad p = ps.First();
			IAttrList kvs = Quads.MakeQuadattrs(new ValCons(Vals.Sym(Sym.Page()), new ValCons(Vals.I(i), new ValNil())));
			out1 = new QuadCons(Quads.Page(Utils.MergeAttrs(p.Attrs(), kvs), p.Items()), out1);
			i = i + 1;
			ps = ps.Rest();
		}
		return SugarList.Reverse(out1);
	}

	public static fun ColumnsMapper(IQuad pageIn, IEnv env) : IQuad
	{
		IQuadList cols = new QuadNil();
		IItemList l = pageIn.Items();
		while (!l.IsEmpty())
		{
			IQuad col = l.First().Q();
			l = l.Rest();
			if (!Quads.IsColumn(col))
			{
				ERROR("assert: column?");
			}
			IQuad newCol = Quads.Column(col.Attrs(), Quads.QuadsToItems(QuadMain.MapLines(Quads.GroupQuadList(col), env)));
			cols = new QuadCons(Utils.AddVertPositions(newCol), cols);
		}
		return Quads.Page(pageIn.Attrs(), Quads.QuadsToItems(SugarList.Reverse(cols)));
	}

	public static fun MapLines(IQuadList lns, IEnv env) : IQuadList
	{
		if (lns.IsEmpty())
		{
			return lns;
		}
		IQuad ln = lns.First();
		if (!Quads.IsLine(ln))
		{
			ERROR("assert: line?");
		}
		IQuad done = Utils.ComputeLineHeight(Wrap.AddHorizPositions(Wrap.Fill(ln, false, 0.0, env), env));
		return new QuadCons(done, QuadMain.MapLines(lns.Rest(), env));
	}

	public static fun PagesToDoc(IQuadList ps, IEnv env) : IQuad
	{
		IQuadList numbered = QuadMain.NumberPages(ps);
		IQuadList mapped = new QuadNil();
		while (!numbered.IsEmpty())
		{
			mapped = new QuadCons(QuadMain.ColumnsMapper(numbered.First(), env), mapped);
			numbered = numbered.Rest();
		}
		return Quads.QuadsToDoc(SugarList.Reverse(mapped));
	}

	# (sequence->list (in-range start end -1))
	public static fun Viable(Int start, Int end) : IIntList
	{
		IIntList l = new IntNil();
		Int k = end + 1;
		while (k <= start)
		{
			l = new IntCons(k, l);
			k = k + 1;
		}
		return l;
	}

	public static fun Min(Int a, Int b) : Int
	{
		if (a < b)
		{
			return a;
		}
		return b;
	}

	public static fun Max(Int a, Int b) : Int
	{
		if (a > b)
		{
			return a;
		}
		return b;
	}

	public static fun LinesToColumns(IQuadList lines, IProblem prob) : IQuadList
	{
		Int maxColumnLines = World.DefaultLinesPerColumn();
		IQuadList columns = new QuadNil();
		IQuadList linesRemaining = lines;
		Int colIdx = 0;
		IText variable = Txt.PushWord(Txt.PushWord(Txt.Empty(), 7627047690122770403), 1897198);
		while (!linesRemaining.IsEmpty())
		{
			Int n = SugarList.Length(linesRemaining);
			IIntList viable = QuadMain.Viable(QuadMain.Min(maxColumnLines, QuadMain.Max(n, n - World.MinimumLinesPerColumn())), QuadMain.Min(1, World.MinimumLinesPerColumn()) - 1);
			ITextList vars = new TextCons(variable, new TextNil());
			prob.AddVariable(variable, viable);
			prob.AddConstraint(new GreedinessConstraint(n), vars);
			prob.AddConstraint(new LastLinesConstraint(linesRemaining), vars);
			prob.AddConstraint(new FirstLinesConstraint(linesRemaining), vars);
			Int howManyLinesToTake = prob.GetSolution(variable);
			IQuadList linesToTake = SugarList.Take(linesRemaining, howManyLinesToTake);
			IQuadList linesToLeave = SugarList.Drop(linesRemaining, howManyLinesToTake);
			prob.Reset();
			IQuad newColumn = Quads.QuadsToColumn(linesToTake);
			IValList kvs = new ValCons(Vals.Sym(Sym.ColumnIdx()), new ValCons(Vals.I(colIdx), new ValNil()));
			columns = new QuadCons(Quads.Column(Utils.AttrChange(newColumn.Attrs(), kvs), newColumn.Items()), columns);
			linesRemaining = linesToLeave;
			colIdx = colIdx + 1;
		}
		return SugarList.Reverse(columns);
	}

	public static fun ColumnsToPages(IQuadList cols) : IQuadList
	{
		IQuad c0 = cols.First();
		IVal cpv = Quads.AttrRef(c0, Sym.ColumnCount(), Vals.I(World.ColumnCountKeyDefault()));
		Int columnsPerPage = cpv.I();
		if (columnsPerPage <= 0)
		{
			ERROR("assert: exact-positive-integer?");
		}
		Float columnGutter = Quads.AttrRef(c0, Sym.ColumnGutter(), Vals.F(World.ColumnGutterKeyDefault())).F();
		if (!Quads.HasAttr(c0, Sym.Measure()))
		{
			ERROR("columns->pages: column attrs contain no measure key");
		}
		Float columnWidth = Quads.AttrRefMissing(c0, Sym.Measure()).F();
		Float widthOfPrintedArea = (columnsPerPage + 0.0) * columnWidth + ((columnsPerPage - 1) + 0.0) * columnGutter;
		IQuadListList pageColsList = SugarList.SliceAt(cols, columnsPerPage);
		IQuadList result = new QuadNil();
		while (!pageColsList.IsEmpty())
		{
			IQuadList pageCols = pageColsList.First();
			pageColsList = pageColsList.Rest();
			Float currentX = (World.PaperWidthDefault() - widthOfPrintedArea) / 2.0;
			IQuadList placed = new QuadNil();
			Int idx = 0;
			while (!pageCols.IsEmpty())
			{
				IQuad col = pageCols.First();
				pageCols = pageCols.Rest();
				IValList kvs = new ValCons(Vals.Sym(Sym.X()), new ValCons(Vals.F(currentX), new ValCons(Vals.Sym(Sym.Y()), new ValCons(Vals.F(40.0), new ValCons(Vals.Sym(Sym.ColumnIdx()), new ValCons(Vals.I(idx), new ValNil()))))));
				placed = new QuadCons(Utils.QuadAttrSetStar(col, kvs), placed);
				currentX = columnGutter + (columnWidth + (currentX + 0.0));
				idx = idx + 1;
			}
			result = new QuadCons(Quads.QuadsToPage(SugarList.Reverse(placed)), result);
		}
		return SugarList.Reverse(result);
	}

	public static fun BlockQuadsToLines(IQuadList qs, IEnv env) : IQuadList
	{
		return QuadMain.BlockToLines(Quads.QuadsToBlock(qs), env);
	}
}

# ---- quick-sample.rkt ----

class QuickSample
{
	public static fun AttrsOf(IValList hl) : IAttrList
	{
		return Quads.MakeQuadattrs(hl);
	}
	public static fun Block(IValList hl, IItemList xs) : IQuad
	{
		return Quads.Block(QuickSample.AttrsOf(hl), xs);
	}
	public static fun Box(IValList hl, IItemList xs) : IQuad
	{
		return Quads.Box(QuickSample.AttrsOf(hl), xs);
	}
	public static fun Word(IValList hl, IItemList xs) : IQuad
	{
		return Quads.Word(QuickSample.AttrsOf(hl), xs);
	}
	public static fun BlockBreak(IValList hl, IItemList xs) : IQuad
	{
		return Quads.BlockBreak(QuickSample.AttrsOf(hl), xs);
	}

