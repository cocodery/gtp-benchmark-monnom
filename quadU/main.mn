# ---- render.rkt ----

# the methods of abstract-renderer% that pdf-renderer% inherits
class AbstractRenderer
{
	public static fun IsRenderable(Int name) : Bool
	{
		if (name == Sym.Word())
		{
			return true;
		}
		return name == Sym.Box();
	}

	public static fun Render(IRenderer r, IQuad docQuad) : Int
	{
		IQuadList renderingInput = Utils.FlattenQuad(r.Setup(docQuad));
		# page-quad-hash: page -> quads (consed, so in reverse order)
		ArrayList<IQuadList> byPage = new ArrayList<IQuadList>();
		IQuadList l = renderingInput;
		while (!l.IsEmpty())
		{
			IQuad q = l.First();
			l = l.Rest();
			if (AbstractRenderer.IsRenderable(q.Name()))
			{
				Int page = QuadMain.AssertIndex(Quads.AttrRefMissing(q, Sym.Page()));
				while (byPage.Length() <= page)
				{
					byPage.Add(new QuadNil());
				}
				byPage.Set(page, new QuadCons(q, byPage.Get(page)));
			}
		}
		# (map render-page (sort (hash-keys page-quad-hash) <)); pages without quads are not keys
		Int k = 0;
		while (k < byPage.Length())
		{
			if (!byPage.Get(k).IsEmpty())
			{
				r.RenderPage(byPage.Get(k));
			}
			k = k + 1;
		}
		return r.Finalize(0);
	}

	public static fun RenderElement(IRenderer r, IQuad q) : Int
	{
		if (Quads.IsWord(q))
		{
			return r.RenderWord(q);
		}
		return 0;
	}
}

# pdf-renderer%; the pdf-dc% is a recording drawing context (lib.mn)
class PdfRenderer implements IRenderer
{
	private readonly IDc dc;
	public constructor(IDc d)
	{
		dc = d;
	}
	public fun Dc() : IDc
	{
		return dc;
	}
	public fun Render(IQuad docQuad) : Int
	{
		return AbstractRenderer.Render(this, docQuad);
	}
	public fun RenderElement(IQuad q) : Int
	{
		return AbstractRenderer.RenderElement(this, q);
	}
	public fun Setup(IQuad tx) : IQuad
	{
		# (send* dc (start-doc "boing") (set-pen ...) (set-brush ...))
		dc.StartDoc(Txt.PushWord(Txt.Empty(), 27881273314));
		return tx;
	}
	public fun RenderWord(IQuad w) : Int
	{
		IText wordFont = Quads.AttrRef(w, Sym.Font(), Vals.S(World.FontNameDefault())).S();
		IVal wordSize = Quads.AttrRef(w, Sym.Size(), Vals.F(World.FontSizeDefault()));
		if (wordSize.F() < 0.0)
		{
			ERROR("assert: nonnegative-flonum?");
		}
		dc.SetFont(wordFont, wordSize);
		IText wordText = Quads.QuadCar(w).Str();
		Float x = Quads.AttrRefMissing(w, Sym.X()).F();
		Float y = Quads.AttrRefMissing(w, Sym.Y()).F() - Quads.AttrRef(w, Sym.Ascent(), Vals.I(0)).F();
		dc.MoveTo(x, y);
		return dc.DrawText(wordText);
	}
	public fun RenderPage(IQuadList elements) : Int
	{
		dc.StartPage();
		IQuadList l = elements;
		while (!l.IsEmpty())
		{
			if (!Quads.IsWhitespaceNbsp(l.First()))
			{
				this.RenderElement(l.First());
			}
			l = l.Rest();
		}
		return dc.EndPage();
	}
	public fun Finalize(Int xs) : Int
	{
		return dc.EndDoc();
	}
	public fun RenderToFile(IQuad docQuad, IText path) : Int
	{
		return this.Render(docQuad);
	}
}

# ---- main.rkt ----

class Main
{
	public static fun Main() : Void
	{
		# the module-level state (hyphenate.rkt, measure.rkt, the csp problem class)
		IEnv env = Builtins.MakeEnv();
		IProblem prob = Builtins.MakeProblem();
		IRenderer renderer = new PdfRenderer(Builtins.MakeDc());
		Timer t = new Timer();
		# (parameterize ([world:quality-default world:draft-quality]) ...): no effect (see NOTES.md)
		# the typesetting and rendering are repeated 20 times (see NOTES.md); the last renderer's
		# recording is printed
		Int i = 0;
		while (i < 20)
		{
			IQuad to = QuadMain.Typeset(QuickSample.QuickSample(), env, prob);
			renderer = new PdfRenderer(Builtins.MakeDc());
			renderer.RenderToFile(to, Txt.Empty());
			i = i + 1;
		}
		t.PrintDifference();
		"\n".Print();
		renderer.Dc().Count().ToString().Print();
		"\n".Print();
		renderer.Dc().Hash().ToString().Print();
		"\n".Print();
	}
}
