class Vecs
{
	public static fun MakeInt(Int n, Int v) : IIntVec
	{
		ArrayList<Int> e = new ArrayList<Int>();
		Int i = 0;
		while (i < n)
		{
			e.Add(v);
			i = i + 1;
		}
		return new IntVecS(e);
	}
	public static fun MakeFloat(Int n, Float v) : IFloatVec
	{
		ArrayList<Float> e = new ArrayList<Float>();
		Int i = 0;
		while (i < n)
		{
			e.Add(v);
			i = i + 1;
		}
		return new FloatVecS(e);
	}
	public static fun MakeBool(Int n, Bool v) : IBoolVec
	{
		ArrayList<Bool> e = new ArrayList<Bool>();
		Int i = 0;
		while (i < n)
		{
			e.Add(v);
			i = i + 1;
		}
		return new BoolVecS(e);
	}
	public static fun MakePenalty(Int n, IPenalty v) : IPenaltyVec
	{
		ArrayList<IPenalty> e = new ArrayList<IPenalty>();
		Int i = 0;
		while (i < n)
		{
			e.Add(v);
			i = i + 1;
		}
		return new PenaltyVecS(e);
	}
	# (list->vector qs)
	public static fun QuadsToVector(IQuadList l) : IQuadVec
	{
		ArrayList<IQuad> e = new ArrayList<IQuad>();
		while (!l.IsEmpty())
		{
			e.Add(l.First());
			l = l.Rest();
		}
		return new QuadVecS(e);
	}
	# vector-append of one element
	public static fun IntAppend1(IIntVec v, Int x) : IIntVec
	{
		ArrayList<Int> e = new ArrayList<Int>();
		Int i = 0;
		while (i < v.Length())
		{
			e.Add(v.Ref(i));
			i = i + 1;
		}
		e.Add(x);
		return new IntVecS(e);
	}
	public static fun PenaltyAppend1(IPenaltyVec v, IPenalty x) : IPenaltyVec
	{
		ArrayList<IPenalty> e = new ArrayList<IPenalty>();
		Int i = 0;
		while (i < v.Length())
		{
			e.Add(v.Ref(i));
			i = i + 1;
		}
		e.Add(x);
		return new PenaltyVecS(e);
	}
	# (vector-copy v i j)
	public static fun FloatCopy(IFloatVec v, Int i, Int j) : IFloatVec
	{
		ArrayList<Float> e = new ArrayList<Float>();
		Int k = i;
		while (k < j)
		{
			e.Add(v.Ref(k));
			k = k + 1;
		}
		return new FloatVecS(e);
	}
	public static fun BoolCopy(IBoolVec v, Int i, Int j) : IBoolVec
	{
		ArrayList<Bool> e = new ArrayList<Bool>();
		Int k = i;
		while (k < j)
		{
			e.Add(v.Ref(k));
			k = k + 1;
		}
		return new BoolVecS(e);
	}
	# (vector-drop v 1)
	public static fun IntCdr(IIntVec v) : IIntVec
	{
		ArrayList<Int> e = new ArrayList<Int>();
		Int k = 1;
		while (k < v.Length())
		{
			e.Add(v.Ref(k));
			k = k + 1;
		}
		return new IntVecS(e);
	}
	public static fun IntRange(Int from, Int to) : IIntVec
	{
		ArrayList<Int> e = new ArrayList<Int>();
		Int k = from;
		while (k < to)
		{
			e.Add(k);
			k = k + 1;
		}
		return new IntVecS(e);
	}
	public static fun IntsToVector(IIntList l) : IIntVec
	{
		ArrayList<Int> e = new ArrayList<Int>();
		while (!l.IsEmpty())
		{
			e.Add(l.First());
			l = l.Rest();
		}
		return new IntVecS(e);
	}
}

# ---- flonums ----

class Fl
{
	# exact-floor of a flonum (MonNom has no conversion from Float to Int: binary search)
	public static fun ExactFloor(Float x) : Int
	{
		if (x >= 0.0)
		{
			return Fl.FloorBetween(x, 0, 4611686018427387904);
		}
		return Fl.FloorBetween(x, 0 - 4611686018427387904, 0);
	}

	public static fun FloorBetween(Float x, Int lo, Int hi) : Int
	{
		while (hi - lo > 1)
		{
			Int mid = lo + (hi - lo) / 2;
			if (mid + 0.0 <= x)
			{
				lo = mid;
				continue;
			}
			hi = mid;
		}
		return lo;
	}

	# exact-round: to nearest, ties to even
	public static fun ExactRound(Float x) : Int
	{
		Int f = Fl.ExactFloor(x);
		Float d = x - (f + 0.0);
		if (d > 0.5)
		{
			return f + 1;
		}
		if (d < 0.5)
		{
			return f;
		}
		if (f % 2 == 0)
		{
			return f;
		}
		return f + 1;
	}

	# (round x) on a flonum (keeps the sign of a zero result)
	public static fun Round(Float x) : Float
	{
		Int r = Fl.ExactRound(x);
		if (r == 0)
		{
			if (x < 0.0)
			{
				return 0.0 * (0.0 - 1.0);
			}
		}
		return r + 0.0;
	}

	public static fun Floor(Float x) : Float
	{
		return Fl.ExactFloor(x) + 0.0;
	}

	public static fun Max(Float a, Float b) : Float
	{
		if (a > b)
		{
			return a;
		}
		return b;
	}
}

# ---- hash tables keyed by strings ----

class TextMap
{
	private readonly ArrayList<ArrayList<Int>> buckets;
	private readonly ArrayList<IText> keys;
	private readonly ArrayList<Int> values;
	public constructor()
	{
		buckets = new ArrayList<ArrayList<Int>>();
		keys = new ArrayList<IText>();
		values = new ArrayList<Int>();
	}
	public fun Init() : Int
	{
		Int i = 0;
		while (i < 4096)
		{
			buckets.Add(new ArrayList<Int>());
			i = i + 1;
		}
		return 0;
	}
	public fun HashOf(IText t) : Int
	{
		Int h = 0;
		Int i = 0;
		while (i < t.Length())
		{
			h = (h * 31 + t.CharAt(i)) % 4096;
			i = i + 1;
		}
		return h;
	}
	# -1 when absent
	public fun Get(IText t) : Int
	{
		ArrayList<Int> b = buckets.Get(this.HashOf(t));
		foreach (Int k in b)
		{
			if (Txt.Equal(keys.Get(k), t))
			{
				return values.Get(k);
			}
		}
		return 0 - 1;
	}
	public fun Put(IText t, Int v) : Int
	{
		ArrayList<Int> b = buckets.Get(this.HashOf(t));
		foreach (Int k in b)
		{
			if (Txt.Equal(keys.Get(k), t))
			{
				values.Set(k, v);
				return v;
			}
		}
		b.Add(keys.Length());
		keys.Add(t);
		values.Add(v);
		return v;
	}
	public fun Count() : Int
	{
		return keys.Length();
	}
}

# (HashTable String (Listof Index))
class PatternTable implements IPatterns
{
	private readonly TextMap map;
	private readonly ArrayList<IIntList> values;
	public constructor(TextMap m)
	{
		map = m;
		values = new ArrayList<IIntList>();
	}
	public fun Has(IText key) : Bool
	{
		return map.Get(key) >= 0;
	}
	public fun Ref(IText key) : IIntList
	{
		Int k = map.Get(key);
		if (k < 0)
		{
			ERROR("hash-ref: no value found for key");
		}
		return values.Get(k);
	}
	public fun Set(IText key, IIntList value) : Int
	{
		Int k = map.Get(key);
		if (k >= 0)
		{
			values.Set(k, value);
			return k;
		}
		map.Put(key, values.Length());
		values.Add(value);
		return 0;
	}
	public fun Count() : Int
	{
		return map.Count();
	}
}

class MeasureTableS implements IMeasureTable
{
	private readonly TextMap map;
	private readonly ArrayList<Float> widths;
	private readonly ArrayList<Float> heights;
	private readonly ArrayList<Float> descents;
	public constructor(TextMap m)
	{
		map = m;
		widths = new ArrayList<Float>();
		heights = new ArrayList<Float>();
		descents = new ArrayList<Float>();
	}
	# whd: width, height, descent
	public fun Add(IText key, IFloatVec whd) : Int
	{
		map.Put(key, widths.Length());
		widths.Add(whd.Ref(0));
		heights.Add(whd.Ref(1));
		descents.Add(whd.Ref(2));
		return 0;
	}
	public fun Lookup(IText key) : Int
	{
		return map.Get(key);
	}
	public fun Width(Int e) : Float
	{
		return widths.Get(e);
	}
	public fun Height(Int e) : Float
	{
		return heights.Get(e);
	}
	public fun Descent(Int e) : Float
	{
		return descents.Get(e);
	}
}

class Measures
{
	# the key (list text font weight style)
	public static fun Key(IText text, IText font, Int weight, Int style) : IText
	{
		IText k = Txt.Append(Txt.Append(text, Txt.Char(1114112)), font);
		k.Push(1114112);
		k.Push(weight);
		k.Push(style);
		return k;
	}

	public static fun WeightSym(Int w) : Int
	{
		if (w == 1)
		{
			return Sym.Bold();
		}
		if (w == 2)
		{
			return Sym.Light();
		}
		if (w == 3)
		{
			return Sym.Italic();
		}
		if (w == 4)
		{
			return Sym.Slant();
		}
		return Sym.Normal();
	}

	# the measurements of the reference run (measdata.mn)
	public static fun Load() : IMeasureTable
	{
		TextMap m = new TextMap();
		m.Init();
		MeasureTableS t = new MeasureTableS(m);
		ArrayList<Int> e = MeasureData.Entries();
		Int p = 0;
		while (p < e.Length())
		{
			Int n = e.Get(p);
			IText text = Txt.Empty();
			Int i = 0;
			while (i < n)
			{
				text.Push(e.Get(p + 1 + i));
				i = i + 1;
			}
			Int q = p + 1 + n;
			IText font = Txt.FromCodes(MeasureData.FontName(e.Get(q)));
			IText key = Measures.Key(text, font, Measures.WeightSym(e.Get(q + 1)), Measures.WeightSym(e.Get(q + 2)));
			IFloatVec whd = Vecs.MakeFloat(3, 0.0);
			whd.Set(0, e.Get(q + 3) + 0.0);
			whd.Set(1, e.Get(q + 4) + 0.0);
			whd.Set(2, e.Get(q + 5) + 0.0);
			t.Add(key, whd);
			p = q + 7;
		}
		return t;
	}
}

class EnvS implements IEnv
{
	private readonly IMeasureTable measures;
	private IPatterns patterns;
	private readonly IPatterns patternCache;
	private readonly IPatterns hashed;
	public constructor(IMeasureTable m, IPatterns p, IPatterns c, IPatterns h)
	{
		measures = m;
		patterns = p;
		patternCache = c;
		hashed = h;
	}
	public fun Measures() : IMeasureTable
	{
		return measures;
	}
	public fun Patterns() : IPatterns
	{
		return patterns;
	}
	public fun SetPatterns(IPatterns p) : Int
	{
		patterns = p;
		return 0;
	}
	public fun PatternCache() : IPatterns
	{
		return patternCache;
	}
	public fun HashedPatterns() : IPatterns
	{
		return hashed;
	}
}

class Builtins
{
	# the state of hyphenate.rkt and measure.rkt when they are instantiated
	public static fun MakeEnv() : IEnv
	{
		return new EnvS(Measures.Load(), Builtins.MakePatterns(), Builtins.MakePatterns(), Builtins.HashedPatterns());
	}

	public static fun MakePatterns() : IPatterns
	{
		TextMap m = new TextMap();
		m.Init();
		return new PatternTable(m);
	}

	# the hashed-patterns literal of hyphenate.rkt (hyphdata.mn)
	public static fun HashedPatterns() : IPatterns
	{
		IPatterns t = Builtins.MakePatterns();
		ArrayList<Int> words = HyphData.Words();
		ArrayList<Int> ints = new ArrayList<Int>();
		foreach (Int w in words)
		{
			Int k = 0;
			while (k < 9)
			{
				if (ints.Length() < HyphData.IntCount())
				{
					ints.Add(w % 128);
				}
				w = w / 128;
				k = k + 1;
			}
		}
		Int p = 0;
		while (p < ints.Length())
		{
			Int n = ints.Get(p);
			IText key = Txt.Empty();
			Int i = 0;
			while (i < n)
			{
				key.Push(ints.Get(p + 1 + i));
				i = i + 1;
			}
			Int q = p + 1 + n;
			Int m = ints.Get(q);
			IIntList vs = new IntNil();
			Int j = m - 1;
			while (j >= 0)
			{
				vs = new IntCons(ints.Get(q + 1 + j), vs);
				j = j - 1;
			}
			t.Set(key, vs);
			p = q + 1 + m;
		}
		return t;
	}

	public static fun MakeDc() : IDc
	{
		return new RecordingDc();
	}

	public static fun MakeProblem() : IProblem
	{
		return new Problem();
	}
}

# pdf-dc% of racket/draw, replaced by a recorder of the drawing calls: it counts the drawn
# texts and keeps a checksum of their characters, positions (x 100, rounded) and font sizes
class RecordingDc implements IDc
{
	private Int count;
	private Int hash;
	private Float x;
	private Float y;
	private Float size;
	public constructor()
	{
		count = 0;
		hash = 0;
		x = 0.0;
		y = 0.0;
		size = 0.0;
	}
	public fun StartDoc(IText name) : Int
	{
		return 0;
	}
	public fun StartPage() : Int
	{
		return 0;
	}
	public fun EndPage() : Int
	{
		return 0;
	}
	public fun EndDoc() : Int
	{
		return 0;
	}
	public fun SetFont(IText face, IVal sz) : Int
	{
		size = sz.F();
		return 0;
	}
	public fun MoveTo(Float xx, Float yy) : Int
	{
		x = xx;
		y = yy;
		return 0;
	}
	public fun DrawText(IText text) : Int
	{
		count = count + 1;
		Int h = hash;
		Int i = 0;
		while (i < text.Length())
		{
			h = (h * 31 + text.CharAt(i)) % 1000000007;
			i = i + 1;
		}
		h = Fl.ExactRound(x * 100.0) + h * 31;
		h = h % 1000000007;
		h = (h * 31 + Fl.ExactRound(y * 100.0)) % 1000000007;
		h = (h * 31 + Fl.ExactRound(size * 100.0)) % 1000000007;
		hash = h;
		return 0;
	}
	public fun Count() : Int
	{
		return count;
	}
	public fun Hash() : Int
	{
		return hash;
	}
}

# problem% of base/csp with its backtracking-solver% (forward checking), for the problems that
# lines->columns builds: one variable with unary function constraints. The solution generator
# (racket/generator) is replaced by returning the first solution.
class Problem implements IProblem
{
	private IText variable;
	private IIntList domain;
	private Bool hasVariable;
	private ArrayList<IConstraintFn> constraints;
	public constructor()
	{
		variable = Txt.Empty();
		domain = new IntNil();
		hasVariable = false;
		constraints = new ArrayList<IConstraintFn>();
	}
	public fun Reset() : Int
	{
		constraints = new ArrayList<IConstraintFn>();
		hasVariable = false;
		domain = new IntNil();
		return 0;
	}
	public fun AddVariable(IText v, IIntList values) : Int
	{
		if (hasVariable)
		{
			ERROR("add-variable: Tried to insert duplicated variable");
		}
		if (values.IsEmpty())
		{
			ERROR("add-variable: domain value is null");
		}
		variable = v;
		domain = values;
		hasVariable = true;
		return 0;
	}
	public fun AddConstraint(IConstraintFn f, ITextList variables) : Int
	{
		constraints.Add(f);
		return 0;
	}
	public fun GetSolution(IText v) : Int
	{
		# get-args: preprocess removes, for each single-variable constraint in order, the
		# values of the domain for which it is false
		IIntList d = domain;
		foreach (IConstraintFn c in constraints)
		{
			d = ProblemOps.Filter(c, d, d);
		}
		if (d.IsEmpty())
		{
			ERROR("get-solution: no solution");
		}
		# the solver assigns the first remaining value (no constraint is left to check)
		return d.First();
	}

}

class ProblemOps
{
	# (for/fold ([domain-values (domain)]) ([value (domain)] #:unless (is-true? ...)) (remove value domain-values))
	public static fun Filter(IConstraintFn c, IIntList values, IIntList acc) : IIntList
	{
		if (values.IsEmpty())
		{
			return acc;
		}
		Int value = values.First();
		if (c(value))
		{
			return ProblemOps.Filter(c, values.Rest(), acc);
		}
		return ProblemOps.Filter(c, values.Rest(), ProblemOps.Remove(value, acc));
	}
	public static fun Remove(Int x, IIntList l) : IIntList
	{
		if (l.IsEmpty())
		{
			return l;
		}
		if (l.First() == x)
		{
			return l.Rest();
		}
		return new IntCons(l.First(), ProblemOps.Remove(x, l.Rest()));
	}
}

