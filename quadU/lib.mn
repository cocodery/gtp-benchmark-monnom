# ---- s-expression values ----

class ValS implements IVal
{
	private readonly Int kind;
	private readonly Float f;
	private readonly Int i;
	private readonly IText s;
	private readonly Int sym;
	private readonly Bool b;
	private readonly IQuad q;
	private readonly IAttrList attrs;
	private readonly IItemList items;
	public constructor(Int k, Float ff, Int ii, IText ss, Int sy, Bool bb, IQuad qq, IAttrList a, IItemList it)
	{
		kind = k;
		f = ff;
		i = ii;
		s = ss;
		sym = sy;
		b = bb;
		q = qq;
		attrs = a;
		items = it;
	}
	public fun Kind() : Int
	{
		return kind;
	}
	public fun F() : Float
	{
		if (kind != 0)
		{
			ERROR("assert: flonum?");
		}
		return f;
	}
	public fun I() : Int
	{
		if (kind != 1)
		{
			ERROR("assert: exact-integer?");
		}
		return i;
	}
	public fun S() : IText
	{
		if (kind != 2)
		{
			ERROR("assert: string?");
		}
		return s;
	}
	public fun Sym() : Int
	{
		if (kind != 3)
		{
			ERROR("assert: symbol?");
		}
		return sym;
	}
	public fun B() : Bool
	{
		if (kind != 4)
		{
			ERROR("assert: boolean?");
		}
		return b;
	}
	public fun Q() : IQuad
	{
		if (kind != 5)
		{
			ERROR("assert: quad?");
		}
		return q;
	}
	public fun Attrs() : IAttrList
	{
		if (kind != 6)
		{
			ERROR("assert: quad-attrs?");
		}
		return attrs;
	}
	public fun Items() : IItemList
	{
		if (kind != 7)
		{
			ERROR("assert: QuadList?");
		}
		return items;
	}
}

class QuadS implements IQuad
{
	private readonly Int name;
	private readonly IAttrList attrs;
	private readonly IItemList items;
	public constructor(Int n, IAttrList a, IItemList it)
	{
		name = n;
		attrs = a;
		items = it;
	}
	public fun Name() : Int
	{
		return name;
	}
	public fun Attrs() : IAttrList
	{
		return attrs;
	}
	public fun Items() : IItemList
	{
		return items;
	}
}

class AttrS implements IAttr
{
	private readonly Int key;
	private readonly IVal value;
	public constructor(Int k, IVal v)
	{
		key = k;
		value = v;
	}
	public fun Key() : Int
	{
		return key;
	}
	public fun Value() : IVal
	{
		return value;
	}
}

class ItemS implements IItem
{
	private readonly Bool isString;
	private readonly IText str;
	private readonly IQuad q;
	public constructor(Bool s, IText t, IQuad qq)
	{
		isString = s;
		str = t;
		q = qq;
	}
	public fun IsString() : Bool
	{
		return isString;
	}
	public fun Str() : IText
	{
		if (!isString)
		{
			ERROR("assert: string?");
		}
		return str;
	}
	public fun Q() : IQuad
	{
		if (isString)
		{
			ERROR("assert: quad?");
		}
		return q;
	}
}

class Vals
{
	public static fun NoQuad() : IQuad
	{
		return new QuadS(Sym.Null(), new AttrNil(), new ItemNil());
	}
	public static fun Make(Int k, Float f, Int i, IText s, Int sy, Bool b, IQuad q, IAttrList a, IItemList it) : IVal
	{
		return new ValS(k, f, i, s, sy, b, q, a, it);
	}
	public static fun F(Float x) : IVal
	{
		return Vals.Make(0, x, 0, Txt.Empty(), 0, false, Vals.NoQuad(), new AttrNil(), new ItemNil());
	}
	public static fun I(Int x) : IVal
	{
		return Vals.Make(1, 0.0, x, Txt.Empty(), 0, false, Vals.NoQuad(), new AttrNil(), new ItemNil());
	}
	public static fun S(IText x) : IVal
	{
		return Vals.Make(2, 0.0, 0, x, 0, false, Vals.NoQuad(), new AttrNil(), new ItemNil());
	}
	public static fun Sym(Int x) : IVal
	{
		return Vals.Make(3, 0.0, 0, Txt.Empty(), x, false, Vals.NoQuad(), new AttrNil(), new ItemNil());
	}
	public static fun B(Bool x) : IVal
	{
		return Vals.Make(4, 0.0, 0, Txt.Empty(), 0, x, Vals.NoQuad(), new AttrNil(), new ItemNil());
	}
	public static fun Q(IQuad x) : IVal
	{
		return Vals.Make(5, 0.0, 0, Txt.Empty(), 0, false, x, new AttrNil(), new ItemNil());
	}
	public static fun Attrs(IAttrList x) : IVal
	{
		return Vals.Make(6, 0.0, 0, Txt.Empty(), 0, false, Vals.NoQuad(), x, new ItemNil());
	}
	public static fun Items(IItemList x) : IVal
	{
		return Vals.Make(7, 0.0, 0, Txt.Empty(), 0, false, Vals.NoQuad(), new AttrNil(), x);
	}
	# (gensym): attr-missing
	public static fun Missing() : IVal
	{
		return Vals.Make(8, 0.0, 0, Txt.Empty(), Sym.AttrMissing(), false, Vals.NoQuad(), new AttrNil(), new ItemNil());
	}

	public static fun IsFalse(IVal v) : Bool
	{
		if (v.Kind() == 4)
		{
			return !v.B();
		}
		return false;
	}

	# '() as a QuadAttrs or a QuadList
	public static fun IsNull(IVal v) : Bool
	{
		if (v.Kind() == 6)
		{
			return v.Attrs().IsEmpty();
		}
		if (v.Kind() == 7)
		{
			return v.Items().IsEmpty();
		}
		return false;
	}

	# equal?
	public static fun Equal(IVal a, IVal b) : Bool
	{
		if (Vals.IsNull(a))
		{
			return Vals.IsNull(b);
		}
		if (Vals.IsNull(b))
		{
			return false;
		}
		if (a.Kind() != b.Kind())
		{
			return false;
		}
		Int k = a.Kind();
		if (k == 0)
		{
			return Vals.FlEq(a.F(), b.F());
		}
		if (k == 1)
		{
			return a.I() == b.I();
		}
		if (k == 2)
		{
			return Txt.Equal(a.S(), b.S());
		}
		if (k == 3)
		{
			return a.Sym() == b.Sym();
		}
		if (k == 4)
		{
			return a.B() == b.B();
		}
		if (k == 5)
		{
			return Vals.QuadEqual(a.Q(), b.Q());
		}
		if (k == 6)
		{
			return Vals.AttrsEqual(a.Attrs(), b.Attrs());
		}
		if (k == 7)
		{
			return Vals.ItemsEqual(a.Items(), b.Items());
		}
		return true;
	}

	public static fun FlEq(Float a, Float b) : Bool
	{
		if (a == b)
		{
			return true;
		}
		return false;
	}

	public static fun QuadEqual(IQuad a, IQuad b) : Bool
	{
		if (a.Name() != b.Name())
		{
			return false;
		}
		if (!Vals.AttrsEqual(a.Attrs(), b.Attrs()))
		{
			return false;
		}
		return Vals.ItemsEqual(a.Items(), b.Items());
	}

	public static fun AttrEqual(IAttr a, IAttr b) : Bool
	{
		if (a.Key() != b.Key())
		{
			return false;
		}
		return Vals.Equal(a.Value(), b.Value());
	}

	public static fun AttrsEqual(IAttrList a, IAttrList b) : Bool
	{
		while (!a.IsEmpty())
		{
			if (b.IsEmpty())
			{
				return false;
			}
			if (!Vals.AttrEqual(a.First(), b.First()))
			{
				return false;
			}
			a = a.Rest();
			b = b.Rest();
		}
		return b.IsEmpty();
	}

	public static fun ItemEqual(IItem a, IItem b) : Bool
	{
		if (a.IsString() != b.IsString())
		{
			return false;
		}
		if (a.IsString())
		{
			return Txt.Equal(a.Str(), b.Str());
		}
		return Vals.QuadEqual(a.Q(), b.Q());
	}

	public static fun ItemsEqual(IItemList a, IItemList b) : Bool
	{
		while (!a.IsEmpty())
		{
			if (b.IsEmpty())
			{
				return false;
			}
			if (!Vals.ItemEqual(a.First(), b.First()))
			{
				return false;
			}
			a = a.Rest();
			b = b.Rest();
		}
		return b.IsEmpty();
	}

	public static fun MakeQuad(Int n, IAttrList a, IItemList it) : IQuad
	{
		return new QuadS(n, a, it);
	}

	public static fun Attr(Int k, IVal v) : IAttr
	{
		return new AttrS(k, v);
	}

	public static fun StrItem(IText t) : IItem
	{
		return new ItemS(true, t, Vals.NoQuad());
	}

	public static fun QuadItem(IQuad q) : IItem
	{
		return new ItemS(false, Txt.Empty(), q);
	}
}

# ---- vectors ----

class IntVecS implements IIntVec
{
	private readonly ArrayList<Int> e;
	public constructor(ArrayList<Int> x)
	{
		e = x;
	}
	public fun Length() : Int
	{
		return e.Length();
	}
	public fun Ref(Int i) : Int
	{
		return e.Get(i);
	}
	public fun Set(Int i, Int v) : Int
	{
		e.Set(i, v);
		return v;
	}
}

