# Stand-ins for the Racket builtins and base libraries: strings, symbols, the s-expression values
# of quads (lists, pairs, flonums, ...), vectors, flonum rounding, string-keyed hash tables,
# base/csp (the backtracking solver, for the single-variable problems of lines->columns),
# racket/draw (the text measurements, embedded in measdata.mn, and a recording drawing context
# instead of pdf-dc%), lists.

class Text implements IText
{
	private readonly ArrayList<Int> chars;
	public constructor(ArrayList<Int> cs)
	{
		chars = cs;
	}
	public fun Length() : Int
	{
		return chars.Length();
	}
	public fun CharAt(Int i) : Int
	{
		return chars.Get(i);
	}
	public fun Push(Int c) : IText
	{
		chars.Add(c);
		return this;
	}
}

class Txt
{
	public static fun Empty() : IText
	{
		return new Text(new ArrayList<Int>());
	}

	# up to 9 characters packed as base-128 codes, first character in the lowest digit
	public static fun PushWord(IText t, Int packed) : IText
	{
		while (packed > 0)
		{
			t.Push(packed % 128);
			packed = packed / 128;
		}
		return t;
	}

	# up to 3 code points packed base 2^21, first in the lowest digit
	public static fun PushWide(IText t, Int packed) : IText
	{
		while (packed > 0)
		{
			t.Push(packed % 2097152);
			packed = packed / 2097152;
		}
		return t;
	}

	public static fun Char(Int c) : IText
	{
		return Txt.Empty().Push(c);
	}

	public static fun FromCodes(ArrayList<Int> cs) : IText
	{
		IText t = Txt.Empty();
		foreach (Int c in cs)
		{
			t.Push(c);
		}
		return t;
	}

	public static fun Append(IText a, IText b) : IText
	{
		IText t = Txt.Empty();
		Int i = 0;
		while (i < a.Length())
		{
			t.Push(a.CharAt(i));
			i = i + 1;
		}
		Int j = 0;
		while (j < b.Length())
		{
			t.Push(b.CharAt(j));
			j = j + 1;
		}
		return t;
	}

	public static fun Substring(IText a, Int start, Int end) : IText
	{
		IText t = Txt.Empty();
		Int i = start;
		while (i < end)
		{
			t.Push(a.CharAt(i));
			i = i + 1;
		}
		return t;
	}

	public static fun Equal(IText a, IText b) : Bool
	{
		if (a.Length() != b.Length())
		{
			return false;
		}
		Int i = 0;
		while (i < a.Length())
		{
			if (a.CharAt(i) != b.CharAt(i))
			{
				return false;
			}
			i = i + 1;
		}
		return true;
	}

	public static fun Member(IText s, ITextList l) : Bool
	{
		while (!l.IsEmpty())
		{
			if (Txt.Equal(s, l.First()))
			{
				return true;
			}
			l = l.Rest();
		}
		return false;
	}

	# char-downcase (Basic Latin and Latin-1)
	public static fun CharDowncase(Int c) : Int
	{
		if (c >= 65)
		{
			if (c <= 90)
			{
				return c + 32;
			}
		}
		if (c >= 192)
		{
			if (c <= 222)
			{
				if (c != 215)
				{
					return c + 32;
				}
			}
		}
		return c;
	}

	public static fun Downcase(IText a) : IText
	{
		IText t = Txt.Empty();
		Int i = 0;
		while (i < a.Length())
		{
			t.Push(Txt.CharDowncase(a.CharAt(i)));
			i = i + 1;
		}
		return t;
	}

	# \w of Racket regexps: [a-zA-Z0-9_]
	public static fun IsWordChar(Int c) : Bool
	{
		if (c >= 97)
		{
			return c <= 122;
		}
		if (c >= 65)
		{
			if (c <= 90)
			{
				return true;
			}
			return c == 95;
		}
		if (c >= 48)
		{
			return c <= 57;
		}
		return false;
	}

	# \p{Zs}: the Unicode space separators
	public static fun IsZs(Int c) : Bool
	{
		if (c == 32)
		{
			return true;
		}
		if (c == 160)
		{
			return true;
		}
		if (c == 5760)
		{
			return true;
		}
		if (c >= 8192)
		{
			if (c <= 8202)
			{
				return true;
			}
		}
		if (c == 8239)
		{
			return true;
		}
		if (c == 8287)
		{
			return true;
		}
		return c == 12288;
	}

	# (regexp-match #px"\\p{Zs}" x)
	public static fun HasZs(IText x) : Bool
	{
		Int i = 0;
		while (i < x.Length())
		{
			if (Txt.IsZs(x.CharAt(i)))
			{
				return true;
			}
			i = i + 1;
		}
		return false;
	}

	public static fun HasChar(IText x, Int c) : Bool
	{
		Int i = 0;
		while (i < x.Length())
		{
			if (x.CharAt(i) == c)
			{
				return true;
			}
			i = i + 1;
		}
		return false;
	}

	# string-join
	public static fun Join(ITextList l, IText sep) : IText
	{
		IText t = Txt.Empty();
		Bool first = true;
		while (!l.IsEmpty())
		{
			if (first)
			{
				t = Txt.Append(t, l.First());
				first = false;
				l = l.Rest();
				continue;
			}
			t = Txt.Append(Txt.Append(t, sep), l.First());
			l = l.Rest();
		}
		return t;
	}
}

