# automata-adapted.rkt and population-adapted.rkt: the Automaton and Population class types,
# plus the types of the Racket builtins the program uses (lists, vectors, random).
#   State = Natural, Payoff = Nonnegative-Real (only ever an exact integer here) -> Int

# Transition = (Vectorof State)
interface ITransition
{
	fun Length() : Int;
	fun Ref(Int i) : Int;
}

# Transition* = (Vectorof (Vectorof State))
interface ITransitions
{
	fun Length() : Int;
	fun Ref(Int i) : ITransition;
}

# (Instance Automaton): init-fields current, payoff, table, original (read with get-field and
# written with set-field!) and the public methods
interface IAutomaton
{
	fun Current() : Int;
	fun SetCurrent(Int c) : Int;
	fun Payoff() : Int;
	fun SetPayoff(Int p) : Int;
	fun Table() : ITransitions;
	fun Original() : Int;
	# the sum of pay-offs for the two respective automata over all rounds
	fun MatchPair(IAutomaton other, Int r) : IAutomatonPair;
	# this has no business being public
	fun Jump(Int input, Int delta) : Int;
	fun Pay() : Int;
	# reset the historic payoff
	fun Reset() : IAutomaton;
	# reset payoff and current state to original strategy
	fun Clone() : IAutomaton;
	fun Equal(IAutomaton other) : Bool;
}

# (values oAutomaton oAutomaton)
interface IAutomatonPair
{
	fun Fst() : IAutomaton;
	fun Snd() : IAutomaton;
}

# (Instance Population)
interface IPopulation
{
	fun Payoffs() : IIntList;
	# (match-ups p r) matches up neighboring pairs of automata in population p for r rounds
	fun MatchUpStar(Int roundsPerMatch) : Int;
	# (death-birth p r) replaces r elements of p with r "children" of randomly chosen fittest
	# elements of p, also shuffle; q < 0.0 stands for #:random #f
	fun DeathBirth(Int rate, Float q) : Int;
}

# (Listof Natural) / (Listof Payoff)
interface IIntList
{
	fun IsEmpty() : Bool;
	fun First() : Int;
	fun Rest() : IIntList;
}

# (Listof Real)
interface IFloatList
{
	fun IsEmpty() : Bool;
	fun First() : Float;
	fun Rest() : IFloatList;
}

# (List Integer Real), an element of simulation->lines
interface IPoint
{
	fun N() : Int;
	fun D() : Float;
}

# (Listof (List Integer Real))
interface IPointList
{
	fun IsEmpty() : Bool;
	fun First() : IPoint;
	fun Rest() : IPointList;
}

# the pseudo-random generator behind racket's `random`
interface IRng
{
	fun Seed(Int k) : Int;
	fun NextInt(Int n) : Int;
	fun NextFloat() : Float;
}
