	{
		return Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.Empty(), 8280867402081122921), 7913532419496194802), 2363179339215599600), 2364828571220326388), 9097754479105159422), 7128016261388013665), 243167479);
	}
	public static fun Disabled() : IText
	{
		return Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.Empty(), 8305173409618753123), 8063839679884898548), 7116759771232432416), 430948551832300);
	}
