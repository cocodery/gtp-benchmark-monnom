# (file->lines (format "../base/~a.dat" color)) for the color index (0 blue, 1 orange, 2 green, 3 red)
class DatFiles
{
	public static fun Lines(Int i) : ArrayList<ArrayList<Int>>
	{
		if (i == 0)
		{
			return BlueDat.Lines();
		}
		if (i == 1)
		{
			return OrangeDat.Lines();
		}
		if (i == 2)
		{
			return GreenDat.Lines();
		}
		return RedDat.Lines();
	}
}
