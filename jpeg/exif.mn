		st.SetInterpreter(syms.Intern(Txt.PushWord(Txt.PushWord(Txt.Empty(), 3299955105498676325), 213465069)), new VIExposureMode());
		st.SetInterpreter(syms.Intern(Txt.PushWord(Txt.PushWord(Txt.Empty(), 7837258883681383543), 213448545)), new VIWhiteBalance());
		st.SetInterpreter(syms.Intern(Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.Empty(), 7045520386057613811), 8139079223548410480), 101)), new VIScreenCaptureType());
		st.SetInterpreter(syms.Intern(Txt.PushWord(Txt.PushWord(Txt.Empty(), 8421097000364830951), 1783794)), new VIGainControl());
		st.SetInterpreter(syms.Intern(Txt.PushWord(Txt.Empty(), 65811333686999011)), new VIContrast());
		st.SetInterpreter(syms.Intern(Txt.PushWord(Txt.PushWord(Txt.Empty(), 8058016220458070259), 110)), new VISaturation());
		st.SetInterpreter(syms.Intern(Txt.PushWord(Txt.Empty(), 8351810571579454579)), new VISharpness());
		st.SetInterpreter(syms.Intern(Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.Empty(), 7231605754042039027), 8240346102272702953), 213514081)), new VISubjectDistanceRange());
		st.AddParser(new TPByte());
		st.AddParser(new TPUnreachable());
		st.AddParser(new TPShort());
		st.AddParser(new TPLong());
		st.AddParser(new TPRational());
		st.AddParser(new TPSByte());
		st.AddParser(new TPUnreachable());
		st.AddParser(new TPSShort());
		st.AddParser(new TPSLong());
		st.AddParser(new TPRational());
		st.AddParser(new TPFloat());
		st.AddParser(new TPDouble());
		return st;
	}

	public static fun FlashReturn(Int v) : IInterp
	{
		if (v == 0)
		{
			return Interps.Str(Txt.PushWord(Txt.PushWord(Txt.Empty(), 7841760592273422286), 213594465));
		}
		if (v == 1)
		{
			return Interps.Str(Txt.PushWord(Txt.Empty(), 487903953876821));
		}
		if (v == 2)
		{
			return Interps.Str(Txt.PushWord(Txt.PushWord(Txt.Empty(), 7191073425691850702), 1651444));
		}
		if (v == 3)
		{
			return Interps.Str(Txt.PushWord(Txt.Empty(), 56743210558239428));
		}
		return Interps.VoidValue();
	}

	public static fun FlashMode(Int v) : IInterp
	{
		if (v == 0)
		{
			return Interps.Str(Txt.PushWord(Txt.Empty(), 487903953876821));
		}
		if (v == 1)
		{
			return Interps.Str(Txt.PushWord(Txt.PushWord(Txt.Empty(), 8277562682997700547), 58471268914663545));
		}
		if (v == 2)
		{
			return Interps.Str(Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.Empty(), 8280940382718228419), 8343986515562254457), 232518899));
		}
		if (v == 3)
		{
			return Interps.Str(Txt.PushWord(Txt.Empty(), 234699457));
		}
		return Interps.VoidValue();
	}

	public static fun TypeWidth(IExifState st, Int type) : Int
	{
		if (type < st.TypeWidthCount())
		{
			return st.TypeWidth(type);
		}
		return 0 - 1;
	}

	public static fun AssertNat(IInterp v) : Int
	{
		if (v.Kind() != 0)
		{
			ERROR("assert: natural?");
		}
		return v.Nat();
	}

	public static fun ReadValue(IBytes bv, Int pos, Int order, Int type, Int count, IExifState st) : IInterp
	{
		if (type == 2)
		{
			# ASCII
			if (count > 0)
			{
				IBytes res = Bytevectors.MakeBytevector(count - 1);
				Bytevectors.BytevectorCopyBang(bv, pos, res, 0, count - 1);
				return Interps.Str(Bytevectors.Utf8ToString(res));
			}
			return Interps.Str(Txt.Empty());
		}
		if (type == 7)
		{
			# UNDEFINED
			IBytes res2 = Bytevectors.MakeBytevector(count);
			Bytevectors.BytevectorCopyBang(bv, pos, res2, 0, count);
			return Interps.Bs(res2);
		}
		if (type >= st.TypeParserCount())
		{
			return Interps.Boolean(false);
		}
		if (!st.HasTypeParser(type))
		{
			return Interps.Boolean(false);
		}
		ITypeParser parser = st.TypeParser(type);
		if (count == 1)
		{
			return parser(new ParseArgs(bv, pos, order));
		}
		IVec res3 = Builtins.MakeVector(count, 0);
		Int width = BitPorts.AssertNatural(Exif.TypeWidth(st, type));
		Int n = 0;
		Int p = pos;
		while (n < count)
		{
			res3.Set(n, Exif.AssertNat(parser(new ParseArgs(bv, p, order))));
			n = n + 1;
			p = p + width;
		}
		return Interps.Vec(res3);
	}

	public static fun InterpretValue(Bool isSymbol, Int name, IInterp value, IExifState st) : IInterp
	{
		if (isSymbol)
		{
			if (st.HasInterpreter(name))
			{
				IValueInterpreter interpret = st.Interpreter(name);
				return interpret(Exif.AssertNat(value));
			}
		}
		return value;
	}

	public static fun InlineValue(Int type, Int count, IExifState st) : Bool
	{
		Int byteWidth = Exif.TypeWidth(st, type);
		if (byteWidth < 0)
		{
			return false;
		}
		return byteWidth * count <= 4;
	}

	public static fun ParseTags(IBytes bv, Int pos0, Int order, Int maxDepth, Int tagCount, Int n, IExifState st) : IPTList
	{
		if (n >= tagCount)
		{
			return new PTNil();
		}
		Int pos = pos0 + 2 + n * 12;
		Int tag = Bytevectors.U16Ref(bv, pos, order);
		Int sym = st.TagName(tag);
		Int type = Bytevectors.U16Ref(bv, pos + 2, order);
		Int count = Bytevectors.U32Ref(bv, pos + 4, order);
		Int offset = Exif.Offset(bv, pos, order, type, count, st);
		IInterp value = Exif.ReadValue(bv, offset, order, type, count, st);
		if (tag == 34665)
		{
			# Nested EXIF information.
			if (value.Kind() == 0)
			{
				if (maxDepth > 0)
				{
					IPTsList nested = Exif.ParseIfdChain(bv, value.Nat(), order, maxDepth - 1, st);
					if (nested.IsEmpty())
					{
						ERROR("match: no matching clause");
					}
					if (!nested.Rest().IsEmpty())
					{
						ERROR("match: no matching clause");
					}
					return Builtins.AppendPTs(nested.First(), Exif.ParseTags(bv, pos0, order, maxDepth, tagCount, n + 1, st));
				}
			}
		}
		IInterp valueStar = Exif.InterpretValue(Exif.IsSym(sym), Exif.NameOf(sym, tag), value, st);
		return new PTCons(new PTS(Exif.IsSym(sym), Exif.NameOf(sym, tag), valueStar), Exif.ParseTags(bv, pos0, order, maxDepth, tagCount, n + 1, st));
	}

	public static fun IsSym(Int sym) : Bool
	{
		if (sym >= 0)
		{
			return true;
		}
		return false;
	}

	# (or (hash-ref *exif-tag-names* tag #f) tag)
	public static fun NameOf(Int sym, Int tag) : Int
	{
		if (sym >= 0)
		{
			return sym;
		}
		return tag;
	}

	public static fun Offset(IBytes bv, Int pos, Int order, Int type, Int count, IExifState st) : Int
	{
		if (Exif.InlineValue(type, count, st))
		{
			return pos + 8;
		}
		return Bytevectors.U32Ref(bv, pos + 8, order);
	}

	public static fun ParseIfdChain(IBytes bv, Int pos, Int order, Int maxDepth, IExifState st) : IPTsList
	{
		Int tagCount = Bytevectors.U16Ref(bv, pos, order);
		Int nextPosOffset = pos + 2 + tagCount * 12;
		Int nextPos = Bytevectors.U32Ref(bv, nextPosOffset, order);
		IPTList tags = Exif.ParseTags(bv, pos, order, maxDepth, tagCount, 0, st);
		if (nextPos == 0)
		{
			return new PTsCons(tags, new PTsNil());
		}
		if (maxDepth <= 0)
		{
			return new PTsCons(tags, new PTsNil());
		}
		return new PTsCons(tags, Exif.ParseIfdChain(bv, nextPos, order, maxDepth - 1, st));
	}

	public static fun ParseByteOrder(Int b0, Int b1) : Int
	{
		if (b0 != b1)
		{
			ERROR("Bad TIFF header prefix");
		}
		if (b0 == 73)
		{
			return 0;
		}
		if (b0 == 77)
		{
			return 1;
		}
		ERROR("Bad TIFF header byte order");
	}

	public static fun ParseExif(IBytes bv, IExifState st) : IPTsList
	{
		Int order = Exif.ParseByteOrder(Bytevectors.U8Ref(bv, 0), Bytevectors.U8Ref(bv, 1));
		if (Bytevectors.U16Ref(bv, 2, order) != 42)
		{
			ERROR("Bad TIFF header magic value");
		}
		Int ifd0 = Bytevectors.U32Ref(bv, 4, order);
		# Root IFD -> embedded EXIF -> one more
		return Exif.ParseIfdChain(bv, ifd0, order, 3, st);
	}
}
