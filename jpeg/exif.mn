# exif.rkt: parsing of the EXIF data of an APP1 segment
# The module-level tables (*exif-tag-names*, *value-interpreters*, *type-widths*, *type-parsers*)
# are an ExifState made by main before the timed region (module instantiation in the original);
# symbols are interned Ints; the value interpreters and type parsers are closure classes.

class ParseArgs implements IParseArgs
{
	private readonly IBytes bv;
	private readonly Int pos;
	private readonly Int order;
	public constructor(IBytes b, Int p, Int o)
	{
		bv = b;
		pos = p;
		order = o;
	}
	public fun Bv() : IBytes
	{
		return bv;
	}
	public fun Pos() : Int
	{
		return pos;
	}
	public fun Order() : Int
	{
		return order;
	}
}

class TPByte implements ITypeParser
{
	public constructor()
	{
	}
	public fun this(IParseArgs a) : IInterp
	{
		return Interps.Nat(Bytevectors.U8Ref(a.Bv(), a.Pos()));
	}
}

class TPUnreachable implements ITypeParser
{
	public constructor()
	{
	}
	public fun this(IParseArgs a) : IInterp
	{
		ERROR("unreachable");
	}
}

class TPShort implements ITypeParser
{
	public constructor()
	{
	}
	public fun this(IParseArgs a) : IInterp
	{
		return Interps.Nat(Bytevectors.U16Ref(a.Bv(), a.Pos(), a.Order()));
	}
}

