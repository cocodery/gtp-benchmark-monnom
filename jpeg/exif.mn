	}
	public fun this(Int value) : IInterp
	{
		if (value == 1)
		{
			return Interps.Str(Txt.PushWord(Txt.Empty(), 30037045453));
		}
		if (value == 2)
		{
			return Interps.Str(Txt.PushWord(Txt.Empty(), 27354986051));
		}
		if (value == 3)
		{
			return Interps.Str(Txt.PushWord(Txt.Empty(), 513979249915076));
		}
		return Interps.Nat(value);
	}
}

class VIFlash implements IValueInterpreter
{
	private readonly ISymbols syms;
	public constructor(ISymbols s)
	{
		syms = s;
	}
	public fun this(Int value) : IInterp
	{
		Bool fired = Bits.BitSet(value, 0);
		Int ret = 3 & Bits.Shift(value, 0 - 1);
		Int mode = 3 & Bits.Shift(value, 0 - 3);
		Bool present = Bits.BitSet(value, 5);
		Bool redEye = Bits.BitSet(value, 6);
		IPTList l = new PTCons(new PTS(true, syms.Intern(Txt.PushWord(Txt.Empty(), 35914234499511026)), Interps.Boolean(redEye)), new PTNil());
		l = new PTCons(new PTS(true, syms.Intern(Txt.PushWord(Txt.Empty(), 35979827386874224)), Interps.Boolean(present)), l);
		l = new PTCons(new PTS(true, syms.Intern(Txt.PushWord(Txt.Empty(), 213465069)), Exif.FlashMode(mode)), l);
		l = new PTCons(new PTS(true, syms.Intern(Txt.PushWord(Txt.PushWord(Txt.Empty(), 7627047691465077490), 1913959)), Exif.FlashReturn(ret)), l);
		l = new PTCons(new PTS(true, syms.Intern(Txt.PushWord(Txt.Empty(), 2191720756454)), Interps.Boolean(fired)), l);
		return Interps.Alist(l);
	}
}

# exif.rkt's module-level tables
class ExifStateS implements IExifState
{
	private readonly ArrayList<Int> tagKeys;
	private readonly ArrayList<Int> tagSyms;
	private readonly ArrayList<Int> viSyms;
	private readonly ArrayList<IValueInterpreter> vis;
	private readonly ArrayList<ITypeParser> parsers;
	public constructor()
	{
		tagKeys = new ArrayList<Int>();
		tagSyms = new ArrayList<Int>();
		viSyms = new ArrayList<Int>();
		vis = new ArrayList<IValueInterpreter>();
		parsers = new ArrayList<ITypeParser>();
	}
	# hash-set! on *exif-tag-names*
	public fun SetTagName(Int tag, Int sym) : Int
	{
		tagKeys.Add(tag);
		tagSyms.Add(sym);
		return 0;
	}
	# hash-set! on *value-interpreters*
	public fun SetInterpreter(Int sym, IValueInterpreter vi) : Int
	{
		viSyms.Add(sym);
		vis.Add(vi);
		return 0;
	}
	public fun AddParser(ITypeParser p) : Int
	{
		parsers.Add(p);
		return 0;
	}
	# -1 for #f
	public fun TagName(Int tag) : Int
	{
		Int i = 0;
		while (i < tagKeys.Length())
		{
			if (tagKeys.Get(i) == tag)
			{
				return tagSyms.Get(i);
			}
			i = i + 1;
		}
		return 0 - 1;
	}
	public fun HasInterpreter(Int sym) : Bool
	{
		Int i = 0;
		while (i < viSyms.Length())
		{
			if (viSyms.Get(i) == sym)
			{
				return true;
			}
			i = i + 1;
		}
		return false;
	}
	public fun Interpreter(Int sym) : IValueInterpreter
	{
		Int i = 0;
		while (i < viSyms.Length())
		{
			if (viSyms.Get(i) == sym)
			{
				return vis.Get(i);
			}
			i = i + 1;
		}
		ERROR("hash-ref: no value found for key");
	}
	# *type-widths*: #(#f 1 1 2 4 8 1 1 2 4 8 4 8)
	public fun TypeWidthCount() : Int
	{
		return 13;
	}
	public fun TypeWidth(Int type) : Int
	{
		if (type == 0)
		{
			return 0 - 1;
		}
		if (type == 1)
		{
			return 1;
		}
		if (type == 2)
		{
			return 1;
		}
		if (type == 3)
		{
			return 2;
		}
		if (type == 4)
		{
			return 4;
		}
		if (type == 5)
		{
			return 8;
		}
		if (type == 6)
		{
			return 1;
		}
		if (type == 7)
		{
			return 1;
		}
		if (type == 8)
		{
			return 2;
		}
		if (type == 9)
		{
			return 4;
		}
		if (type == 10)
		{
			return 8;
		}
		if (type == 11)
		{
			return 4;
		}
		if (type == 12)
		{
			return 8;
		}
		ERROR("vector-ref: index is out of range");
	}
	public fun TypeParserCount() : Int
	{
		return 13;
	}
	public fun HasTypeParser(Int type) : Bool
	{
		return type != 0;
	}
	public fun TypeParser(Int type) : ITypeParser
	{
		return parsers.Get(type - 1);
	}
}

