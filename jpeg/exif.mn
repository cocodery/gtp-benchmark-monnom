class VIOrientation implements IValueInterpreter
{
	public constructor()
	{
	}
	public fun this(Int value) : IInterp
	{
		if (value == 1)
		{
			return Interps.Str(Txt.PushWord(Txt.Empty(), 3737120454606));
		}
		if (value == 2)
		{
			return Interps.Str(Txt.PushWord(Txt.Empty(), 56743145087218893));
		}
		if (value == 3)
		{
			return Interps.Str(Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.Empty(), 3549279812696487890), 7335179886803818552), 115));
		}
		if (value == 4)
		{
			return Interps.Str(Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.Empty(), 3549279812696487890), 7335179886803818552), 7627553463296921715), 3463326726514));
		}
		if (value == 5)
		{
			return Interps.Str(Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.Empty(), 4125740564999911378), 8343929407227367472), 8346260130307453344), 7627553463296921701), 3463326726514));
		}
		if (value == 6)
		{
			return Interps.Str(Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.Empty(), 4125740564999911378), 8343929407227367472), 8346260130307453344), 101));
		}
		if (value == 7)
		{
			return Interps.Str(Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.Empty(), 4125740564999911378), 8343929407227367472), 3307216244599157152), 7343022155098748515), 8274155981755791904), 27057240050));
		}
		if (value == 8)
		{
			return Interps.Str(Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.PushWord(Txt.Empty(), 4125740564999911378), 8343929407227367472), 3307216244599157152), 7343022155098748515));
		}
		return Interps.VoidValue();
	}
}

