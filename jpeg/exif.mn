class TPRational implements ITypeParser
{
	public constructor()
	{
	}
	public fun this(IParseArgs a) : IInterp
	{
		return Interps.Pair(Bytevectors.U32Ref(a.Bv(), a.Pos(), a.Order()), Bytevectors.U32Ref(a.Bv(), a.Pos() + 4, a.Order()));
	}
}

