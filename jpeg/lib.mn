}

class Arrays
{
	public static fun ShapeSize(IVec ds) : Int
	{
		Int n = 1;
		Int i = 0;
		while (i < ds.Length())
		{
			n = n * ds.Ref(i);
			i = i + 1;
		}
		return n;
	}

	# the next index vector in row-major order
	public static fun NextIndexes(IVec ds, IVec js) : Int
	{
		Int k = ds.Length();
		while (k != 0)
		{
			k = k - 1;
			Int jk = js.Ref(k) + 1;
			if (jk >= ds.Ref(k))
			{
				js.Set(k, 0);
				continue;
			}
			js.Set(k, jk);
			break;
		}
		return 0;
	}

	public static fun BuildBlockArray(IVec ds, IBlockProc proc) : IBlockArray
	{
		Int n = Arrays.ShapeSize(ds);
		ArrayList<IVec> e = new ArrayList<IVec>();
		IVec js = Builtins.MakeVector(ds.Length(), 0);
		Int k = 0;
		while (k < n)
		{
			e.Add(proc(Builtins.VectorCopy(js)));
			Arrays.NextIndexes(ds, js);
			k = k + 1;
		}
		return new BlockArrayS(Builtins.VectorCopy(ds), e);
	}

	public static fun BuildMcuArray(IVec ds, IMcuProc proc) : IMcuArray
	{
		Int n = Arrays.ShapeSize(ds);
		ArrayList<IMcu> e = new ArrayList<IMcu>();
		IVec js = Builtins.MakeVector(ds.Length(), 0);
		Int k = 0;
		while (k < n)
		{
			e.Add(proc(Builtins.VectorCopy(js)));
			Arrays.NextIndexes(ds, js);
			k = k + 1;
		}
		return new McuArrayS(Builtins.VectorCopy(ds), e);
	}

	# a vector of n block arrays (for/vector), filled with Set
	public static fun MakeMcu(Int n) : IMcu
	{
		ArrayList<IBlockArray> e = new ArrayList<IBlockArray>();
		IBlockArray empty = new BlockArrayS(Builtins.MakeVector(0, 0), new ArrayList<IVec>());
		Int i = 0;
		while (i < n)
		{
			e.Add(empty);
			i = i + 1;
		}
		return new McuS(e);
	}

	public static fun MakeCodesMcu(Int n) : ICodesMcu
	{
		ArrayList<IIntListList> e = new ArrayList<IIntListList>();
		Int i = 0;
		while (i < n)
		{
			e.Add(new IntListNil());
			i = i + 1;
		}
		return new CodesMcuS(e);
	}

	# the result array of for/array #:shp ds, filled with SetFlat
	public static fun MakeCodesArray(IVec ds) : ICodesArray
	{
		Int n = Arrays.ShapeSize(ds);
		ArrayList<ICodesMcu> e = new ArrayList<ICodesMcu>();
		ICodesMcu empty = Arrays.MakeCodesMcu(0);
		Int i = 0;
		while (i < n)
		{
			e.Add(empty);
			i = i + 1;
		}
		return new CodesArrayS(Builtins.VectorCopy(ds), e);
	}
}

# ---- strings and symbols ----

class Text implements IText
{
	private readonly ArrayList<Int> chars;
	public constructor(ArrayList<Int> cs)
	{
		chars = cs;
	}
	public fun Length() : Int
	{
		return chars.Length();
	}
	public fun CharAt(Int i) : Int
	{
		return chars.Get(i);
	}
	public fun Push(Int c) : IText
	{
		chars.Add(c);
		return this;
	}
}

class Txt
{
	public static fun Empty() : IText
	{
		return new Text(new ArrayList<Int>());
	}

	# up to 9 characters packed as base-128 codes, first character in the lowest digit
	public static fun PushWord(IText t, Int packed) : IText
	{
		while (packed > 0)
		{
			t.Push(packed % 128);
			packed = packed / 128;
		}
		return t;
	}

	public static fun Equal(IText a, IText b) : Bool
	{
		if (a.Length() != b.Length())
		{
			return false;
		}
		Int i = 0;
		while (i < a.Length())
		{
			if (a.CharAt(i) != b.CharAt(i))
			{
				return false;
			}
			i = i + 1;
		}
		return true;
	}
}

class SymbolTable implements ISymbols
{
	private readonly ArrayList<IText> names;
	public constructor()
	{
		names = new ArrayList<IText>();
	}
	public fun Intern(IText name) : Int
	{
		Int i = 0;
		while (i < names.Length())
		{
			if (Txt.Equal(names.Get(i), name))
			{
				return i;
			}
			i = i + 1;
		}
		names.Add(name);
		return names.Length() - 1;
	}
}

# ---- Interp values and exif entries ----

class InterpS implements IInterp
{
	private readonly Int kind;
	private readonly Int nat;
	private readonly IText str;
	private readonly IBytes bs;
	private readonly Int cdr;
	private readonly Bool boolv;
	private readonly IVec vec;
	private readonly IPTList alist;
	public constructor(Int k, Int n, IText s, IBytes b, Int d, Bool bo, IVec v, IPTList a)
	{
		kind = k;
		nat = n;
		str = s;
		bs = b;
		cdr = d;
		boolv = bo;
		vec = v;
		alist = a;
	}
	public fun Kind() : Int
	{
		return kind;
	}
	public fun Nat() : Int
	{
		return nat;
	}
	public fun Str() : IText
	{
		return str;
	}
	public fun Bs() : IBytes
	{
		return bs;
	}
	# the car of a pair is stored in nat
	public fun Car() : Int
	{
		return nat;
	}
	public fun Cdr() : Int
	{
		return cdr;
	}
	public fun BoolValue() : Bool
	{
		return boolv;
	}
	public fun Vec() : IVec
	{
		return vec;
	}
	public fun Alist() : IPTList
	{
		return alist;
	}
}

class Interps
{
	public static fun Make(Int k, Int n, IText s, IBytes b, Int d, Bool bo, IVec v, IPTList a) : IInterp
	{
		return new InterpS(k, n, s, b, d, bo, v, a);
	}
	public static fun Nat(Int n) : IInterp
	{
		return Interps.Make(0, n, Txt.Empty(), Builtins.MakeBytes(0, 0), 0, false, Builtins.MakeVector(0, 0), new PTNil());
	}
	public static fun Str(IText s) : IInterp
	{
		return Interps.Make(1, 0, s, Builtins.MakeBytes(0, 0), 0, false, Builtins.MakeVector(0, 0), new PTNil());
	}
	public static fun Bs(IBytes b) : IInterp
	{
		return Interps.Make(2, 0, Txt.Empty(), b, 0, false, Builtins.MakeVector(0, 0), new PTNil());
	}
	public static fun Pair(Int a, Int d) : IInterp
	{
		return Interps.Make(3, a, Txt.Empty(), Builtins.MakeBytes(0, 0), d, false, Builtins.MakeVector(0, 0), new PTNil());
	}
	public static fun VoidValue() : IInterp
	{
		return Interps.Make(4, 0, Txt.Empty(), Builtins.MakeBytes(0, 0), 0, false, Builtins.MakeVector(0, 0), new PTNil());
	}
	public static fun Boolean(Bool b) : IInterp
	{
		return Interps.Make(5, 0, Txt.Empty(), Builtins.MakeBytes(0, 0), 0, b, Builtins.MakeVector(0, 0), new PTNil());
	}
	public static fun Vec(IVec v) : IInterp
	{
		return Interps.Make(6, 0, Txt.Empty(), Builtins.MakeBytes(0, 0), 0, false, v, new PTNil());
	}
	public static fun Alist(IPTList a) : IInterp
	{
		return Interps.Make(7, 0, Txt.Empty(), Builtins.MakeBytes(0, 0), 0, false, Builtins.MakeVector(0, 0), a);
	}
}

