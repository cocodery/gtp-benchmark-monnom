class CodesArrayS implements ICodesArray
{
	private readonly IVec shp;
	private readonly ArrayList<ICodesMcu> elems;
	public constructor(IVec s, ArrayList<ICodesMcu> e)
	{
		shp = s;
		elems = e;
	}
	public fun Shape() : IVec
	{
		return shp;
	}
