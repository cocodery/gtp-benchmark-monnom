# Stand-ins for the Racket builtins and base libraries the benchmark uses: bytes, vectors, byte
# ports, the vectors of typedefs.rkt (Bit-Port, Huffman, QT*, H*), math/array (strict arrays
# built in row-major order), rnrs/bytevectors-6, strings, symbols, bitwise operations (MonNom has
# no bitwise operators at run time: they are computed arithmetically), lists.

class ByteStr implements IBytes
{
	private readonly ArrayList<Int> elems;
	public constructor(ArrayList<Int> e)
	{
		elems = e;
	}
	public fun Length() : Int
	{
		return elems.Length();
	}
	public fun Ref(Int i) : Int
	{
		return elems.Get(i);
	}
	public fun Set(Int i, Int v) : Int
	{
		elems.Set(i, v);
		return v;
	}
}

class IntVec implements IVec
{
	private readonly ArrayList<Int> elems;
	public constructor(ArrayList<Int> e)
	{
		elems = e;
	}
	public fun Length() : Int
	{
		return elems.Length();
	}
	public fun Ref(Int i) : Int
	{
		return elems.Get(i);
	}
	public fun Set(Int i, Int v) : Int
	{
		elems.Set(i, v);
		return v;
	}
}

# (open-input-bytes bs)
class BytesInputPort implements IPort
{
	private readonly IBytes data;
	private Int pos;
	public constructor(IBytes d)
	{
		data = d;
		pos = 0;
	}
	public fun IsInput() : Bool
	{
		return true;
	}
	# -1 is eof
	public fun ReadByte() : Int
	{
		if (pos >= data.Length())
		{
			return 0 - 1;
		}
		Int b = data.Ref(pos);
		pos = pos + 1;
		return b;
	}
	# fewer than n bytes at the end of the input (none: eof)
	public fun ReadBytes(Int n) : IBytes
	{
		ArrayList<Int> e = new ArrayList<Int>();
		Int k = 0;
		while (k < n)
		{
			if (pos >= data.Length())
			{
				break;
			}
			e.Add(data.Ref(pos));
			pos = pos + 1;
			k = k + 1;
		}
		return new ByteStr(e);
	}
	public fun Position() : Int
	{
		return pos;
	}
	public fun SetPosition(Int p) : Int
	{
		pos = p;
		return p;
	}
	public fun WriteByte(Int b) : Int
	{
		ERROR("write-byte: contract violation, expected output-port?");
	}
	public fun WriteBytes(IBytes bs) : Int
	{
		ERROR("write-bytes: contract violation, expected output-port?");
	}
	public fun Contents() : IBytes
	{
		ERROR("get-output-bytes: contract violation, expected output-port?");
	}
}

# (open-output-bytes)
class BytesOutputPort implements IPort
{
	private readonly ArrayList<Int> outBuf;
	public constructor()
	{
		outBuf = new ArrayList<Int>();
	}
	public fun IsInput() : Bool
	{
		return false;
	}
	public fun ReadByte() : Int
	{
		ERROR("read-byte: contract violation, expected input-port?");
	}
	public fun ReadBytes(Int n) : IBytes
	{
		ERROR("read-bytes: contract violation, expected input-port?");
	}
	public fun Position() : Int
	{
		return outBuf.Length();
	}
	public fun SetPosition(Int p) : Int
	{
		ERROR("file-position: not supported");
	}
	public fun WriteByte(Int b) : Int
	{
		if (b < 0)
		{
			ERROR("write-byte: contract violation, expected byte?");
		}
		if (b > 255)
		{
			ERROR("write-byte: contract violation, expected byte?");
		}
		outBuf.Add(b);
		return b;
	}
	public fun WriteBytes(IBytes bs) : Int
	{
		Int i = 0;
		while (i < bs.Length())
		{
			outBuf.Add(bs.Ref(i));
			i = i + 1;
		}
		return bs.Length();
	}
	# get-output-bytes
	public fun Contents() : IBytes
	{
		ArrayList<Int> e = new ArrayList<Int>();
		foreach (Int b in outBuf)
		{
			e.Add(b);
		}
		return new ByteStr(e);
	}
}

