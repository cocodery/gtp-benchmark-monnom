}

# Huffman = (Vector size-counts size-offsets values value-indexes sizes codes max-codes)
class HuffmanV implements IHuffman
{
	private readonly IBytes sizeCounts;
	private readonly IVec sizeOffsets;
	private readonly IBytes values;
	private readonly IVec valueIndexes;
	private readonly IBytes sizes;
	private readonly IVec codes;
	private readonly IVec maxCodes;
	public constructor(IBytes sc, IVec so, IBytes v, IVec vi, IBytes s, IVec c, IVec mc)
	{
		sizeCounts = sc;
		sizeOffsets = so;
		values = v;
		valueIndexes = vi;
		sizes = s;
		codes = c;
		maxCodes = mc;
	}
	public fun SizeCounts() : IBytes
	{
		return sizeCounts;
	}
	public fun SizeOffsets() : IVec
	{
		return sizeOffsets;
	}
	public fun Values() : IBytes
	{
		return values;
	}
	public fun ValueIndexes() : IVec
	{
		return valueIndexes;
	}
	public fun Sizes() : IBytes
	{
		return sizes;
	}
	public fun Codes() : IVec
	{
		return codes;
	}
	public fun MaxCodes() : IVec
	{
		return maxCodes;
	}
}

# QT* = (Vectorof (U #f Q-Table))
class QTablesV implements IQTables
{
	private readonly ArrayList<IVec> tables;
	private readonly ArrayList<Bool> present;
	public constructor(ArrayList<IVec> t, ArrayList<Bool> p)
	{
		tables = t;
		present = p;
	}
	public fun Length() : Int
	{
		return tables.Length();
	}
	public fun Has(Int i) : Bool
	{
		return present.Get(i);
	}
	public fun Ref(Int i) : IVec
	{
		if (present.Get(i))
		{
			return tables.Get(i);
		}
		ERROR("assert: #f");
	}
	public fun Set(Int i, IVec t) : Int
	{
		tables.Set(i, t);
		present.Set(i, true);
		return i;
	}
}

# H* = (Vectorof (U #f Huffman))
class HTablesV implements IHTables
{
	private readonly ArrayList<IHuffman> tables;
	private readonly ArrayList<Bool> present;
	public constructor(ArrayList<IHuffman> t, ArrayList<Bool> p)
	{
		tables = t;
		present = p;
	}
	public fun Length() : Int
	{
		return tables.Length();
	}
	public fun Has(Int i) : Bool
	{
		return present.Get(i);
	}
	public fun Ref(Int i) : IHuffman
	{
		if (present.Get(i))
		{
			return tables.Get(i);
		}
		ERROR("assert: #f");
	}
	public fun Set(Int i, IHuffman t) : Int
	{
		tables.Set(i, t);
		present.Set(i, true);
		return i;
	}
}

