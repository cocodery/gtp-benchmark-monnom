# ---- bitwise operations on exact integers (two's complement, arbitrary sign) ----

class Bits
{
	public static fun FloorDiv(Int a, Int b) : Int
	{
		Int q = a / b;
		if (q * b > a)
		{
			return q - 1;
		}
		return q;
	}

	# (modulo a b) for b > 0
	public static fun Mod(Int a, Int b) : Int
	{
		Int r = a % b;
		if (r < 0)
		{
			return r + b;
		}
		return r;
	}

	# (arithmetic-shift x n): MonNom has no shift operators
	public static fun Shift(Int x, Int n) : Int
	{
		if (n >= 0)
		{
			return x * 2 ** n;
		}
		return Bits.FloorDiv(x, 2 ** (0 - n));
	}

	# (bitwise-bit-set? x i)
	public static fun BitSet(Int x, Int i) : Bool
	{
		return (Bits.Shift(x, 0 - i) & 1) == 1;
	}
}

# ---- rnrs/bytevectors-6 ----

class Bytevectors
{
	public static fun U8Ref(IBytes bv, Int pos) : Int
	{
		return bv.Ref(pos);
	}

	public static fun U16Ref(IBytes bv, Int pos, Int order) : Int
	{
		if (order == 1)
		{
			return bv.Ref(pos) * 256 + bv.Ref(pos + 1);
		}
		return bv.Ref(pos + 1) * 256 + bv.Ref(pos);
	}

	public static fun U32Ref(IBytes bv, Int pos, Int order) : Int
	{
		if (order == 1)
		{
			return Bytevectors.U16Ref(bv, pos, order) * 65536 + Bytevectors.U16Ref(bv, pos + 2, order);
		}
		return Bytevectors.U16Ref(bv, pos + 2, order) * 65536 + Bytevectors.U16Ref(bv, pos, order);
	}

	public static fun Signed(Int u, Int bits) : Int
	{
		if (u >= 2 ** (bits - 1))
		{
			return u - 2 ** bits;
		}
		return u;
	}

	# require/typed gives these a Natural result: a negative value is a contract violation
	public static fun CheckNatural(Int v) : Int
	{
		if (v < 0)
		{
			ERROR("contract violation: expected Natural");
		}
		return v;
	}

	public static fun S8Ref(IBytes bv, Int pos) : Int
	{
		return Bytevectors.CheckNatural(Bytevectors.Signed(bv.Ref(pos), 8));
	}

	public static fun S16Ref(IBytes bv, Int pos, Int order) : Int
	{
		return Bytevectors.CheckNatural(Bytevectors.Signed(Bytevectors.U16Ref(bv, pos, order), 16));
	}

	public static fun S32Ref(IBytes bv, Int pos, Int order) : Int
	{
		return Bytevectors.CheckNatural(Bytevectors.Signed(Bytevectors.U32Ref(bv, pos, order), 32));
	}

	# a flonum, which violates the Natural result type given by require/typed
	public static fun IeeeSingleRef(IBytes bv, Int pos, Int order) : Int
	{
		ERROR("bytevector-ieee-single-ref: contract violation: expected Natural");
	}

	public static fun IeeeDoubleRef(IBytes bv, Int pos, Int order) : Int
	{
		ERROR("bytevector-ieee-double-ref: contract violation: expected Natural");
	}

	public static fun MakeBytevector(Int n) : IBytes
	{
		return Builtins.MakeBytes(n, 0);
	}

	public static fun BytevectorCopyBang(IBytes src, Int sstart, IBytes dst, Int dstart, Int n) : Int
	{
		Int i = 0;
		while (i < n)
		{
			dst.Set(dstart + i, src.Ref(sstart + i));
			i = i + 1;
		}
		return 0;
	}

	# utf8->string
	public static fun Utf8ToString(IBytes bv) : IText
	{
		IText t = Txt.Empty();
		Int i = 0;
		while (i < bv.Length())
		{
			Int b = bv.Ref(i);
			if (b < 128)
			{
				t.Push(b);
				i = i + 1;
				continue;
			}
			Int n = Bytevectors.Utf8Extra(b);
			if (i + n >= bv.Length())
			{
				t.Push(65533);
				i = i + 1;
				continue;
			}
			Int c = Bits.Mod(b, 2 ** (6 - n));
			Int k = 1;
			while (k <= n)
			{
				c = c * 64 + Bits.Mod(bv.Ref(i + k), 64);
				k = k + 1;
			}
			t.Push(c);
			i = i + n + 1;
		}
		return t;
	}

	public static fun Utf8Extra(Int b) : Int
	{
		if (b >= 240)
		{
			return 3;
		}
		if (b >= 224)
		{
			return 2;
		}
		return 1;
	}
}

class Builtins
{
	public static fun MakeBytes(Int n, Int v) : IBytes
	{
		ArrayList<Int> e = new ArrayList<Int>();
		Int i = 0;
		while (i < n)
		{
			e.Add(v);
			i = i + 1;
		}
		return new ByteStr(e);
	}

	public static fun FromCodes(ArrayList<Int> codes) : IBytes
	{
		ArrayList<Int> e = new ArrayList<Int>();
		foreach (Int c in codes)
		{
			e.Add(c);
		}
		return new ByteStr(e);
	}

	public static fun Subbytes(IBytes b, Int start, Int end) : IBytes
	{
		IBytes r = Builtins.MakeBytes(end - start, 0);
		Int i = start;
		while (i < end)
		{
			r.Set(i - start, b.Ref(i));
			i = i + 1;
		}
		return r;
	}

	public static fun MakeVector(Int n, Int v) : IVec
	{
		ArrayList<Int> e = new ArrayList<Int>();
		Int i = 0;
		while (i < n)
		{
			e.Add(v);
			i = i + 1;
		}
		return new IntVec(e);
	}

	public static fun VectorCopy(IVec v) : IVec
	{
		IVec r = Builtins.MakeVector(v.Length(), 0);
		Int i = 0;
		while (i < v.Length())
		{
			r.Set(i, v.Ref(i));
			i = i + 1;
		}
		return r;
	}

	# (make-vector n #f) of Q-Tables / Huffman tables
	public static fun MakeQTables(Int n) : IQTables
	{
		ArrayList<IVec> t = new ArrayList<IVec>();
		ArrayList<Bool> p = new ArrayList<Bool>();
		IVec none = Builtins.MakeVector(0, 0);
		Int i = 0;
		while (i < n)
		{
			t.Add(none);
			p.Add(false);
			i = i + 1;
		}
		return new QTablesV(t, p);
	}

	public static fun CopyQTables(IQTables q) : IQTables
	{
		IQTables r = Builtins.MakeQTables(q.Length());
		Int i = 0;
		while (i < q.Length())
		{
			if (q.Has(i))
			{
				r.Set(i, q.Ref(i));
			}
			i = i + 1;
		}
		return r;
	}

	public static fun MakeHTables(Int n) : IHTables
	{
		ArrayList<IHuffman> t = new ArrayList<IHuffman>();
		ArrayList<Bool> p = new ArrayList<Bool>();
		IHuffman none = Builtins.FakeHuffman();
		Int i = 0;
		while (i < n)
		{
			t.Add(none);
			p.Add(false);
			i = i + 1;
		}
		return new HTablesV(t, p);
	}

	public static fun CopyHTables(IHTables h) : IHTables
	{
		IHTables r = Builtins.MakeHTables(h.Length());
		Int i = 0;
		while (i < h.Length())
		{
			if (h.Has(i))
			{
				r.Set(i, h.Ref(i));
			}
			i = i + 1;
		}
		return r;
	}

	# (vector #"" '#() #"" '#() #"" '#() '#())
	public static fun FakeHuffman() : IHuffman
	{
		IBytes eb = Builtins.MakeBytes(0, 0);
		IVec ev = Builtins.MakeVector(0, 0);
		return new HuffmanV(eb, ev, eb, ev, eb, ev, ev);
	}

	public static fun MakeHuffman(IBytes sc, IVec so, IBytes v, IVec vi, IBytes s, IVec c, IVec mc) : IHuffman
	{
		return new HuffmanV(sc, so, v, vi, s, c, mc);
	}

	public static fun MakeBitPort(IPort port) : IBitPort
	{
		return new BitPortV(0, 0, port);
	}

	public static fun MakeFreqs(IQTables dc, IQTables ac) : IFreqs
	{
		return new FreqsV(dc, ac);
	}

	public static fun MakeHuffmanTables(IHTables dc, IHTables ac) : IHuffmanTables
	{
		return new HuffmanTablesV(dc, ac);
	}

	public static fun OpenInputBytes(IBytes b) : IPort
	{
		return new BytesInputPort(b);
	}

	public static fun OpenOutputBytes() : IPort
	{
		return new BytesOutputPort();
	}

	public static fun Abs(Int x) : Int
	{
		if (x < 0)
		{
			return 0 - x;
		}
		return x;
	}

	public static fun Gcd(Int a0, Int b0) : Int
	{
		Int a = Builtins.Abs(a0);
		Int b = Builtins.Abs(b0);
		while (b != 0)
		{
			Int t = a % b;
			a = b;
			b = t;
		}
		return a;
	}

	public static fun Max(Int a, Int b) : Int
	{
		if (a > b)
		{
			return a;
		}
		return b;
	}

	# (exact-ceiling (/ a b)) for b > 0
	public static fun CeilingDiv(Int a, Int b) : Int
	{
		return 0 - Bits.FloorDiv(0 - a, b);
	}

	public static fun ReverseInts(IIntList l) : IIntList
	{
		IIntList r = new IntNil();
		while (!l.IsEmpty())
		{
			r = new IntCons(l.First(), r);
			l = l.Rest();
		}
		return r;
	}

	public static fun ReverseIntLists(IIntListList l) : IIntListList
	{
		IIntListList r = new IntListNil();
		while (!l.IsEmpty())
		{
			r = new IntListCons(l.First(), r);
			l = l.Rest();
		}
		return r;
	}

	public static fun ReverseMiscs(IMiscList l) : IMiscList
	{
		IMiscList r = new MiscNil();
		while (!l.IsEmpty())
		{
			r = new MiscCons(l.First(), r);
			l = l.Rest();
		}
		return r;
	}

	public static fun AppendMiscs(IMiscList a, IMiscList b) : IMiscList
	{
		if (a.IsEmpty())
		{
			return b;
		}
		return new MiscCons(a.First(), Builtins.AppendMiscs(a.Rest(), b));
	}

	public static fun AppendPTs(IPTList a, IPTList b) : IPTList
	{
		if (a.IsEmpty())
		{
			return b;
		}
		return new PTCons(a.First(), Builtins.AppendPTs(a.Rest(), b));
	}

	public static fun PTsLength(IPTList l) : Int
	{
		Int n = 0;
		while (!l.IsEmpty())
		{
			n = n + 1;
			l = l.Rest();
		}
		return n;
	}
}

class IntNil implements IIntList
{
	public constructor()
	{
	}
	public fun IsEmpty() : Bool
	{
		return true;
	}
	public fun First() : Int
	{
		ERROR("car: empty list");
	}
	public fun Rest() : IIntList
	{
		ERROR("cdr: empty list");
	}
}

class IntCons implements IIntList
{
	private readonly Int first;
	private readonly IIntList rest;
	public constructor(Int f, IIntList r)
	{
		first = f;
		rest = r;
	}
	public fun IsEmpty() : Bool
	{
		return false;
	}
	public fun First() : Int
	{
		return first;
	}
	public fun Rest() : IIntList
	{
		return rest;
	}
}

