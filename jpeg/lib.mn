# (vector dc-tables ac-tables)
class HuffmanTablesV implements IHuffmanTables
{
	private readonly IHTables dc;
	private readonly IHTables ac;
	public constructor(IHTables d, IHTables a)
	{
		dc = d;
		ac = a;
	}
	public fun Length() : Int
	{
		return 2;
	}
	public fun Ref(Int i) : IHTables
	{
		if (i == 0)
		{
			return dc;
		}
		if (i == 1)
		{
			return ac;
		}
		ERROR("vector-ref: index is outBuf of range");
	}
}

