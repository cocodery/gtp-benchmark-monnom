# a subtrie with a single entry (split into a node when a second id arrives)
class MonoTrieLeaf implements IMonoTrie
{
	private readonly Int key;
	private readonly IMonoEntry entry;
	private readonly Int div;
	public constructor(Int k, IMonoEntry e, Int d)
	{
		key = k;
		entry = e;
		div = d;
