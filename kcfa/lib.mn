		{
			return entry;
		}
		return dflt;
	}
	public fun Put(Int id, IMonoEntry e) : IMonoTrie
	{
		if (id == key)
		{
			return Tries.NewMonoLeaf(id, e, div);
		}
		IMonoTrie empty = Tries.NewMonoEmpty(div * 16);
		ArrayList<IMonoTrie> kids = new ArrayList<IMonoTrie>();
		Int i = 0;
		while (i < 16)
		{
			kids.Add(empty);
			i = i + 1;
