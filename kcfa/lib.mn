# a subtrie with a single entry (split into a node when a second id arrives)
class StoreTrieLeaf implements IStoreTrie
{
	private readonly Int key;
	private readonly IStoreEntry entry;
	private readonly Int div;
	public constructor(Int k, IStoreEntry e, Int d)
	{
		key = k;
		entry = e;
		div = d;
	}
	public fun Get(Int id, IStoreEntry dflt) : IStoreEntry
	{
		if (id == key)
		{
			return entry;
		}
		return dflt;
	}
	public fun Put(Int id, IStoreEntry e) : IStoreTrie
	{
		if (id == key)
		{
			return Tries.NewStoreLeaf(id, e, div);
		}
		IStoreTrie empty = Tries.NewStoreEmpty(div * 16);
		ArrayList<IStoreTrie> kids = new ArrayList<IStoreTrie>();
		Int i = 0;
		while (i < 16)
		{
			kids.Add(empty);
			i = i + 1;
		}
		IStoreTrie node = Tries.NewStoreNode(kids, div);
		return node.Put(key, entry).Put(id, e);
	}
	public fun Collect(IStoreEntryList acc) : IStoreEntryList
	{
		return Tries.ConsStore(entry, acc);
	}
}

