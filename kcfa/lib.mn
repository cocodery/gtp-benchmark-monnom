}

class ClosureNil implements IClosureList
{
	public constructor()
	{
	}
	public fun IsEmpty() : Bool
	{
		return true;
	}
	public fun First() : IClosure
	{
		ERROR("car: empty list");
	}
	public fun Rest() : IClosureList
	{
		ERROR("cdr: empty list");
	}
}

class ClosureCons implements IClosureList
{
	private readonly IClosure first;
	private readonly IClosureList rest;
	public constructor(IClosure f, IClosureList r)
	{
		first = f;
		rest = r;
	}
	public fun IsEmpty() : Bool
	{
		return false;
	}
	public fun First() : IClosure
	{
