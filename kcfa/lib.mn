		IMonoTrie node = Tries.NewMonoNode(kids, div);
		return node.Put(key, entry).Put(id, e);
	}
	public fun Collect(IMonoEntryList acc) : IMonoEntryList
	{
		return Tries.ConsMono(entry, acc);
	}
}

class MonoTrieNode implements IMonoTrie
