# Stand-ins for the Racket builtins used by kcfa: symbols (interning and gensym), eq?-based
# immutable hash tables (a persistent 16-way trie over eq-hash codes), immutable sets of
# opaque structs (compared with eq?, so a list without duplicates), cons lists.

class Sym implements ISymbol
{
	private readonly Int id;
	public constructor(Int i)
	{
		id = i;
	}
	public fun Id() : Int
	{
		return id;
	}
}

class Counter implements IIdGen
{
	private Int n;
	public constructor(Int start)
	{
		n = start;
	}
	public fun Next() : Int
	{
		n = n + 1;
		return n;
	}
}

class SymTable implements ISymTable
{
	private readonly ArrayList<ISymbol> vars;
	private readonly IIdGen ids;
	public constructor(IIdGen g)
	{
		vars = new ArrayList<ISymbol>();
		ids = g;
	}
	# the symbol with (generator-assigned) name number n
	public fun Var(Int n) : ISymbol
	{
		while (vars.Length() <= n)
		{
			vars.Add(new Sym(ids.Next()));
		}
		return vars.Get(n);
	}
	public fun Gensym() : ISymbol
	{
		return new Sym(ids.Next());
	}
}

# ---------------------------------------------------------------- persistent trie
# an empty subtrie at the level that consumes the base-16 digit `div` of the id
class BEnvTrieEmpty implements IBEnvTrie
{
	private readonly Int div;
	public constructor(Int d)
	{
		div = d;
	}
	public fun Get(Int id, IBEnvEntry dflt) : IBEnvEntry
	{
		return dflt;
	}
	public fun Put(Int id, IBEnvEntry e) : IBEnvTrie
	{
		return new BEnvTrieLeaf(id, e, div);
	}
	public fun Collect(IBEnvEntryList acc) : IBEnvEntryList
	{
		return acc;
	}
}

# a subtrie with a single entry (split into a node when a second id arrives)
class BEnvTrieLeaf implements IBEnvTrie
{
	private readonly Int key;
	private readonly IBEnvEntry entry;
	private readonly Int div;
	public constructor(Int k, IBEnvEntry e, Int d)
	{
		key = k;
		entry = e;
		div = d;
	}
	public fun Get(Int id, IBEnvEntry dflt) : IBEnvEntry
	{
		if (id == key)
		{
			return entry;
		}
		return dflt;
	}
	public fun Put(Int id, IBEnvEntry e) : IBEnvTrie
	{
		if (id == key)
		{
			return Tries.NewBEnvLeaf(id, e, div);
		}
		IBEnvTrie empty = Tries.NewBEnvEmpty(div * 16);
		ArrayList<IBEnvTrie> kids = new ArrayList<IBEnvTrie>();
		Int i = 0;
		while (i < 16)
		{
			kids.Add(empty);
			i = i + 1;
		}
		IBEnvTrie node = Tries.NewBEnvNode(kids, div);
		return node.Put(key, entry).Put(id, e);
	}
	public fun Collect(IBEnvEntryList acc) : IBEnvEntryList
	{
		return Tries.ConsBEnv(entry, acc);
	}
}

class BEnvTrieNode implements IBEnvTrie
{
	private readonly ArrayList<IBEnvTrie> kids;
	private readonly Int div;
	public constructor(ArrayList<IBEnvTrie> k, Int d)
	{
		kids = k;
		div = d;
	}
	public fun Get(Int id, IBEnvEntry dflt) : IBEnvEntry
	{
		return kids.Get((id / div) % 16).Get(id, dflt);
	}
	public fun Put(Int id, IBEnvEntry e) : IBEnvTrie
	{
		Int slot = (id / div) % 16;
		ArrayList<IBEnvTrie> copy = new ArrayList<IBEnvTrie>();
		Int i = 0;
		while (i < 16)
		{
			copy.Add(kids.Get(i));
			i = i + 1;
		}
		copy.Set(slot, kids.Get(slot).Put(id, e));
		return Tries.NewBEnvNode(copy, div);
	}
	public fun Collect(IBEnvEntryList acc) : IBEnvEntryList
	{
		foreach (IBEnvTrie k in kids)
		{
			acc = k.Collect(acc);
		}
		return acc;
	}
}

