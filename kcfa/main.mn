# main.rkt: build the example programs and run the abstract interpretation N times.
# format-mono-store is not ported: it only formats strings and main does not call it.

class Main
{
	public static fun MakeRef(ISymTable st, ISymbol v) : IExp
	{
		return new Ref(st.Gensym(), v);
	}

	public static fun MakeLambda(ISymTable st, ISymList formals, IExp call) : IExp
	{
		return new Lam(st.Gensym(), formals, call);
	}

	public static fun MakeCall(ISymTable st, IExp fun0, IExpList args) : IExp
	{
		return new Call(st.Gensym(), fun0, args);
	}

	public static fun MakeLet(ISymTable st, ISymbol v, IExp exp, IExp call) : IExp
	{
		return Main.MakeCall(st, Main.MakeLambda(st, new SymCons(v, new SymNil()), call), new ExpCons(exp, new ExpNil()));
	}

	public static fun Main() : Void
	{
		IIdGen ids = new Counter(0);
		ISymTable st = new SymTable(ids);
		# module-level definitions
		IExp midTest = Main.MidTest(st);
		IExp standardExample = Main.StandardExample(st);
		Int n = 2;
		IMonoStore ms = Ui.EmptyMonoStore();
		Timer t = new Timer();
		Int a = 0;
		while (a < n)
		{
			ms = Ui.Analyze(midTest, ids);
			a = a + 1;
		}
		t.PrintDifference();
		"\n".Print();
		ms.Count().ToString().Print();
		"\n".Print();
		Int total = 0;
		IMonoEntryList es = ms.Entries();
		while (!es.IsEmpty())
		{
			total = total + es.First().Value().Count();
			es = es.Rest();
		}
		total.ToString().Print();
		"\n".Print();
	}

