	}
	# '(char run word)
	public static fun IsMergeableQuadType(Int name) : Bool
	{
		if (name == Sym.Char())
		{
			return true;
		}
		if (name == Sym.Run())
		{
			return true;
		}
		return name == Sym.Word();
	}
	# '(nb "" bb "-")
	public static fun DefaultWordBreakList() : IValList
	{
		return new ValCons(Vals.Sym(Sym.Nb()), new ValCons(Vals.S(Txt.Empty()), new ValCons(Vals.Sym(Sym.Bb()), new ValCons(Vals.S(Txt.Char(45)), new ValNil()))));
	}
