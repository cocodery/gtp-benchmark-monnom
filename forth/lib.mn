class Pop implements IPop
{
	private readonly Int value;
	private readonly IStack stack;
	public constructor(Int v, IStack s)
	{
		value = v;
		stack = s;
	}
	public fun Value() : Int
	{
		return value;
	}
	public fun Stack() : IStack
	{
		return stack;
	}
}

# 'EXIT
class ResExit implements IResult
{
	public constructor()
	{
	}
	public fun IsExit() : Bool
	{
		return true;
	}
	public fun IsFalse() : Bool
	{
		return false;
	}
	public fun Env() : IEnv
	{
		ERROR("car: not a pair");
	}
	public fun State() : IStack
	{
		ERROR("cdr: not a pair");
	}
}

# #f
class ResFalse implements IResult
{
	public constructor()
	{
	}
	public fun IsExit() : Bool
	{
		return false;
	}
	public fun IsFalse() : Bool
	{
		return true;
	}
	public fun Env() : IEnv
	{
		ERROR("car: not a pair");
	}
	public fun State() : IStack
	{
		ERROR("cdr: not a pair");
	}
}

# (cons E S)
class ResPair implements IResult
{
	private readonly IEnv env;
	private readonly IStack state;
	public constructor(IEnv e, IStack s)
	{
		env = e;
		state = s;
	}
	public fun IsExit() : Bool
	{
		return false;
	}
	public fun IsFalse() : Bool
	{
		return false;
	}
	public fun Env() : IEnv
	{
		return env;
	}
	public fun State() : IStack
	{
		return state;
	}
}

# (values e s) with e : (Option Env)
class EvalResult implements IEvalResult
{
	private readonly Bool hasEnv;
	private readonly IEnv env;
	private readonly IStack stack;
	public constructor(Bool h, IEnv e, IStack s)
	{
		hasEnv = h;
		env = e;
		stack = s;
	}
	public fun HasEnv() : Bool
	{
		return hasEnv;
	}
	public fun Env() : IEnv
	{
		return env;
	}
	public fun Stack() : IStack
	{
		return stack;
	}
}

# the three arguments of an exec call
class ExecArgs implements IExecArgs
{
	private readonly IEnv env;
	private readonly IStack state;
	private readonly IValList tokens;
	public constructor(IEnv e, IStack s, IValList v)
	{
		env = e;
		state = s;
		tokens = v;
	}
	public fun Env() : IEnv
	{
		return env;
	}
	public fun State() : IStack
	{
		return state;
	}
	public fun Tokens() : IValList
	{
		return tokens;
	}
}
