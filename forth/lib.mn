	# display a string
	public static fun Print(IText t) : Int
	{
		Int i = 0;
		Int n = t.Length();
		while (i < n)
		{
			Txt.CharString(t.CharAt(i)).Print();
			i = i + 1;
		}
		return n;
	}
	public static fun Append(IText acc, IText t) : IText
	{
		Int i = 0;
		Int n = t.Length();
		while (i < n)
		{
			acc.Push(t.CharAt(i));
			i = i + 1;
		}
		return acc;
	}
	# decimal digits of an integer, appended to acc
	public static fun AppendInt(IText acc, Int n) : IText
	{
		if (n < 0)
		{
			acc.Push(45);
			return Txt.AppendNat(acc, 0 - n);
		}
		return Txt.AppendNat(acc, n);
	}
	public static fun AppendNat(IText acc, Int n) : IText
	{
		if (n >= 10)
		{
			Txt.AppendNat(acc, n / 10);
		}
		acc.Push(48 + n % 10);
		return acc;
	}
	# (format "~a" lst) for a list of reader values
	public static fun FormatVals(IValList l) : IText
	{
		IText s = Txt.Empty();
		s.Push(40);
		Bool first = true;
		while (!l.IsEmpty())
		{
			if (!first)
			{
				s.Push(32);
			}
			first = false;
			l.First().Show(s);
			l = l.Rest();
		}
		s.Push(41);
		return s;
	}
	# (format "~a" stack)
	public static fun FormatStack(IStack l) : IText
	{
		IText s = Txt.Empty();
		s.Push(40);
		Bool first = true;
		while (!l.IsEmpty())
		{
			if (!first)
			{
				s.Push(32);
			}
			first = false;
			Txt.AppendInt(s, l.First());
			l = l.Rest();
		}
		s.Push(41);
		return s;
	}
	public static fun EmptyBuckets(Int n) : ArrayList<ArrayList<ISymbol>>
	{
		ArrayList<ArrayList<ISymbol>> b = new ArrayList<ArrayList<ISymbol>>();
		Int i = 0;
		while (i < n)
		{
			b.Add(new ArrayList<ISymbol>());
			i = i + 1;
		}
		return b;
	}
	# (list v ...) helpers
	public static fun List1(IVal a) : IValList
	{
		return new ValCons(a, new ValNil());
	}
	# (memq v lst) as a boolean
	public static fun Memq(IVal v, IValList l) : Bool
	{
		while (!l.IsEmpty())
		{
			if (Txt.Eq(v, l.First()))
			{
				return true;
			}
			l = l.Rest();
		}
		return false;
	}
	# eq? on reader values: interned symbols are compared by identity, fixnums by value
	public static fun Eq(IVal a, IVal b) : Bool
	{
		if (a.IsSymbol())
		{
			if (b.IsSymbol())
			{
				return a.Sym() == b.Sym();
			}
			return false;
		}
		if (b.IsInteger())
		{
			return a.Num() == b.Num();
		}
		return false;
	}
}

class Text implements IText
{
	private readonly ArrayList<Int> chars;
	public constructor(ArrayList<Int> cs)
	{
		chars = cs;
	}
	public fun Length() : Int
	{
		return chars.Length();
	}
	public fun CharAt(Int i) : Int
	{
		return chars.Get(i);
	}
	public fun Push(Int c) : IText
	{
		chars.Add(c);
		return this;
	}
}

class Symbol implements ISymbol
{
	private readonly IText chars;
	public constructor(IText cs)
	{
		chars = cs;
	}
	public fun Chars() : IText
	{
		return chars;
	}
}

class SymTable implements ISymTable
{
	private readonly ArrayList<ArrayList<ISymbol>> buckets;
	public constructor()
	{
		buckets = Txt.EmptyBuckets(1024);
	}
	public fun Intern(IText chars) : ISymbol
	{
		ArrayList<ISymbol> bucket = buckets.Get(Txt.Hash(chars) % 1024);
		foreach (ISymbol s in bucket)
		{
			if (Txt.Equal(s.Chars(), chars))
			{
				return s;
			}
		}
		ISymbol sym = new Symbol(chars);
		bucket.Add(sym);
		return sym;
	}
}

class SymVal implements IVal
{
	private readonly ISymbol sym;
	public constructor(ISymbol s)
	{
		sym = s;
	}
	public fun IsSymbol() : Bool
	{
		return true;
	}
	public fun IsInteger() : Bool
	{
		return false;
	}
	public fun IsList() : Bool
	{
		return false;
	}
	public fun Sym() : ISymbol
	{
		return sym;
	}
	public fun Num() : Int
	{
		ERROR("not an integer");
	}
	public fun Equal(IVal other) : Bool
	{
		if (other.IsSymbol())
		{
			return sym == other.Sym();
		}
		return false;
	}
	public fun Show(IText acc) : IText
	{
		return Txt.Append(acc, sym.Chars());
	}
}

class IntVal implements IVal
{
	private readonly Int num;
	public constructor(Int n)
	{
		num = n;
	}
	public fun IsSymbol() : Bool
	{
		return false;
	}
	public fun IsInteger() : Bool
	{
		return true;
	}
	public fun IsList() : Bool
	{
		return false;
	}
	public fun Sym() : ISymbol
	{
		ERROR("not a symbol");
	}
	public fun Num() : Int
	{
		return num;
	}
	public fun Equal(IVal other) : Bool
	{
		if (other.IsInteger())
		{
			return num == other.Num();
		}
		return false;
	}
	public fun Show(IText acc) : IText
	{
		return Txt.AppendInt(acc, num);
	}
}

class ValNil implements IValList
{
	public constructor()
	{
	}
	public fun IsEmpty() : Bool
	{
		return true;
	}
	public fun First() : IVal
	{
		ERROR("car: empty list");
	}
	public fun Rest() : IValList
	{
		ERROR("cdr: empty list");
	}
}

class ValCons implements IValList
{
	private readonly IVal first;
	private readonly IValList rest;
	public constructor(IVal f, IValList r)
	{
		first = f;
		rest = r;
	}
	public fun IsEmpty() : Bool
	{
		return false;
	}
	public fun First() : IVal
	{
		return first;
	}
	public fun Rest() : IValList
	{
		return rest;
	}
}

