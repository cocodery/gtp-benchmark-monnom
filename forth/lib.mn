# Stand-ins for the Racket builtins used by forth: strings as character codes, symbol
# interning, reader values, cons lists, multiple-value results.

class Txt
{
	# (read-case-sensitive #f): fold ASCII upper case to lower case
	public static fun Downcase(Int c) : Int
	{
		if (c >= 65 && c <= 90)
		{
			return c + 32;
		}
		return c;
	}
	public static fun IsSpace(Int c) : Bool
	{
		return c == 32 || c == 9 || c == 10 || c == 13;
	}
	public static fun IsDigit(Int c) : Bool
	{
		return c >= 48 && c <= 57;
	}
	public static fun Empty() : IText
	{
		return new Text(new ArrayList<Int>());
	}
	# up to 9 characters packed as base-128 character codes, first character in the lowest digit
	public static fun Unpack(Int packed) : IText
	{
		return Txt.PushWord(Txt.Empty(), packed);
	}
	public static fun PushWord(IText t, Int packed) : IText
	{
		while (packed > 0)
		{
			t.Push(packed % 128);
			packed = packed / 128;
		}
		return t;
	}
	public static fun Hash(IText t) : Int
	{
		Int h = 7;
		Int i = 0;
		Int n = t.Length();
		while (i < n)
		{
			h = (h * 31 + t.CharAt(i)) % 1000003;
			i = i + 1;
		}
		return h;
	}
	public static fun Equal(IText a, IText b) : Bool
	{
		Int n = a.Length();
		if (n != b.Length())
		{
			return false;
		}
		Int i = 0;
		while (i < n)
		{
			if (a.CharAt(i) != b.CharAt(i))
			{
				return false;
			}
			i = i + 1;
		}
		return true;
	}
