# motion.rkt: world transitions; class Rng is racket's pseudo-random generator
# Racket CS pseudo-random generator (MRG32k3a, Chez Scheme c/random.c),
# re-implemented with exact 64-bit integer arithmetic.
class Rng implements IRng
{
	private Int x10;
	private Int x11;
	private Int x12;
	private Int x20;
	private Int x21;
	private Int x22;
	private Int sx;
	public constructor()
	{
		x10 = 1;
		x11 = 1;
		x12 = 1;
		x20 = 1;
		x21 = 1;
		x22 = 1;
		sx = 0;
	}
	# (random-seed k) / pseudo-random-generator-seed!
	public fun Seed(Int k) : Void
	{
		x10 = 1062452522;
		x11 = 2961816100;
		x12 = 342112271;
		x20 = 2854655037;
		x21 = 3321940838;
		x22 = 3542344109;
		this.SrandHalf(k % 65536);
		this.SrandHalf((k / 65536) % 65536);
	}
	public fun RandomM() : Int
	{
		Int x = sx;
		Int y = x % 65536;
		sx = (30903 * y + x / 65536) % 4294967296;
		return y;
	}
	public fun RandomN(Int n) : Int
	{
		Int hi = this.RandomM();
		Int lo = this.RandomM();
		return (hi * 65536 + lo) % n;
	}
	public fun SrandHalf(Int x) : Void
	{
		sx = x;
		Int z = this.RandomN(4294967086);
		x10 = 1 + ((x10 + z) % 4294967296) % 4294967086;
		z = this.RandomN(4294967087);
		x11 = ((x11 + z) % 4294967296) % 4294967087;
		z = this.RandomN(4294967087);
		x12 = ((x12 + z) % 4294967296) % 4294967087;
		z = this.RandomN(4294944442);
		x20 = 1 + ((x20 + z) % 4294967296) % 4294944442;
		z = this.RandomN(4294944443);
		x21 = ((x21 + z) % 4294967296) % 4294944443;
		z = this.RandomN(4294944443);
		x22 = ((x22 + z) % 4294967296) % 4294944443;
	}
	public fun Fix(Int v, Int m) : Int
	{
		if (v < 0)
		{
			return v + m;
		}
		return v;
	}
	# one step of MRG32k3a, result in {0..m1-1}
	public fun Next() : Int
	{
		Int p1 = 1403580 * x11 - 810728 * x12;
		p1 = this.Fix(p1 - (p1 / 4294967087) * 4294967087, 4294967087);
		x12 = x11;
		x11 = x10;
		x10 = p1;
		Int p2 = 527612 * x20 - 1370589 * x22;
		p2 = this.Fix(p2 - (p2 / 4294944443) * 4294944443, 4294944443);
		x22 = x21;
		x21 = x20;
		x20 = p2;
		return this.Fix(p1 - p2, 4294967087);
	}
	# (random n r) for 1 <= n <= 4294967087
	public fun NextInt(Int n) : Int
	{
		Int q = 4294967087 / n;
		Int qn = q * n;
		Int x = this.Next();
		while (x >= qn)
		{
			x = this.Next();
		}
		return x / q;
	}
}

# motion.rkt
class Motion
{
	# (define r (make-pseudo-random-generator))
	# (define (reset!) (parameterize ((current-pseudo-random-generator r)) (random-seed 1324)))
	# There are no mutable globals in MonNom, so reset! returns the freshly seeded
	# generator and the caller passes it to world->world.
	public static fun Reset() : IRng
	{
		IRng r = new Rng();
		r.Seed(1324);
		return r;
	}

	public static fun WorldToWorld(IWorld w, IRng r) : IWorld
	{
		if (Motion.Eating(w))
		{
			return Motion.SnakeEat(w, r);
		}
		return new World(MotionHelp.SnakeSlither(w.GetSnake()), w.Food());
	}

	# Is the snake eating the food in the world.
	public static fun Eating(IWorld w) : Bool
	{
		return Data.PosnEq(w.Food(), w.GetSnake().Segs().First());
	}

	# Change the direction of the snake.
	public static fun SnakeChangeDirection(ISnake snk, Int dir) : ISnake
	{
		return new Snake(dir, snk.Segs());
	}

	# Change direction of the world.
	public static fun WorldChangeDir(IWorld w, Int dir) : IWorld
	{
		return new World(Motion.SnakeChangeDirection(w.GetSnake(), dir), w.Food());
	}

	# Eat the food and generate a new one.
	public static fun SnakeEat(IWorld w, IRng r) : IWorld
	{
		Int i = r.NextInt(Const.BoardWidth() - 1) + 1;
		Int j = r.NextInt(Const.BoardHeight() - 1) + 1;
		return new World(MotionHelp.SnakeGrow(w.GetSnake()), new Posn(i, j));
	}
}
