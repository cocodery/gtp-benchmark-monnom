	# value of each code
	public static fun Map(Int c) : Int
	{
		if (c == 2)
		{
			return 119;
		}
		if (c == 3)
		{
			return 97;
		}
		if (c == 4)
		{
			return 115;
		}
		if (c == 5)
		{
			return 100;
		}
		return c;
	}
	# unpack the words, one value per element
	public static fun Load() : ArrayList<Int>
	{
		ArrayList<Int> a = new ArrayList<Int>();
		a = SnakeHist.Words0(a);
		a = SnakeHist.Words1(a);
		a = SnakeHist.Words2(a);
		a = SnakeHist.Words3(a);
		a = SnakeHist.Words4(a);
		a = SnakeHist.Words5(a);
		a = SnakeHist.Words6(a);
		ArrayList<Int> res = new ArrayList<Int>();
		Int total = 52457;
		Int i = 0;
		while (i < total)
		{
			Int w = a.Get(i / 21);
			Int j = i % 21;
			while (j > 0)
			{
				w = w / 8;
				j = j - 1;
			}
			res.Add(SnakeHist.Map(w % 8));
			i = i + 1;
		}
		return res;
	}
}
