		if (Txt.Equal(fieldName, Txt.PushWord(Txt.Empty(), 255408098)))
		{
			IDatum v = z.Field(2);
			if (Zo.IsExprOrSeq(v))
			{
				return v;
			}
			return Datums.False();
		}
		return Datums.False();
	}
