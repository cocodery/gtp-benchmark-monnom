			return ZoTransition.LocalBindingTo(z, str);
		}
		if (k == 53)
		{
			return ZoTransition.FreeIdBindingTo(z, str);
		}
		if (k == 57)
		{
			return ZoTransition.AllFromModuleTo(z, str);
		}
		if (k == 17)
		{
			return ZoTransition.ProvidedTo(z, str);
		}
		return Datums.False();
	}
	# (compilation-top-> z field-name)
	public static fun CompilationTopTo(IZo z, IText fieldName) : IDatum
	{
		if (Txt.Equal(fieldName, Txt.PushWord(Txt.Empty(), 4151569906032)))
		{
			IDatum v = z.Field(2);
			return v;
		}
		if (Txt.Equal(fieldName, Txt.PushWord(Txt.Empty(), 213465059)))
		{
			IDatum v = z.Field(3);
			if (Zo.IsForm(v))
			{
				return v;
			}
			return Datums.False();
		}
		return Datums.False();
	}
	# (prefix-> z field-name)
	public static fun PrefixTo(IZo z, IText fieldName) : IDatum
	{
		if (Txt.Equal(fieldName, Txt.PushWord(Txt.Empty(), 8347870193818286068)))
		{
			IDatum v = z.Field(1);
			return Datums.FilterGbmv(v);
		}
		if (Txt.Equal(fieldName, Txt.PushWord(Txt.Empty(), 243153523)))
		{
			IDatum v = z.Field(2);
			return Datums.FilterTrue(v);
		}
		return Datums.False();
	}
