# zo-transition.rkt: the children of a zo struct by field name (generated by
# tools/zordoz_gen.py; the table of transitions is transcribed from the Racket source).
# try-transition returns a datum: a zo, a list, or #f.

class ZoTransition
{
	public static fun ZoTransition(IZo z, IText fieldName) : ITransResult
	{
		IDatum nxt = ZoTransition.TryTransition(z, fieldName);
		if (nxt.Kind() == 0)
		{
			return Trans.One(nxt.Zo());
		}
		if (Datums.IsList(nxt))
		{
			IZoList zs = Datums.FilterZo(nxt);
			if (zs.IsEmpty())
			{
				return Trans.Fail(z);
			}
			return Trans.Many(zs);
		}
		return Trans.Fail(z);
	}
	public static fun TryTransition(IZo z, IText str) : IDatum
	{
		Int k = z.Kind();
		if (k == 16)
		{
			return ZoTransition.CompilationTopTo(z, str);
		}
		if (k == 13)
		{
			return ZoTransition.PrefixTo(z, str);
		}
		if (k == 11)
		{
			return ZoTransition.GlobalBucketTo(z, str);
		}
		if (k == 12)
		{
			return ZoTransition.ModuleVariableTo(z, str);
		}
		if (k == 46)
		{
			return ZoTransition.StxTo(z, str);
		}
		if (k == 22)
		{
			return ZoTransition.DefValuesTo(z, str);
		}
		if (k == 23)
		{
			return ZoTransition.DefSyntaxesTo(z, str);
		}
		if (k == 20)
		{
			return ZoTransition.SeqForSyntaxTo(z, str);
		}
		if (k == 45)
		{
			return ZoTransition.ReqTo(z, str);
		}
		if (k == 19)
		{
			return ZoTransition.SeqTo(z, str);
		}
		if (k == 39)
		{
			return ZoTransition.SpliceTo(z, str);
		}
		if (k == 21)
		{
			return ZoTransition.InlineVariantTo(z, str);
		}
		if (k == 24)
		{
			return ZoTransition.ModTo(z, str);
		}
		if (k == 25)
		{
			return ZoTransition.LamTo(z, str);
		}
		if (k == 26)
		{
			return ZoTransition.ClosureTo(z, str);
		}
		if (k == 27)
		{
			return ZoTransition.CaseLamTo(z, str);
		}
		if (k == 28)
		{
			return ZoTransition.LetOneTo(z, str);
		}
		if (k == 29)
		{
			return ZoTransition.LetVoidTo(z, str);
		}
		if (k == 30)
		{
			return ZoTransition.InstallValueTo(z, str);
		}
		if (k == 31)
		{
			return ZoTransition.LetRecTo(z, str);
		}
		if (k == 32)
		{
			return ZoTransition.BoxenvTo(z, str);
		}
		if (k == 33)
		{
			return ZoTransition.LocalrefTo(z, str);
		}
		if (k == 18)
		{
			return ZoTransition.ToplevelTo(z, str);
		}
		if (k == 34)
		{
			return ZoTransition.TopsyntaxTo(z, str);
		}
		if (k == 35)
		{
			return ZoTransition.ApplicationTo(z, str);
		}
		if (k == 36)
		{
			return ZoTransition.BranchTo(z, str);
		}
		if (k == 37)
		{
			return ZoTransition.WithContMarkTo(z, str);
		}
		if (k == 38)
		{
			return ZoTransition.Beg0To(z, str);
		}
		if (k == 40)
		{
			return ZoTransition.VarrefTo(z, str);
		}
		if (k == 41)
		{
			return ZoTransition.AssignTo(z, str);
		}
		if (k == 42)
		{
			return ZoTransition.ApplyValuesTo(z, str);
		}
		if (k == 43)
		{
			return ZoTransition.WithImmedMarkTo(z, str);
		}
		if (k == 44)
		{
			return ZoTransition.PrimvalTo(z, str);
		}
		if (k == 47)
		{
			return ZoTransition.StxObjTo(z, str);
		}
		if (k == 48)
		{
			return ZoTransition.WrapTo(z, str);
		}
		if (k == 49)
		{
			return ZoTransition.ModuleShiftTo(z, str);
		}
		if (k == 50)
		{
			return ZoTransition.ScopeTo(z, str);
		}
		if (k == 51)
		{
			return ZoTransition.MultiScopeTo(z, str);
		}
		if (k == 55)
		{
			return ZoTransition.ModuleBindingTo(z, str);
		}
		if (k == 56)
		{
			return ZoTransition.DecodedModuleBindingTo(z, str);
