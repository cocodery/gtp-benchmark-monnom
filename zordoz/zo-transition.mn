	# mod-> get-provided
	public static fun GetProvided(IDatum pds) : IDatum
	{
		if (Datums.CheckList(pds).Kind() == 1)
		{
			return Datums.Null();
		}
		IDatum p = pds.Car();
		return Datums.Append(p.Cdr().Car(), Datums.Append(p.Cdr().Cdr().Car(), ZoTransition.GetProvided(pds.Cdr())));
	}

	# mod-> get-syntaxes
	public static fun GetSyntaxes(IDatum sxs) : IDatum
	{
		if (Datums.CheckList(sxs).Kind() == 1)
		{
			return Datums.Null();
		}
		return Datums.Append(sxs.Car().Cdr(), ZoTransition.GetSyntaxes(sxs.Cdr()));
	}

	public static fun InternalContext(IDatum ic) : IDatum
	{
		if (Zo.IsStx(ic))
		{
			return ic;
		}
		if (ic.Kind() == 3)
		{
			return Datums.VectorToList(ic);
		}
		return Datums.False();
	}

	# (for/list ([ms multi-scopes]) (car ms))
	public static fun MapCar(IDatum l) : IDatum
	{
		if (Datums.CheckList(l).Kind() == 1)
		{
			return Datums.Null();
		}
		return Datums.Cons(l.Car().Car(), ZoTransition.MapCar(l.Cdr()));
	}

	# (for/list ([mss scopes]) (cadr mss))
	public static fun MapCadr(IDatum l) : IDatum
	{
		if (Datums.CheckList(l).Kind() == 1)
		{
			return Datums.Null();
		}
		return Datums.Cons(l.Car().Cdr().Car(), ZoTransition.MapCadr(l.Cdr()));
	}

	# scope-> get-bindings
	public static fun GetBindings(IDatum bs) : IDatum
	{
		if (Datums.CheckList(bs).Kind() == 1)
		{
			return Datums.Null();
		}
		IDatum b = bs.Car();
		return Datums.Append(b.Cdr().Car(), Datums.Append(b.Cdr().Cdr(), ZoTransition.GetBindings(bs.Cdr())));
	}

	# scope-> get-bulk-bindings
	public static fun GetBulkBindings(IDatum bbs) : IDatum
	{
		if (Datums.CheckList(bbs).Kind() == 1)
		{
			return Datums.Null();
		}
		IDatum b = bbs.Car();
		return Datums.Append(b.Car(), Datums.Append(b.Cdr(), ZoTransition.GetBulkBindings(bbs.Cdr())));
	}
