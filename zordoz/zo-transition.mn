	# (wrap-> z field-name)
	public static fun WrapTo(IZo z, IText fieldName) : IDatum
	{
		if (Txt.Equal(fieldName, Txt.PushWord(Txt.Empty(), 3982724068467)))
		{
			IDatum v = z.Field(0);
			return v;
		}
		if (Txt.Equal(fieldName, Txt.PushWord(Txt.PushWord(Txt.Empty(), 7198642466052601075), 242841711)))
		{
			IDatum v = z.Field(1);
			return v;
		}
		if (Txt.Equal(fieldName, Txt.PushWord(Txt.PushWord(Txt.Empty(), 8054632333566491373), 1897200)))
		{
			IDatum v = z.Field(2);
			return ZoTransition.MapCar(v);
		}
		return Datums.False();
	}
